@using JwtMusic.WebUI.Dtos.SongDtos
@model List<ResultSongDto>
@{
    Layout = null;
    int currentPage = ViewBag.CurrentPage;
    int totalPages  = ViewBag.TotalPages;
    int pageSize    = ViewBag.PageSize;
    int totalCount  = ViewBag.TotalCount;
    int rangeStart  = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    int rangeEnd    = Math.Min(currentPage * pageSize, totalCount);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Şarkı Yönetimi — Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --bg-root:#0c0c0e; --bg-sidebar:#111113; --bg-card:#16161a;
            --bg-input:#1a1a1c; --bg-row-hover:#18181c;
            --accent:#c9a84c; --accent-dim:rgba(201,168,76,.12); --accent-border:rgba(201,168,76,.28);
            --text-1:#e8e8ea; --text-2:#8a8a94; --text-3:#46464e;
            --border:rgba(255,255,255,.07); --danger:#e0584f;
            --success:#3fb27f; --radius:10px; --sidebar-w:220px;
        }
        *{box-sizing:border-box;margin:0;padding:0;}
        body{font-family:'Inter',sans-serif;background:var(--bg-root);color:var(--text-1);
             display:grid;grid-template-columns:var(--sidebar-w) 1fr;min-height:100vh;}
        a{text-decoration:none;color:inherit;} button{font-family:inherit;cursor:pointer;}

        /* SIDEBAR */
        .sidebar{background:var(--bg-sidebar);border-right:1px solid var(--border);padding:20px 12px;display:flex;flex-direction:column;}
        .sidebar-logo{display:flex;align-items:center;gap:9px;padding:6px 8px 22px;}
        .logo-mark{width:26px;height:26px;background:var(--accent);border-radius:6px;display:flex;align-items:center;justify-content:center;}
        .logo-mark i{color:#0c0c0e;font-size:.8rem;}
        .logo-wordmark{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:.85rem;}
        .sidebar-tag{font-size:.6rem;font-weight:700;letter-spacing:.08em;color:var(--accent);text-transform:uppercase;margin:0 8px 14px;}
        .nav-item{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:7px;color:var(--text-2);font-size:.82rem;font-weight:500;margin-bottom:2px;}
        .nav-item i{width:16px;font-size:.92rem;text-align:center;}
        .nav-item:hover{background:rgba(255,255,255,.04);color:var(--text-1);}
        .nav-item.active{background:var(--accent-dim);color:var(--accent);}
        .sidebar-divider{height:1px;background:var(--border);margin:10px 8px;}
        .sidebar-back{margin-top:auto;padding-top:12px;border-top:1px solid var(--border);}

        /* MAIN */
        main{padding:28px 32px 60px;}

        /* ALERTS */
        .alert{padding:10px 14px;border-radius:8px;font-size:.82rem;margin-bottom:16px;display:flex;align-items:center;gap:8px;}
        .alert-success{background:rgba(63,178,127,.1);border:1px solid rgba(63,178,127,.3);color:var(--success);}
        .alert-error{background:rgba(224,88,79,.1);border:1px solid rgba(224,88,79,.3);color:var(--danger);}

        /* PAGE HEAD */
        .page-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;flex-wrap:wrap;gap:12px;}
        .page-head h1{font-family:'Plus Jakarta Sans',sans-serif;font-size:1.4rem;font-weight:800;}
        .page-head p{color:var(--text-2);font-size:.82rem;margin-top:4px;}

        .btn{display:inline-flex;align-items:center;gap:7px;border:none;border-radius:8px;padding:9px 16px;font-size:.82rem;font-weight:600;font-family:'Inter',sans-serif;}
        .btn-accent{background:var(--accent);color:#0c0c0e;} .btn-accent:hover{background:#d4b360;}
        .btn-danger-sm{background:rgba(224,88,79,.1);border:1px solid rgba(224,88,79,.3);color:var(--danger);padding:6px 10px;font-size:.78rem;border-radius:7px;}
        .btn-danger-sm:hover{background:rgba(224,88,79,.18);}
        .btn-edit-sm{background:var(--bg-input);border:1px solid var(--border);color:var(--text-2);padding:6px 10px;font-size:.78rem;border-radius:7px;}
        .btn-edit-sm:hover{color:var(--text-1);}

        /* TABLE */
        .table-wrap{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;}
        table{width:100%;border-collapse:collapse;}
        thead th{text-align:left;font-size:.72rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--text-3);padding:12px 16px;border-bottom:1px solid var(--border);}
        tbody td{padding:11px 16px;font-size:.85rem;border-bottom:1px solid var(--border);color:var(--text-1);vertical-align:middle;}
        tbody tr:last-child td{border-bottom:none;}
        tbody tr:hover{background:var(--bg-row-hover);}

        .song-cell{display:flex;align-items:center;gap:10px;}
        .song-thumb{width:38px;height:38px;border-radius:6px;object-fit:cover;background:var(--bg-input);flex-shrink:0;}
        .song-thumb-fallback{width:38px;height:38px;border-radius:6px;background:var(--bg-input);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--text-3);}
        .song-title{font-weight:500;font-size:.85rem;}
        .song-artist{font-size:.75rem;color:var(--text-2);}

        .id-col{color:var(--text-3);font-size:.78rem;width:56px;}
        .actions-col{display:flex;gap:6px;justify-content:flex-end;}
        .empty-row td{text-align:center;padding:40px;color:var(--text-3);}

        .role-chip{display:inline-block;font-size:.7rem;padding:2px 10px;border-radius:20px;font-weight:600;
                   background:var(--accent-dim);border:1px solid var(--accent-border);color:var(--accent);}

        /* PAGINATION */
        .pagination-bar{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-top:1px solid var(--border);flex-wrap:wrap;gap:10px;}
        .pagination-info{font-size:.78rem;color:var(--text-3);}
        .pagination-pages{display:flex;align-items:center;gap:4px;}
        .page-link{min-width:30px;height:30px;display:flex;align-items:center;justify-content:center;border-radius:7px;font-size:.8rem;color:var(--text-2);border:1px solid transparent;padding:0 8px;}
        .page-link:hover{background:var(--bg-input);color:var(--text-1);}
        .page-link.active{background:var(--accent-dim);border-color:var(--accent-border);color:var(--accent);font-weight:700;}
        .page-link.disabled{opacity:.35;pointer-events:none;}
        .page-dots{color:var(--text-3);font-size:.8rem;padding:0 4px;}
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-mark"><i class="bi bi-soundwave"></i></div>
            <span class="logo-wordmark">Canlı Müzik</span>
        </div>
        <div class="sidebar-tag">Admin Panel</div>
        <a href="/AdminArtist/Index" class="nav-item"><i class="bi bi-people"></i> Sanatçılar</a>
        <a href="/AdminSong/Index" class="nav-item active"><i class="bi bi-music-note-list"></i> Şarkılar</a>
        <a href="/AdminUser/Index" class="nav-item"><i class="bi bi-person-gear"></i> Kullanıcılar</a>
        <div class="sidebar-divider"></div>
        <div class="sidebar-back">
            <a href="/Song/SongList" class="nav-item"><i class="bi bi-box-arrow-left"></i> Siteye Dön</a>
        </div>
    </aside>

    <main>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success"><i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error"><i class="bi bi-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
        }

        <div class="page-head">
            <div>
                <h1>Şarkı Yönetimi</h1>
                <p>@totalCount şarkı kayıtlı — sayfa @currentPage / @(totalPages > 0 ? totalPages : 1)</p>
            </div>
            <a href="/AdminSong/Create" class="btn btn-accent"><i class="bi bi-plus-lg"></i> Yeni Şarkı</a>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th class="id-col">ID</th>
                        <th>Şarkı</th>
                        <th>Süre</th>
                        <th>Paket</th>
                        <th>Çıkış Tarihi</th>
                        <th style="text-align:right;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var song in Model)
                        {
                            <tr>
                                <td class="id-col">#@song.SongId</td>
                                <td>
                                    <div class="song-cell">
                                        @if (!string.IsNullOrEmpty(song.CoverImageUrl))
                                        {
                                            <img src="@song.CoverImageUrl" class="song-thumb" alt="@song.Title"
                                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                                            <div class="song-thumb-fallback" style="display:none;"><i class="bi bi-music-note"></i></div>
                                        }
                                        else
                                        {
                                            <div class="song-thumb-fallback"><i class="bi bi-music-note"></i></div>
                                        }
                                        <div>
                                            <div class="song-title">@song.Title</div>
                                            <div class="song-artist">@song.ArtistName</div>
                                        </div>
                                    </div>
                                </td>
                                <td style="color:var(--text-2);">@song.Duration.ToString(@"mm\:ss")</td>
                                <td><span class="role-chip">@(song.RequiredRoleName ?? "Basic")</span></td>
                                <td style="color:var(--text-2);">@song.ReleaseDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <div class="actions-col">
                                        <a href="/AdminSong/Update/@song.SongId" class="btn-edit-sm">
                                            <i class="bi bi-pencil"></i> Güncelle
                                        </a>
                                        <form method="post" action="/AdminSong/Delete/@song.SongId"
                                              onsubmit="return confirm('\" şarkıyı silmek istediğine emin misin?');">
                                            <button type="submit" class="btn-danger-sm"><i class="bi bi-trash"></i> Sil</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="empty-row"><td colspan="6">Henüz şarkı eklenmemiş.</td></tr>
                    }
                </tbody>
            </table>

            @if (totalPages > 1)
            {
                <div class="pagination-bar">
                    <span class="pagination-info">@rangeStart–@rangeEnd / @totalCount kayıt</span>
                    <div class="pagination-pages">
                        <a class="page-link @(currentPage <= 1 ? "disabled" : "")"
                           href="/AdminSong/Index?page=@(currentPage-1)&pageSize=@pageSize">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                        @{
                            int sp = Math.Max(1, currentPage - 2);
                            int ep = Math.Min(totalPages, currentPage + 2);
                        }
                        @if (sp > 1)
                        {
                            <a class="page-link" href="/AdminSong/Index?page=1&pageSize=@pageSize">1</a>
                            if (sp > 2) { <span class="page-dots">…</span> }
                        }
                        @for (int p = sp; p <= ep; p++)
                        {
                            <a class="page-link @(p == currentPage ? "active" : "")"
                               href="/AdminSong/Index?page=@p&pageSize=@pageSize">@p</a>
                        }
                        @if (ep < totalPages)
                        {
                            if (ep < totalPages - 1) { <span class="page-dots">…</span> }
                            <a class="page-link" href="/AdminSong/Index?page=@totalPages&pageSize=@pageSize">@totalPages</a>
                        }
                        <a class="page-link @(currentPage >= totalPages ? "disabled" : "")"
                           href="/AdminSong/Index?page=@(currentPage+1)&pageSize=@pageSize">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </main>
</body>
</html>
