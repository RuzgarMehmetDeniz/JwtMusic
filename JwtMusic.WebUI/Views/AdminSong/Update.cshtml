@using JwtMusic.WebUI.Dtos.SongDtos
@model UpdateSongDto
@{
    Layout = null;
    var artists = ViewBag.Artists as List<dynamic> ?? new List<dynamic>();
    var roles = ViewBag.Roles as List<dynamic> ?? new List<dynamic>();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Şarkı Güncelle — Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --bg-root: #0c0c0e;
            --bg-sidebar: #111113;
            --bg-card: #16161a;
            --bg-input: #1a1a1c;
            --accent: #c9a84c;
            --accent-dim: rgba(201,168,76,.12);
            --accent-border: rgba(201,168,76,.28);
            --text-1: #e8e8ea;
            --text-2: #8a8a94;
            --text-3: #46464e;
            --border: rgba(255,255,255,.07);
            --danger: #e0584f;
            --success: #3fb27f;
            --radius: 10px;
            --sidebar-w: 220px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter',sans-serif;
            background: var(--bg-root);
            color: var(--text-1);
            display: grid;
            grid-template-columns: var(--sidebar-w) 1fr;
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
            cursor: pointer;
        }

        /* SIDEBAR */
        .sidebar {
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            padding: 20px 12px;
            display: flex;
            flex-direction: column;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 6px 8px 22px;
        }

        .logo-mark {
            width: 26px;
            height: 26px;
            background: var(--accent);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .logo-mark i {
                color: #0c0c0e;
                font-size: .8rem;
            }

        .logo-wordmark {
            font-family: 'Plus Jakarta Sans',sans-serif;
            font-weight: 800;
            font-size: .85rem;
        }

        .sidebar-tag {
            font-size: .6rem;
            font-weight: 700;
            letter-spacing: .08em;
            color: var(--accent);
            text-transform: uppercase;
            margin: 0 8px 14px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 10px;
            border-radius: 7px;
            color: var(--text-2);
            font-size: .82rem;
            font-weight: 500;
            margin-bottom: 2px;
        }

            .nav-item i {
                width: 16px;
                font-size: .92rem;
                text-align: center;
            }

            .nav-item:hover {
                background: rgba(255,255,255,.04);
                color: var(--text-1);
            }

            .nav-item.active {
                background: var(--accent-dim);
                color: var(--accent);
            }

        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 10px 8px;
        }

        .sidebar-back {
            margin-top: auto;
            padding-top: 12px;
            border-top: 1px solid var(--border);
        }

        /* MAIN */
        main {
            padding: 28px 32px 60px;
            display: flex;
            justify-content: center;
        }

        .form-wrap {
            width: 100%;
            max-width: 560px;
        }

        .breadcrumb {
            font-size: .78rem;
            color: var(--text-3);
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .breadcrumb a {
                color: var(--text-2);
            }

                .breadcrumb a:hover {
                    color: var(--accent);
                }

        .page-head {
            margin-bottom: 22px;
        }

            .page-head h1 {
                font-family: 'Plus Jakarta Sans',sans-serif;
                font-size: 1.4rem;
                font-weight: 800;
            }

            .page-head p {
                color: var(--text-2);
                font-size: .82rem;
                margin-top: 4px;
            }

        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px;
        }

        /* PREVIEW */
        .preview-wrap {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 20px;
            padding: 14px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 8px;
        }

        .preview-img {
            width: 52px;
            height: 52px;
            border-radius: 8px;
            object-fit: cover;
            background: var(--bg-root);
            border: 1px solid var(--border);
            flex-shrink: 0;
        }

        .preview-fallback {
            width: 52px;
            height: 52px;
            border-radius: 8px;
            background: var(--bg-root);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-3);
            flex-shrink: 0;
        }

        .preview-meta {
            min-width: 0;
        }

        .preview-title {
            font-size: .84rem;
            font-weight: 600;
            color: var(--text-1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .preview-id {
            font-size: .7rem;
            color: var(--text-3);
            margin-top: 2px;
        }

        /* FIELDS */
        .field {
            margin-bottom: 16px;
        }

            .field label {
                display: block;
                font-size: .78rem;
                font-weight: 600;
                color: var(--text-2);
                margin-bottom: 7px;
            }

            .field input, .field select {
                width: 100%;
                background: var(--bg-input);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 10px 13px;
                color: var(--text-1);
                font-size: .86rem;
                font-family: 'Inter',sans-serif;
                outline: none;
                transition: border-color .2s;
            }

                .field input:focus, .field select:focus {
                    border-color: var(--accent-border);
                }

                .field select option {
                    background: #1a1a1c;
                }

        .field-hint {
            font-size: .72rem;
            color: var(--text-3);
            margin-top: 5px;
        }

        .form-row {
            display: flex;
            gap: 14px;
        }

            .form-row .field {
                flex: 1;
            }

        /* ALERTS */
        .alert {
            padding: 10px 14px;
            border-radius: 8px;
            font-size: .82rem;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .alert-error {
            background: rgba(224,88,79,.1);
            border: 1px solid rgba(224,88,79,.3);
            color: var(--danger);
        }

        /* BUTTONS */
        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 22px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            font-size: .84rem;
            font-weight: 600;
            font-family: 'Inter',sans-serif;
        }

        .btn-accent {
            background: var(--accent);
            color: #0c0c0e;
        }

            .btn-accent:hover {
                background: #d4b360;
            }

        .btn-outline {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-2);
        }

            .btn-outline:hover {
                color: var(--text-1);
            }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-mark"><i class="bi bi-soundwave"></i></div>
            <span class="logo-wordmark">Canlı Müzik</span>
        </div>
        <div class="sidebar-tag">Admin Panel</div>
        <a href="/AdminArtist/Index" class="nav-item"><i class="bi bi-people"></i> Sanatçılar</a>
        <a href="/AdminSong/Index" class="nav-item active"><i class="bi bi-music-note-list"></i> Şarkılar</a>
        <a href="/AdminUser/Index" class="nav-item"><i class="bi bi-person-gear"></i> Kullanıcılar</a>
        <div class="sidebar-divider"></div>
        <div class="sidebar-back">
            <a href="/Song/SongList" class="nav-item"><i class="bi bi-box-arrow-left"></i> Siteye Dön</a>
        </div>
    </aside>

    <main>
        <div class="form-wrap">
            <div class="page-head">
                <div class="breadcrumb">
                    <a href="/AdminSong/Index">Şarkılar</a>
                    <i class="bi bi-chevron-right" style="font-size:.65rem;"></i>
                    <span>Güncelle</span>
                </div>
                <h1>Şarkıyı Güncelle</h1>
                <p>Bilgileri düzenleyip Güncelle butonuna bas.</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-error">
                    <i class="bi bi-exclamation-circle"></i> @TempData["ErrorMessage"]
                </div>
            }

            <div class="card">

                <!-- Kapak önizleme -->
                <div class="preview-wrap">
                    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                    {
                        <img id="previewImg" class="preview-img" src="@Model.CoverImageUrl" alt="kapak"
                             onerror="this.style.display='none';document.getElementById('previewFallback').style.display='flex';" />
                        <div id="previewFallback" class="preview-fallback" style="display:none;">
                            <i class="bi bi-image"></i>
                        </div>
                    }
                    else
                    {
                        <img id="previewImg" class="preview-img" src="" alt="" style="display:none;" />
                        <div id="previewFallback" class="preview-fallback">
                            <i class="bi bi-image"></i>
                        </div>
                    }
                    <div class="preview-meta">
                        <div class="preview-title">@Model.Title</div>
                        <div class="preview-id">#@Model.SongId</div>
                    </div>
                </div>

                <form method="post" action="/AdminSong/Update/@Model.SongId">
                    <input type="hidden" name="SongId" value="@Model.SongId" />

                    <div class="field">
                        <label>Şarkı Adı</label>
                        <input type="text" name="Title" value="@Model.Title" required />
                    </div>

                    <div class="field">
                        <label>Sanatçı</label>
                        <select name="ArtistId" required>
                            <option value="">— Sanatçı Seç —</option>
                            @foreach (var artist in artists)
                            {
                                if ((int)artist.artistId == Model.ArtistId)
                                {
                                    <option value="@artist.artistId" selected>@artist.name</option>
                                }
                                else
                                {
                                    <option value="@artist.artistId">@artist.name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label>Gerekli Paket</label>
                        <select name="RequiredRoleId" required>
                            <option value="">— Paket Seç —</option>
                            @foreach (var role in roles)
                            {
                                if ((string)role.id == Model.RequiredRoleId)
                                {
                                    <option value="@role.id" selected>@role.name</option>
                                }
                                else
                                {
                                    <option value="@role.id">@role.name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="field">
                            <label>Süre (hh:mm:ss)</label>
                            <input type="text" name="Duration" value="@Model.Duration"
                                   placeholder="00:03:24" required />
                            <div class="field-hint">Örnek: 00:03:24</div>
                        </div>
                        <div class="field">
                            <label>Çıkış Tarihi</label>
                            <input type="date" name="ReleaseDate"
                                   value="@Model.ReleaseDate.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <div class="field">
                        <label>Kapak Resmi URL</label>
                        <input type="text" name="CoverImageUrl" value="@Model.CoverImageUrl"
                               placeholder="https://..." oninput="updatePreview(this.value)" />
                    </div>

                    <div class="field">
                        <label>Ses Dosyası (YouTube URL veya ID)</label>
                        <input type="text" name="AudioUrl" value="@Model.AudioUrl"
                               placeholder="https://youtube.com/watch?v=... veya video ID" />
                        <div class="field-hint">YouTube video linki veya 11 haneli video ID girin.</div>
                    </div>

                    <div class="form-actions">
                        <a href="/AdminSong/Index" class="btn btn-outline">Vazgeç</a>
                        <button type="submit" class="btn btn-accent">
                            <i class="bi bi-check-lg"></i> Güncelle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script>
        function updatePreview(url) {
            const img = document.getElementById('previewImg');
            const fallback = document.getElementById('previewFallback');
            if (!url) {
                img.style.display = 'none';
                fallback.style.display = 'flex';
                return;
            }
            img.onload = () => { img.style.display = 'block'; fallback.style.display = 'none'; };
            img.onerror = () => { img.style.display = 'none'; fallback.style.display = 'flex'; };
            img.src = url;
        }
    </script>
</body>
</html>
