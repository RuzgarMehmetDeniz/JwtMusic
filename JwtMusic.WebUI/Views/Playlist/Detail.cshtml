@model JwtMusic.WebUI.Dtos.PlaylistDtos.PlaylistDetailDto
@{
    Layout = null;
    var token    = ViewBag.Token    as string ?? "";
    var userRole = ViewBag.UserRole as string ?? "Basic";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model?.Name — Canlı Müzik</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --bg-root:#0c0c0e;--bg-sidebar:#111113;--bg-main:#0c0c0e;
            --bg-card:#181819;--bg-surface:#1c1c1f;--bg-input:#1a1a1c;
            --accent:#c9a84c;--accent-dim:rgba(201,168,76,0.12);--accent-border:rgba(201,168,76,0.28);
            --accent-glow:0 0 24px rgba(201,168,76,0.18);
            --text-1:#e8e8ea;--text-2:#8a8a94;--text-3:#46464e;
            --border:rgba(255,255,255,0.055);--border-hover:rgba(255,255,255,0.11);
            --sidebar-w:224px;--player-h:76px;--radius-card:14px;--radius-sm:8px;--radius-pill:100px;
            --transition:0.22s cubic-bezier(0.4,0,0.2,1);
        }
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        html{height:100%}
        body{font-family:'Inter',sans-serif;background:var(--bg-root);color:var(--text-1);height:100%;overflow:hidden;display:grid;grid-template-columns:var(--sidebar-w) 1fr;grid-template-rows:1fr var(--player-h);grid-template-areas:"sidebar main" "player player"}
        img{display:block}a{text-decoration:none;color:inherit}button{font-family:inherit;cursor:pointer}

        /* SIDEBAR */
        .sidebar{grid-area:sidebar;background:var(--bg-sidebar);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;user-select:none}
        .sidebar-logo{display:flex;align-items:center;gap:10px;padding:22px 20px 20px;border-bottom:1px solid var(--border)}
        .logo-mark{width:30px;height:30px;background:var(--accent);border-radius:7px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
        .logo-mark i{color:#0c0c0e;font-size:.95rem}
        .logo-wordmark{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:.95rem;letter-spacing:-.3px;color:var(--text-1)}
        .sidebar-section{padding:20px 12px 8px}
        .sidebar-label{font-size:.65rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--text-3);padding:0 8px;margin-bottom:6px}
        .nav-item{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:var(--radius-sm);color:var(--text-2);font-size:.855rem;font-weight:500;cursor:pointer;transition:background var(--transition),color var(--transition);position:relative;text-decoration:none}
        .nav-item i{font-size:1rem;width:18px;flex-shrink:0;text-align:center}
        .nav-item:hover{background:rgba(255,255,255,.04);color:var(--text-1)}
        .nav-item.active{color:var(--text-1);background:rgba(255,255,255,.05)}
        .nav-item.active::before{content:'';position:absolute;left:0;top:20%;bottom:20%;width:2.5px;border-radius:2px;background:var(--accent)}
        .sidebar-divider{height:1px;background:var(--border);margin:8px 12px}
        .sidebar-footer{margin-top:auto;padding:16px 12px;border-top:1px solid var(--border)}
        .user-row{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:var(--radius-sm)}
        .user-avatar{width:30px;height:30px;border-radius:50%;background:var(--bg-surface);border:1.5px solid var(--border-hover);display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;color:var(--accent);flex-shrink:0}
        .user-info{min-width:0}
        .user-name{font-size:.8rem;font-weight:600;color:var(--text-1)}
        .role-pill{display:inline-flex;align-items:center;gap:4px;font-size:.62rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:2px 8px;border-radius:var(--radius-pill);margin-top:2px}
        .role-pill.basic{background:rgba(255,255,255,.08);color:var(--text-2)}
        .role-pill.gold{background:rgba(201,168,76,.18);color:var(--accent)}
        .role-pill.premium{background:var(--accent);color:#0c0c0e}
        .role-pill.elit{background:linear-gradient(135deg,#a855f7,#7c3aed);color:#fff}

        /* MAIN */
        .main{grid-area:main;overflow-y:auto;display:flex;flex-direction:column;background:var(--bg-main);scrollbar-width:thin;scrollbar-color:var(--bg-surface) transparent}
        .main::-webkit-scrollbar{width:5px}.main::-webkit-scrollbar-track{background:transparent}.main::-webkit-scrollbar-thumb{background:var(--bg-surface);border-radius:4px}

        /* TOPBAR */
        .topbar{position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:14px 28px;background:rgba(12,12,14,.88);backdrop-filter:blur(18px);border-bottom:1px solid var(--border);gap:16px}
        .topbar-left{display:flex;align-items:center;gap:10px}
        .back-btn{width:30px;height:30px;border-radius:50%;background:var(--bg-surface);border:1px solid var(--border);color:var(--text-2);display:flex;align-items:center;justify-content:center;font-size:.8rem;text-decoration:none;transition:background var(--transition),color var(--transition)}
        .back-btn:hover{background:var(--bg-card);color:var(--text-1)}
        .topbar-breadcrumb{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:1rem;color:var(--text-1);letter-spacing:-.3px}

        /* CONTENT */
        .content{padding:28px 28px 40px;flex:1}

        /* Playlist header */
        .pl-header {
            display: flex; align-items: center; gap: 20px;
            margin-bottom: 28px; padding-bottom: 24px;
            border-bottom: 1px solid var(--border);
        }

        .pl-cover {
            width: 100px; height: 100px;
            border-radius: var(--radius-card);
            background: var(--accent-dim);
            border: 1px solid var(--accent-border);
            display: flex; align-items: center; justify-content: center;
            font-size: 2.5rem; flex-shrink: 0;
        }

        .pl-info { min-width: 0; }

        .pl-label {
            font-size: .68rem; font-weight: 700;
            letter-spacing: .08em; text-transform: uppercase;
            color: var(--accent); margin-bottom: 6px;
        }

        .pl-name {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.75rem; font-weight: 800;
            letter-spacing: -.6px; color: var(--text-1); margin-bottom: 6px;
        }

        .pl-meta { font-size: .8rem; color: var(--text-2); }

        /* Action buttons */
        .action-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; }

        .btn-play-all {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 10px 22px; border-radius: var(--radius-pill);
            background: var(--accent); border: none; color: #0c0c0e;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: .875rem; font-weight: 700;
            cursor: pointer; transition: background var(--transition), transform 0.15s;
        }
        .btn-play-all:hover { background: #d4b360; transform: scale(1.02); }

        /* Track list */
        .track-list { display: flex; flex-direction: column; gap: 2px; }

        .track-row {
            display: grid;
            grid-template-columns: 40px 48px 1fr auto auto;
            align-items: center; gap: 12px;
            padding: 8px 12px; border-radius: var(--radius-sm);
            cursor: pointer; transition: background var(--transition);
            position: relative;
        }

        .track-row:hover { background: var(--bg-surface); }
        .track-row.playing { background: var(--accent-dim); }

        .track-num {
            font-size: .82rem; color: var(--text-3);
            text-align: center; font-variant-numeric: tabular-nums;
        }
        .track-row:not(.playing):hover .track-num-val { display: none; }
        .track-play-icon { display: none; color: var(--text-2); font-size: .85rem; }
        .track-row:not(.playing):hover .track-play-icon { display: block; }
        .track-row.playing .track-num-val { display: none; }
        .track-row.playing .track-bars { display: flex !important; }
        .track-bars {
            display: none; align-items: flex-end;
            gap: 2px; height: 13px; justify-content: center;
        }
        .track-bars span {
            display: block; width: 2.5px; border-radius: 2px;
            background: var(--accent); animation: tb .9s ease-in-out infinite;
        }
        .track-bars span:nth-child(1){height:6px;animation-delay:0s}
        .track-bars span:nth-child(2){height:11px;animation-delay:.15s}
        .track-bars span:nth-child(3){height:8px;animation-delay:.05s}
        @@keyframes tb{0%,100%{transform:scaleY(1)}50%{transform:scaleY(.35)}}

        .track-cover {
            width: 40px; height: 40px; border-radius: 6px;
            object-fit: cover; flex-shrink: 0;
            background: var(--bg-surface); border: 1px solid var(--border);
        }

        .track-cover-fallback {
            width: 40px; height: 40px; border-radius: 6px;
            background: var(--bg-surface); border: 1px solid var(--border);
            display: flex; align-items: center; justify-content: center; font-size: 1rem;
        }

        .track-info { min-width: 0; }
        .track-title {
            font-size: .875rem; font-weight: 500; color: var(--text-1);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .track-row.playing .track-title { color: var(--accent); }
        .track-artist { font-size: .7rem; color: var(--text-3); margin-top: 1px; }

        .track-duration { font-size: .75rem; color: var(--text-3); font-variant-numeric: tabular-nums; }

        .track-remove-btn {
            background: none; border: none; color: var(--text-3);
            font-size: .85rem; cursor: pointer; padding: 4px;
            opacity: 0; transition: opacity var(--transition), color var(--transition);
        }
        .track-row:hover .track-remove-btn { opacity: 1; }
        .track-remove-btn:hover { color: #f87171; }

        /* Section header */
        .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
        .section-title { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1rem; font-weight: 700; color: var(--text-1); }
        .section-count { font-size: .75rem; color: var(--text-3); }

        /* Empty */
        .empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:4rem 2rem;color:var(--text-3);border:1px dashed var(--border);border-radius:var(--radius-card)}
        .empty-state i{font-size:2rem;margin-bottom:12px;display:block}
        .empty-state p{font-size:.83rem;color:var(--text-2)}
        .empty-state a{margin-top:14px;display:inline-flex;align-items:center;gap:6px;padding:9px 18px;border-radius:var(--radius-pill);background:var(--accent);color:#0c0c0e;font-size:.82rem;font-weight:700;transition:background var(--transition)}
        .empty-state a:hover{background:#d4b360}

        /* PLAYER */
        .player{grid-area:player;background:#111113;border-top:1px solid var(--border);display:grid;grid-template-columns:280px 1fr 280px;align-items:center;padding:0 20px;gap:12px;z-index:100}
        .player-track{display:flex;align-items:center;gap:11px;min-width:0}
        .player-cover{width:44px;height:44px;border-radius:var(--radius-sm);background:var(--bg-surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0;overflow:hidden}
        .player-cover img{width:100%;height:100%;object-fit:cover}
        .player-info{min-width:0;flex:1}
        .player-song{font-size:.82rem;font-weight:600;color:var(--text-1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:'Plus Jakarta Sans',sans-serif}
        .player-artist{font-size:.72rem;color:var(--text-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px}
        .player-like-btn{background:none;border:none;color:var(--text-3);font-size:.9rem;cursor:pointer;padding:5px;transition:color var(--transition);flex-shrink:0}
        .player-like-btn:hover,.player-like-btn.liked{color:var(--accent)}
        .waveform{display:flex;align-items:center;gap:2px;height:14px}
        .waveform span{display:block;width:2.5px;border-radius:2px;background:var(--accent);animation:wv 1.1s ease-in-out infinite}
        .waveform span:nth-child(1){height:5px;animation-delay:0s}.waveform span:nth-child(2){height:12px;animation-delay:.1s}.waveform span:nth-child(3){height:8px;animation-delay:.2s}.waveform span:nth-child(4){height:14px;animation-delay:.3s}.waveform span:nth-child(5){height:6px;animation-delay:.4s}
        @@keyframes wv{0%,100%{transform:scaleY(1)}50%{transform:scaleY(.3)}}
        .waveform.paused span{animation-play-state:paused}
        .player-center{display:flex;flex-direction:column;align-items:center;gap:7px}
        .player-controls{display:flex;align-items:center;gap:4px}
        .ctrl-btn{background:none;border:none;color:var(--text-2);font-size:.9rem;cursor:pointer;padding:0;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:color var(--transition),background var(--transition)}
        .ctrl-btn:hover{color:var(--text-1);background:rgba(255,255,255,.05)}
        .ctrl-btn-play{width:38px;height:38px;background:var(--text-1);color:var(--bg-root);font-size:1rem;border-radius:50%;transition:transform .15s,background var(--transition)}
        .ctrl-btn-play:hover{background:#fff;transform:scale(1.05)}
        .player-progress{display:flex;align-items:center;gap:10px;width:100%;max-width:440px}
        .time-lbl{font-size:.65rem;color:var(--text-3);min-width:30px;text-align:center;font-variant-numeric:tabular-nums}
        .progress-track{flex:1;height:3px;background:rgba(255,255,255,.08);border-radius:3px;cursor:pointer}
        .progress-track:hover{height:4px}
        .progress-fill{height:100%;border-radius:3px;background:var(--text-1);width:0%;position:relative;transition:width .1s linear}
        .progress-track:hover .progress-fill{background:var(--accent)}
        .progress-fill::after{content:'';position:absolute;right:-4px;top:50%;transform:translateY(-50%) scale(0);width:9px;height:9px;background:#fff;border-radius:50%;transition:transform .15s}
        .progress-track:hover .progress-fill::after{transform:translateY(-50%) scale(1)}
        .player-right{display:flex;align-items:center;justify-content:flex-end;gap:8px}
        .vol-wrap{display:flex;align-items:center;gap:6px}
        .vol-btn{background:none;border:none;color:var(--text-2);font-size:.9rem;cursor:pointer;padding:4px;transition:color var(--transition)}
        .vol-btn:hover{color:var(--text-1)}
        .vol-track{width:78px;height:3px;background:rgba(255,255,255,.08);border-radius:3px;cursor:pointer}
        .vol-fill{height:100%;border-radius:3px;background:rgba(255,255,255,.3);width:70%;transition:background var(--transition)}
        .vol-track:hover .vol-fill{background:var(--text-1)}

        @@media(max-width:900px){body{grid-template-columns:1fr;grid-template-rows:52px 1fr var(--player-h);grid-template-areas:"sidebar" "main" "player"}.sidebar{flex-direction:row;border-right:none;border-bottom:1px solid var(--border);overflow-x:auto}.sidebar-logo{padding:12px 16px;border-bottom:none;border-right:1px solid var(--border)}.sidebar-section{display:flex;flex-direction:row;padding:8px;gap:2px;align-items:center}.sidebar-label,.sidebar-divider,.sidebar-footer{display:none}.nav-item.active::before{top:auto;left:20%;right:20%;bottom:0;height:2px;width:auto}.player{grid-template-columns:1fr auto}.player-right{display:none}.track-row{grid-template-columns:36px 1fr auto}.track-duration{display:none}}
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-mark"><i class="bi bi-soundwave"></i></div>
            <span class="logo-wordmark">Canlı Müzik</span>
        </div>
        <nav class="sidebar-section">
            <span class="sidebar-label">Keşfet</span>
            <a href="#" class="nav-item"><i class="bi bi-house"></i> Ana Sayfa</a>
            <a href="/Artist/ArtistList" class="nav-item"><i class="bi bi-people"></i> Sanatçılar</a>
            <a href="/Song/SongList" class="nav-item"><i class="bi bi-music-note-list"></i> Şarkılar</a>
            <a href="/Recommendation/Index" class="nav-item"><i class="bi bi-stars"></i> Önerilenler</a>
        </nav>
        <div class="sidebar-divider"></div>
        <nav class="sidebar-section">
            <span class="sidebar-label">Kitaplık</span>
            <a href="/LikedSongs/Index" class="nav-item"><i class="bi bi-heart"></i> Beğendiklerim</a>

            <a href="/Playlist/Index" class="nav-item active"><i class="bi bi-collection-play"></i> Çalma Listeleri</a>
            <a href="/History/Index" class="nav-item"><i class="bi bi-clock-history"></i> Dinleme Geçmişi</a>
        </nav>
    </aside>

<main class="main">
    <header class="topbar">
        <div class="topbar-left">
            <a href="/Playlist/Index" class="back-btn" title="Geri">
                <i class="bi bi-chevron-left"></i>
            </a>
            <span class="topbar-breadcrumb">@Model?.Name</span>
        </div>
    </header>

    <div class="content">
        @if (Model != null)
        {
            <!-- Playlist header -->
            <div class="pl-header">
                <div class="pl-cover">🎵</div>
                <div class="pl-info">
                    <div class="pl-label">Çalma Listesi</div>
                    <div class="pl-name">@Model.Name</div>
                    <div class="pl-meta">
                        @Model.Songs.Count şarkı
                        · Oluşturuldu: @Model.CreatedAt.ToString("dd MMM yyyy")
                    </div>
                </div>
            </div>

            <!-- Action bar -->
            <div class="action-bar">
                <button class="btn-play-all" onclick="playAll()">
                    <i class="bi bi-play-fill"></i> Tümünü Oynat
                </button>
            </div>

            <!-- Track list -->
            <div class="section-header">
                <span class="section-title">Şarkılar</span>
                <span class="section-count">@Model.Songs.Count şarkı</span>
            </div>

            @if (Model.Songs.Any())
            {
                <div class="track-list" id="trackList">
                    @{
                        int RoleLevel(string r) => r.ToLower() switch { "elit" => 4, "premium" => 3, "gold" => 2, _ => 1 };
                        int idx = 0;
                    }
                    @foreach (var s in Model.Songs)
                    {
                        var canPlay = RoleLevel(userRole) >= RoleLevel(s.RequiredRole);

                        <div class="track-row @(canPlay ? "" : "locked-row")"
                             id="tr-@idx"
                             data-idx="@idx"
                             data-song-id="@s.SongId"
                             data-audio="@(s.AudioUrl ?? "")"
                             data-title="@Html.Raw(s.Title.Replace("\"","&quot;"))"
                             data-artist="@Html.Raw(s.ArtistName.Replace("\"","&quot;"))"
                             data-cover="@(s.CoverImageUrl ?? "")"
                             data-can-play="@canPlay.ToString().ToLower()"
                             onclick="playTrack(this)">

                            <div class="track-num">
                                <span class="track-num-val">@(idx + 1)</span>
                                <i class="bi bi-play-fill track-play-icon"></i>
                                <div class="track-bars"><span></span><span></span><span></span></div>
                            </div>

                            @if (!string.IsNullOrEmpty(s.CoverImageUrl))
                            {
                                <img src="@s.CoverImageUrl" alt="@s.Title" class="track-cover"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                                <div class="track-cover-fallback" style="display:none">🎵</div>
                            }
                            else
                            {
                                <div class="track-cover-fallback">🎵</div>
                            }

                            <div class="track-info">
                                <div class="track-title">@s.Title</div>
                                <div class="track-artist">@s.ArtistName</div>
                            </div>

                            <div class="track-duration">@s.Duration</div>

                            <button class="track-remove-btn"
                                    onclick="removeSong(event, @s.PlaylistSongId)"
                                    title="Listeden çıkar">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        idx++;
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-music-note-list"></i>
                    <p>Bu listede henüz şarkı yok.</p>
                    <a href="/Song/SongList"><i class="bi bi-plus"></i> Şarkı Ekle</a>
                </div>
            }
        }
    </div>
</main>

<!-- PLAYER -->
<footer class="player">
    <div class="player-track">
        <div class="player-cover" id="playerCover">🎵</div>
        <div class="player-info">
            <div class="player-song"   id="playerSong">Oynatılmıyor</div>
            <div class="player-artist" id="playerArtist">Bir şarkı seçin</div>
        </div>
        <button class="player-like-btn" onclick="toggleHeart(this)"><i class="bi bi-heart"></i></button>
        <div class="waveform paused" id="waveform">
            <span></span><span></span><span></span><span></span><span></span>
        </div>
    </div>
    <div class="player-center">
        <div class="player-controls">
            <button class="ctrl-btn"><i class="bi bi-shuffle"></i></button>
            <button class="ctrl-btn" onclick="playPrev()"><i class="bi bi-skip-start-fill"></i></button>
            <button class="ctrl-btn ctrl-btn-play" onclick="togglePlay()">
                <i id="playIcon" class="bi bi-play-fill"></i>
            </button>
            <button class="ctrl-btn" onclick="playNext()"><i class="bi bi-skip-end-fill"></i></button>
            <button class="ctrl-btn"><i class="bi bi-repeat"></i></button>
        </div>
        <div class="player-progress">
            <span class="time-lbl" id="currentTime">0:00</span>
            <div class="progress-track" id="progressBar" onclick="seekTo(event)">
                <div class="progress-fill" id="progressFill"></div>
            </div>
            <span class="time-lbl" id="totalTime">0:00</span>
        </div>
    </div>
    <div class="player-right">
        <div class="vol-wrap">
            <button class="vol-btn" onclick="toggleMute()"><i id="volIcon" class="bi bi-volume-up-fill"></i></button>
            <div class="vol-track" id="volTrack" onclick="setVolume(event)">
                <div class="vol-fill" id="volFill" style="width:70%"></div>
            </div>
        </div>
    </div>
</footer>

<div id="ytPlayer" style="position:absolute;width:0;height:0;pointer-events:none;opacity:0"></div>

<script>
    const TOKEN      = "@token";
    const API_BASE   = "https://localhost:7185";
    const PLAYLIST_ID = @(Model?.PlaylistId ?? 0);
    const USER_ROLE  = "@userRole";

    const ROLE_LEVEL = { basic:1, gold:2, premium:3, elit:4 };
    function getRoleLevel(r) { return ROLE_LEVEL[(r||'').toLowerCase()] ?? 1; }

    /* Tüm şarkı verisi */
    const TRACKS = [];
    @if (Model?.Songs != null)
    {
        foreach (var s in Model.Songs)
        {
            <text>
            TRACKS.push({
                playlistSongId: @s.PlaylistSongId,
                songId:    @s.SongId,
                title:     '@Html.Raw(s.Title.Replace("'","\\'"))',
                artist:    '@Html.Raw(s.ArtistName.Replace("'","\\'"))',
                cover:     '@(s.CoverImageUrl ?? "")',
                audio:     '@(s.AudioUrl ?? "")',
                reqRole:   '@s.RequiredRole',
                canPlay:   @(RoleLevel(userRole) >= RoleLevel(s.RequiredRole) ? "true" : "false")
            });
            </text>


                int RoleLevel(string r) => r.ToLower() switch { "elit" => 4, "premium" => 3, "gold" => 2, _ => 1 };
            
        }
    }

    const PLAYABLE = TRACKS.filter(t => t.canPlay);
    let currentIdx = -1;

    function playTrack(row) {
        const canPlay = row.getAttribute('data-can-play') === 'true';
        if (!canPlay) { alert('Bu şarkıyı dinlemek için paketiniz yetersiz.'); return; }

        const idx   = parseInt(row.getAttribute('data-idx'));
        const audio = row.getAttribute('data-audio');
        const title = row.getAttribute('data-title');
        const artist= row.getAttribute('data-artist');
        const cover = row.getAttribute('data-cover');

        // Playable index'i bul
        const playableIdx = PLAYABLE.findIndex(t => t.songId === parseInt(row.getAttribute('data-song-id')));
        if (playableIdx !== -1) currentIdx = playableIdx;

        // Aktif satır
        document.querySelectorAll('.track-row').forEach(r => r.classList.remove('playing'));
        row.classList.add('playing');

        // Player bar
        document.getElementById('playerSong').textContent   = title;
        document.getElementById('playerArtist').textContent = artist;
        const coverEl = document.getElementById('playerCover');
        coverEl.innerHTML = cover ? `<img src="${cover}" onerror="this.parentElement.textContent='🎵'">` : '🎵';

        const videoId = getYoutubeId(audio);
        if (!videoId) { console.error('Geçersiz URL:', audio); return; }

        if (ytReady && ytPlayer?.loadVideoById) ytPlayer.loadVideoById(videoId);
        else pendingVideoId = videoId;

        saveToHistory(row.getAttribute('data-song-id'));
    }

    function playAll() {
        if (!PLAYABLE.length) return;
        currentIdx = 0;
        const t = PLAYABLE[0];
        const row = document.querySelector(`[data-song-id="${t.songId}"]`);
        if (row) playTrack(row);
    }

    function playNext() {
        if (!PLAYABLE.length) return;
        currentIdx = (currentIdx + 1) % PLAYABLE.length;
        const t = PLAYABLE[currentIdx];
        const row = document.querySelector(`[data-song-id="${t.songId}"]`);
        if (row) playTrack(row);
    }

    function playPrev() {
        if (!PLAYABLE.length) return;
        currentIdx = (currentIdx - 1 + PLAYABLE.length) % PLAYABLE.length;
        const t = PLAYABLE[currentIdx];
        const row = document.querySelector(`[data-song-id="${t.songId}"]`);
        if (row) playTrack(row);
    }

    async function removeSong(e, playlistSongId) {
        e.stopPropagation();
        if (!confirm('Bu şarkıyı listeden çıkarmak istiyor musunuz?')) return;
        try {
            const res = await fetch(`${API_BASE}/api/Playlist/${PLAYLIST_ID}/songs/${playlistSongId}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${TOKEN}` }
            });
            if (res.ok) window.location.reload();
        } catch(err) { console.error(err); }
    }

    async function saveToHistory(songId) {
        try {
            await fetch(`${API_BASE}/api/ListeningHistory`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${TOKEN}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ songId: parseInt(songId) })
            });
        } catch(err) { console.error('saveToHistory:', err); }
    }

    /* YouTube */
    var tag = document.createElement('script');
    tag.src = "https://www.youtube.com/iframe_api";
    document.head.appendChild(tag);

    let ytPlayer, ytReady = false, pendingVideoId = null;
    let volumeVal = 70, isMuted = false, progressInterval;

    function onYouTubeIframeAPIReady() {
        ytPlayer = new YT.Player('ytPlayer', {
            height:'0', width:'0',
            playerVars:{controls:0,disablekb:1,rel:0},
            events:{
                onReady: () => {
                    ytReady = true; ytPlayer.setVolume(volumeVal);
                    document.getElementById('volFill').style.width = volumeVal+'%';
                    if(pendingVideoId){ytPlayer.loadVideoById(pendingVideoId);pendingVideoId=null;}
                },
                onStateChange: e => {
                    if(e.data===YT.PlayerState.PLAYING){
                        document.getElementById('playIcon').className='bi bi-pause-fill';
                        document.getElementById('waveform').classList.remove('paused');
                        startProgressLoop();
                    } else if(e.data===YT.PlayerState.PAUSED||e.data===YT.PlayerState.BUFFERING){
                        document.getElementById('playIcon').className='bi bi-play-fill';
                        document.getElementById('waveform').classList.add('paused');
                        clearInterval(progressInterval);
                    } else if(e.data===YT.PlayerState.ENDED){ playNext(); }
                },
                onError: e => console.error('YT:', e.data)
            }
        });
    }

    function togglePlay(){if(!ytPlayer?.getPlayerState)return;ytPlayer.getPlayerState()===YT.PlayerState.PLAYING?ytPlayer.pauseVideo():ytPlayer.playVideo();}
    function startProgressLoop(){clearInterval(progressInterval);progressInterval=setInterval(()=>{if(!ytPlayer?.getCurrentTime)return;const c=ytPlayer.getCurrentTime(),d=ytPlayer.getDuration();if(d>0){document.getElementById('progressFill').style.width=(c/d*100)+'%';document.getElementById('currentTime').textContent=fmt(c);document.getElementById('totalTime').textContent=fmt(d);}},500);}
    function seekTo(e){if(!ytPlayer?.getDuration)return;const rect=document.getElementById('progressBar').getBoundingClientRect();ytPlayer.seekTo(((e.clientX-rect.left)/rect.width)*ytPlayer.getDuration(),true);}
    function setVolume(e){if(!ytPlayer?.setVolume)return;const rect=document.getElementById('volTrack').getBoundingClientRect();volumeVal=Math.min(100,Math.max(0,((e.clientX-rect.left)/rect.width)*100));ytPlayer.unMute();ytPlayer.setVolume(volumeVal);document.getElementById('volFill').style.width=volumeVal+'%';updateVolIcon();}
    function toggleMute(){if(!ytPlayer)return;if(ytPlayer.isMuted()){ytPlayer.unMute();ytPlayer.setVolume(volumeVal);document.getElementById('volFill').style.width=volumeVal+'%';isMuted=false;}else{ytPlayer.mute();document.getElementById('volFill').style.width='0%';isMuted=true;}updateVolIcon();}
    function updateVolIcon(){document.getElementById('volIcon').className=isMuted||volumeVal===0?'bi bi-volume-mute-fill':'bi bi-volume-up-fill';}
    function toggleHeart(btn){btn.classList.toggle('liked');btn.querySelector('i').className=btn.classList.contains('liked')?'bi bi-heart-fill':'bi bi-heart';}
    function fmt(s){return Math.floor(s/60)+':'+String(Math.floor(s%60)).padStart(2,'0');}
    function getYoutubeId(url){if(!url)return null;if(url.length===11&&!url.includes('/')&&!url.includes('?'))return url;const m=url.match(/^.*(youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/);return(m&&m[2].length===11)?m[2]:null;}
</script>
</body>
</html>
