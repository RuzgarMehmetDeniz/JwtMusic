@model JwtMusic.WebUI.Dtos.RegisterDto
@{
    Layout = null;
    ViewData["Title"] = "Kayıt Ol — Canlı Müzik";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bg-root:       #0c0c0e;
            --bg-panel:      #111113;
            --bg-surface:    #1c1c1f;
            --bg-input:      #1a1a1c;
            --accent:        #c9a84c;
            --accent-dim:    rgba(201,168,76,0.12);
            --accent-border: rgba(201,168,76,0.28);
            --accent-glow:   0 0 40px rgba(201,168,76,0.15);
            --text-1:        #e8e8ea;
            --text-2:        #8a8a94;
            --text-3:        #46464e;
            --border:        rgba(255,255,255,0.055);
            --border-hover:  rgba(255,255,255,0.11);
            --radius-card:   20px;
            --radius-input:  10px;
            --radius-pill:   100px;
            --transition:    0.22s cubic-bezier(0.4,0,0.2,1);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; font-family: 'Inter', sans-serif; background: var(--bg-root); color: var(--text-1); }

        /* ── LAYOUT ── */
        .page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* ── LEFT PANEL ── */
        .left-panel {
            position: relative;
            background: var(--bg-panel);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            padding: 40px 48px;
            overflow: hidden;
        }

        .left-panel::before {
            content: '';
            position: absolute; inset: 0;
            background:
                radial-gradient(ellipse 70% 55% at 25% 20%, rgba(201,168,76,0.09) 0%, transparent 60%),
                radial-gradient(ellipse 50% 65% at 75% 75%, rgba(201,168,76,0.05) 0%, transparent 55%);
            pointer-events: none;
        }

        /* Logo */
        .logo {
            position: relative; z-index: 1;
            display: flex; align-items: center; gap: 10px;
            text-decoration: none;
        }

        .logo-mark {
            width: 32px; height: 32px;
            background: var(--accent);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
        }
        .logo-mark i { color: #0c0c0e; font-size: 1rem; }

        .logo-text {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800; font-size: 1rem;
            letter-spacing: -0.3px; color: var(--text-1);
        }

        /* Hero content */
        .left-content {
            position: relative; z-index: 1;
            flex: 1;
            display: flex; flex-direction: column;
            justify-content: center;
            padding: 3rem 0;
        }

        .hero-badge {
            display: inline-flex; align-items: center; gap: 6px;
            background: var(--accent-dim);
            border: 1px solid var(--accent-border);
            color: var(--accent);
            font-size: 0.68rem; font-weight: 700;
            letter-spacing: 0.08em; text-transform: uppercase;
            padding: 4px 12px; border-radius: var(--radius-pill);
            margin-bottom: 20px;
            width: fit-content;
        }

        .hero-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: clamp(2rem, 2.8vw, 3rem);
            font-weight: 800;
            letter-spacing: -1.5px;
            line-height: 1.08;
            margin-bottom: 1rem;
        }

        .hero-title .gold { color: var(--accent); }

        .hero-desc {
            font-size: 0.875rem;
            color: var(--text-2);
            line-height: 1.7;
            max-width: 340px;
            margin-bottom: 2.5rem;
        }

        /* Stats */
        .stats {
            display: flex; gap: 2rem; flex-wrap: wrap;
            margin-bottom: 3rem;
        }

        .stat { display: flex; flex-direction: column; gap: 2px; }

        .stat-val {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.4rem; font-weight: 800;
            letter-spacing: -0.8px; color: var(--accent);
        }

        .stat-lbl { font-size: 0.72rem; color: var(--text-3); }

        /* Floating mini cards */
        .mini-cards { display: flex; flex-direction: column; gap: 8px; }

        .mini-card {
            display: flex; align-items: center; gap: 10px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            border-radius: 12px; padding: 10px 14px;
            width: fit-content;
            animation: floatY 5s ease-in-out infinite;
        }

        .mini-card:nth-child(2) { animation-delay: -1.8s; margin-left: 20px; }
        .mini-card:nth-child(3) { animation-delay: -3.5s; margin-left: 10px; }

        @@keyframes floatY {
            0%, 100% { transform: translateY(0); }
            50%       { transform: translateY(-5px); }
        }

        .mc-icon {
            width: 34px; height: 34px;
            border-radius: 8px;
            background: var(--accent-dim);
            border: 1px solid var(--accent-border);
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; flex-shrink: 0;
        }

        .mc-info { min-width: 0; }
        .mc-song   { font-size: 0.75rem; font-weight: 600; color: var(--text-1); white-space: nowrap; }
        .mc-artist { font-size: 0.68rem; color: var(--text-2); }

        .mc-bars { display: flex; align-items: center; gap: 2px; margin-left: 12px; }
        .mc-bars span {
            display: block; width: 2px; border-radius: 2px;
            background: var(--accent);
            animation: barAnim 1.1s ease-in-out infinite;
        }
        .mc-bars span:nth-child(1) { height: 7px;  animation-delay: 0s; }
        .mc-bars span:nth-child(2) { height: 12px; animation-delay: 0.12s; }
        .mc-bars span:nth-child(3) { height: 9px;  animation-delay: 0.06s; }
        .mc-bars span:nth-child(4) { height: 14px; animation-delay: 0.18s; }

        @@keyframes barAnim {
            0%, 100% { transform: scaleY(1); }
            50%       { transform: scaleY(0.3); }
        }

        /* ── RIGHT PANEL ── */
        .right-panel {
            display: flex;
            align-items: center; justify-content: center;
            padding: 40px 32px;
            background: var(--bg-root);
            overflow-y: auto;
        }

        .form-card {
            width: 100%; max-width: 440px;
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: var(--radius-card);
            padding: 36px 32px;
            position: relative; overflow: hidden;
            animation: cardIn 0.5s cubic-bezier(0.22,1,0.36,1) both;
        }

        @@keyframes cardIn {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .form-card::before {
            content: '';
            position: absolute; top: 0; left: 10%; right: 10%;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
        }

        /* Form head */
        .form-head { text-align: center; margin-bottom: 24px; }

        .form-icon {
            width: 52px; height: 52px;
            border-radius: 14px;
            background: var(--accent-dim);
            border: 1px solid var(--accent-border);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem; margin: 0 auto 14px;
        }

        .form-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.4rem; font-weight: 800;
            letter-spacing: -0.5px; color: var(--text-1); margin-bottom: 5px;
        }

        .form-subtitle { font-size: 0.8rem; color: var(--text-2); }

        /* Validation */
        .validation-summary-errors {
            background: rgba(239,68,68,0.08);
            border: 1px solid rgba(239,68,68,0.25);
            border-radius: 10px; padding: 10px 14px;
            margin-bottom: 14px; font-size: 0.78rem; color: #f87171;
        }
        .validation-summary-errors ul { margin: 0; padding-left: 16px; }
        .validation-summary-valid { display: none; }
        .field-validation-error { font-size: 0.7rem; color: #f87171; }

        /* Two-col row */
        .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

        /* Field */
        .field { position: relative; margin-bottom: 10px; }

        .field-icon {
            position: absolute; left: 13px; top: 50%;
            transform: translateY(-50%);
            color: var(--text-3); font-size: 0.82rem;
            pointer-events: none; z-index: 2;
            transition: color var(--transition);
        }

        .field:focus-within .field-icon { color: var(--accent); }

        .sw-input {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--border);
            color: var(--text-1);
            border-radius: var(--radius-input);
            padding: 10px 14px 10px 36px;
            font-size: 0.85rem;
            font-family: 'Inter', sans-serif;
            outline: none;
            transition: border-color var(--transition), box-shadow var(--transition);
        }

        .sw-input::placeholder { color: var(--text-3); }

        .sw-input:focus {
            border-color: var(--accent-border);
            box-shadow: 0 0 0 3px rgba(201,168,76,0.08);
        }

        .sw-input.has-toggle { padding-right: 40px; }

        .field.is-invalid .sw-input { border-color: rgba(239,68,68,0.5); }

        .field-error {
            font-size: 0.7rem; color: #f87171;
            padding-left: 2px; margin-top: 3px; display: none;
        }
        .field.is-invalid .field-error { display: block; }

        /* Eye toggle */
        .pw-eye {
            position: absolute; right: 12px; top: 50%;
            transform: translateY(-50%);
            background: none; border: none;
            color: var(--text-3); font-size: 0.9rem;
            cursor: pointer; padding: 4px;
            transition: color var(--transition); z-index: 2;
        }
        .pw-eye:hover { color: var(--text-2); }

        /* Password strength */
        .pw-strength { margin-top: 6px; display: none; }
        .strength-bars { display: flex; gap: 3px; margin-bottom: 4px; }
        .strength-bar { flex: 1; height: 3px; border-radius: 3px; background: rgba(255,255,255,0.07); transition: background 0.3s; }
        .strength-lbl { font-size: 0.67rem; color: var(--text-3); }

        /* Terms */
        .terms-row {
            display: flex; align-items: flex-start; gap: 9px;
            margin-bottom: 18px;
        }

        .sw-check {
            width: 16px; height: 16px;
            border: 1.5px solid var(--border-hover);
            border-radius: 4px; background: var(--bg-input);
            appearance: none; -webkit-appearance: none;
            cursor: pointer; flex-shrink: 0; margin-top: 2px;
            position: relative; transition: all var(--transition);
        }

        .sw-check:checked { background: var(--accent); border-color: var(--accent); }

        .sw-check:checked::after {
            content: '';
            position: absolute; left: 3px; top: 1px;
            width: 6px; height: 8px;
            border: 2px solid #0c0c0e;
            border-top: none; border-left: none;
            transform: rotate(40deg);
        }

        .terms-text {
            font-size: 0.78rem; color: var(--text-2); line-height: 1.5;
        }
        .terms-text a { color: var(--accent); text-decoration: none; }
        .terms-text a:hover { text-decoration: underline; }

        /* Submit */
        .btn-submit {
            width: 100%; padding: 11px 20px;
            border: none; border-radius: var(--radius-pill);
            background: var(--accent); color: #0c0c0e;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.9rem; font-weight: 700;
            cursor: pointer;
            transition: background var(--transition), transform 0.15s;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            margin-bottom: 18px;
            box-shadow: var(--accent-glow);
        }
        .btn-submit:hover { background: #d4b360; transform: translateY(-1px); }
        .btn-submit:active { transform: translateY(0); }
        .btn-arrow { transition: transform var(--transition); }
        .btn-submit:hover .btn-arrow { transform: translateX(3px); }

        /* Divider */
        .divider {
            display: flex; align-items: center; gap: 12px;
            margin-bottom: 14px;
            color: var(--text-3); font-size: 0.72rem;
        }
        .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }

        /* Alt link */
        .alt-link { text-align: center; font-size: 0.8rem; color: var(--text-2); }
        .alt-link a { color: var(--accent); text-decoration: none; font-weight: 600; transition: opacity var(--transition); }
        .alt-link a:hover { opacity: 0.75; }

        /* Responsive */
        @@media (max-width: 860px) {
            .page { grid-template-columns: 1fr; }
            .left-panel { display: none; }
            .right-panel { min-height: 100vh; }
        }
        @@media (max-width: 480px) {
            .two-col { grid-template-columns: 1fr; }
            .form-card { padding: 28px 20px; }
        }
    </style>
</head>
<body>
<div class="page">

    <!-- ══ LEFT PANEL ══ -->
    <aside class="left-panel">
        <a href="#" class="logo">
            <div class="logo-mark"><i class="bi bi-soundwave"></i></div>
            <span class="logo-text">Canlı Müzik</span>
        </a>

        <div class="left-content">
            <div class="hero-badge"><i class="bi bi-stars"></i> Ücretsiz Başla</div>

            <h1 class="hero-title">
                Müziği<br>
                <span class="gold">Hisset,</span><br>
                Keşfet, Yaşa
            </h1>

            <p class="hero-desc">
                Hesap oluştur, dinleme geçmişine göre kişiselleştirilmiş öneriler al.
                Premium, Gold ve Elit içeriklere erişim için paketini seç.
            </p>

            <div class="stats">
                <div class="stat">
                    <span class="stat-val">130+</span>
                    <span class="stat-lbl">Şarkı</span>
                </div>
                <div class="stat">
                    <span class="stat-val">AI</span>
                    <span class="stat-lbl">Öneri Sistemi</span>
                </div>
                <div class="stat">
                    <span class="stat-val">4</span>
                    <span class="stat-lbl">Üyelik Paketi</span>
                </div>
            </div>

            <div class="mini-cards">
                <div class="mini-card">
                    <div class="mc-icon">🎵</div>
                    <div class="mc-info">
                        <div class="mc-song">Yeni Şarkılar</div>
                        <div class="mc-artist">Her gün güncelleniyor</div>
                    </div>
                    <div class="mc-bars"><span></span><span></span><span></span><span></span></div>
                </div>
                <div class="mini-card">
                    <div class="mc-icon">⭐</div>
                    <div class="mc-info">
                        <div class="mc-song">Kişisel Öneriler</div>
                        <div class="mc-artist">ML.NET ile analiz</div>
                    </div>
                    <div class="mc-bars"><span></span><span></span><span></span><span></span></div>
                </div>
                <div class="mini-card">
                    <div class="mc-icon">🎤</div>
                    <div class="mc-info">
                        <div class="mc-song">Sanatçı Detayları</div>
                        <div class="mc-artist">Tüm diskografi</div>
                    </div>
                    <div class="mc-bars"><span></span><span></span><span></span><span></span></div>
                </div>
            </div>
        </div>
    </aside>

    <!-- ══ RIGHT PANEL ══ -->
    <section class="right-panel">
        <div class="form-card">

            <div class="form-head">
                <div class="form-icon"><i class="bi bi-music-note-beamed" style="color:var(--accent)"></i></div>
                <h2 class="form-title">Hesap Oluştur</h2>
                <p class="form-subtitle">Ücretsiz yolculuğunuza bugün başlayın.</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <form method="post" id="registerForm" novalidate>
                @Html.AntiForgeryToken()

                <!-- Ad + Soyad -->
                <div class="two-col">
                    <div class="field" id="grp-name">
                        <i class="bi bi-person field-icon"></i>
                        <input asp-for="Name" class="sw-input" type="text"
                               name="Name" id="Name" placeholder="Adınız" autocomplete="given-name">
                        <span asp-validation-for="Name" class="field-validation-error field-error"></span>
                    </div>
                    <div class="field" id="grp-surname">
                        <i class="bi bi-person field-icon"></i>
                        <input asp-for="Surname" class="sw-input" type="text"
                               name="Surname" id="Surname" placeholder="Soyadınız" autocomplete="family-name">
                        <span asp-validation-for="Surname" class="field-validation-error field-error"></span>
                    </div>
                </div>

                <!-- Kullanıcı adı -->
                <div class="field" id="grp-username">
                    <i class="bi bi-at field-icon"></i>
                    <input asp-for="UserName" class="sw-input" type="text"
                           name="UserName" id="UserName" placeholder="Kullanıcı adı" autocomplete="username">
                    <span asp-validation-for="UserName" class="field-validation-error field-error"></span>
                </div>

                <!-- E-posta -->
                <div class="field" id="grp-email">
                    <i class="bi bi-envelope field-icon"></i>
                    <input asp-for="Email" class="sw-input" type="email"
                           name="Email" id="Email" placeholder="E-posta adresi" autocomplete="email">
                    <span asp-validation-for="Email" class="field-validation-error field-error"></span>
                </div>

                <!-- Şifre -->
                <div class="field" id="grp-password">
                    <i class="bi bi-lock field-icon"></i>
                    <input asp-for="Password" class="sw-input has-toggle" type="password"
                           name="Password" id="Password" placeholder="Şifre"
                           autocomplete="new-password" oninput="checkStrength(this.value)">
                    <button type="button" class="pw-eye" onclick="togglePw()" title="Göster/Gizle">
                        <i class="bi bi-eye" id="pwIcon"></i>
                    </button>
                    <span asp-validation-for="Password" class="field-validation-error field-error"></span>

                    <div class="pw-strength" id="pwStrength">
                        <div class="strength-bars">
                            <div class="strength-bar" id="sb1"></div>
                            <div class="strength-bar" id="sb2"></div>
                            <div class="strength-bar" id="sb3"></div>
                            <div class="strength-bar" id="sb4"></div>
                        </div>
                        <span class="strength-lbl" id="strengthLbl"></span>
                    </div>
                </div>

                <!-- Şartlar -->
                <div class="terms-row">
                    <input type="checkbox" class="sw-check" id="terms" name="terms">
                    <label for="terms" class="terms-text">
                        <a href="#">Kullanım Şartları</a>'nı ve <a href="#">Gizlilik Politikası</a>'nı kabul ediyorum.
                    </label>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="bi bi-person-plus"></i>
                    Hesap Oluştur
                    <i class="bi bi-arrow-right btn-arrow"></i>
                </button>

                <div class="divider">veya</div>

                <p class="alt-link">
                    Zaten hesabınız var mı?
                    <a asp-action="SingIn" asp-controller="Login">Giriş yap</a>
                </p>
            </form>
        </div>
    </section>

</div>

<script>
    /* Şifre göster/gizle */
    function togglePw() {
        const pw   = document.getElementById('Password');
        const icon = document.getElementById('pwIcon');
        if (pw.type === 'password') { pw.type = 'text';     icon.className = 'bi bi-eye-slash'; }
        else                        { pw.type = 'password'; icon.className = 'bi bi-eye'; }
    }

    /* Şifre güç göstergesi */
    function checkStrength(val) {
        const wrap  = document.getElementById('pwStrength');
        const lbl   = document.getElementById('strengthLbl');
        const bars  = ['sb1','sb2','sb3','sb4'].map(id => document.getElementById(id));
        if (!val) { wrap.style.display = 'none'; return; }
        wrap.style.display = 'block';

        let score = 0;
        if (val.length >= 8)           score++;
        if (/[A-Z]/.test(val))         score++;
        if (/[0-9]/.test(val))         score++;
        if (/[^A-Za-z0-9]/.test(val))  score++;

        const cfg = [
            { color: '#ef4444', text: 'Zayıf' },
            { color: '#f97316', text: 'Orta'  },
            { color: '#eab308', text: 'İyi'   },
            { color: '#c9a84c', text: 'Güçlü' },
        ];

        bars.forEach((bar, i) => {
            bar.style.background = i < score ? cfg[score - 1].color : 'rgba(255,255,255,0.07)';
        });
        lbl.textContent = cfg[score - 1]?.text ?? '';
        lbl.style.color = cfg[score - 1]?.color ?? '';
    }

    document.getElementById('registerForm').addEventListener('submit', function (e) {
        let valid = true;

        [{ id: 'Name',     grp: 'grp-name',     msg: 'Ad gerekli.'             },
         { id: 'Surname',  grp: 'grp-surname',  msg: 'Soyad gerekli.'          },
         { id: 'UserName', grp: 'grp-username', msg: 'Kullanıcı adı gerekli.'  },
         { id: 'Email',    grp: 'grp-email',    msg: 'Geçerli e-posta gerekli.' },
         { id: 'Password', grp: 'grp-password', msg: 'Şifre gerekli.'          }]
        .forEach(f => {
            const el  = document.getElementById(f.id);
            const grp = document.getElementById(f.grp);
            const err = grp.querySelector('.field-error, .field-validation-error');
            const empty   = !el.value.trim();
                const badMail = f.id === 'Email' && el.value && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(el.value);
            if (empty || badMail) {
                grp.classList.add('is-invalid');
                if (err && !err.textContent.trim()) err.textContent = f.msg;
                if (err) err.style.display = 'block';
                valid = false;
            } else {
                grp.classList.remove('is-invalid');
                if (err) err.style.display = 'none';
            }
        });

        const terms = document.getElementById('terms');
        if (!terms.checked) {
            terms.style.outline = '2px solid rgba(239,68,68,0.6)';
            valid = false;
        } else {
            terms.style.outline = '';
        }

        if (!valid) e.preventDefault();
    });

    /* Input'ta hata temizle */
    document.querySelectorAll('.sw-input').forEach(inp => {
        inp.addEventListener('input', () => {
            const grp = inp.closest('.field');
            if (!grp) return;
            grp.classList.remove('is-invalid');
            const err = grp.querySelector('.field-error, .field-validation-error');
            if (err) err.style.display = 'none';
        });
    });
