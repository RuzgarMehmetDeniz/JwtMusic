@model JwtMusic.WebUI.Dtos.RegisterDto

@{
    Layout = null;
    ViewData["Title"] = "Hesap Oluştur – SoundWave";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />

    <style>
        /* ── CSS VARIABLES ── */
        :root {
            --bg-base: #06060f;
            --bg-hero: #0a0a18;
            --glass-bg: rgba(14, 14, 28, 0.75);
            --glass-border: rgba(255, 255, 255, 0.07);
            --accent-lime: #c8ff57;
            --accent-cyan: #00e5ff;
            --accent-violet: #7c3aed;
            --accent-pink: #f72585;
            --text-primary: #f0f0ff;
            --text-secondary: #8888aa;
            --text-muted: #44445a;
            --input-bg: rgba(255, 255, 255, 0.04);
            --input-border: rgba(255, 255, 255, 0.08);
            --radius-card: 24px;
            --radius-input: 14px;
            --radius-pill: 50px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
            font-family: 'DM Sans', sans-serif;
            background: var(--bg-base);
            color: var(--text-primary);
            overflow-x: hidden;
        }

        /* ── PAGE LAYOUT ── */
        .register-page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* ─────────────────────────────────────────
                   LEFT HERO PANEL
                ───────────────────────────────────────── */
        .hero-panel {
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem);
            background: var(--bg-hero);
        }

        /* Mesh gradient backdrop */
        .hero-bg {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 80% 70% at 15% 30%, rgba(124, 58, 237, 0.35) 0%, transparent 55%), radial-gradient(ellipse 60% 50% at 75% 70%, rgba(0, 229, 255, 0.2) 0%, transparent 55%), radial-gradient(ellipse 50% 60% at 50% 10%, rgba(247, 37, 133, 0.12) 0%, transparent 50%), radial-gradient(ellipse 40% 40% at 90% 10%, rgba(200, 255, 87, 0.08) 0%, transparent 50%);
            pointer-events: none;
        }

            /* Subtle noise grain */
            .hero-bg::after {
                content: '';
                position: absolute;
                inset: 0;
                background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
                opacity: .5;
                pointer-events: none;
            }

        /* ── LOGO ── */
        .hero-logo {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: clamp(3rem, 8vh, 5rem);
            text-decoration: none;
        }

        .hero-logo-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-violet));
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            color: #fff;
            box-shadow: 0 0 24px rgba(0, 229, 255, 0.4);
            flex-shrink: 0;
        }

        .hero-logo-text {
            font-family: 'Syne', sans-serif;
            font-size: 1.3rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            background: linear-gradient(90deg, var(--accent-cyan), var(--accent-violet));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* ── HERO CONTENT ── */
        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-kicker {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--accent-lime);
            background: rgba(200, 255, 87, 0.1);
            border: 1px solid rgba(200, 255, 87, 0.25);
            border-radius: var(--radius-pill);
            padding: 5px 16px;
            margin-bottom: 1.4rem;
        }

        .hero-title {
            font-family: 'Syne', sans-serif;
            font-size: clamp(2.6rem, 4.5vw, 4rem);
            font-weight: 800;
            line-height: 1.05;
            letter-spacing: -2px;
            margin-bottom: 1.25rem;
        }

            .hero-title .hl-cyan {
                background: linear-gradient(135deg, var(--accent-cyan), #00b4cc);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

            .hero-title .hl-lime {
                background: linear-gradient(135deg, var(--accent-lime), #a3e635);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

        .hero-desc {
            color: var(--text-secondary);
            font-size: 1rem;
            font-weight: 300;
            line-height: 1.75;
            max-width: 400px;
            margin-bottom: 2.5rem;
        }

        /* ── STATS ROW ── */
        .hero-stats {
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .stat-item {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .stat-num {
            font-family: 'Syne', sans-serif;
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: -1px;
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-violet));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-label {
            font-size: 0.75rem;
            color: var(--text-muted);
            font-weight: 400;
        }

        /* ── FLOATING MUSIC CARDS ── */
        .floating-cards {
            position: absolute;
            bottom: 2.5rem;
            left: clamp(2rem, 5vw, 4rem);
            right: 2rem;
            z-index: 2;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

        .mini-card {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(20px);
            border-radius: 14px;
            padding: 0.7rem 1rem;
            width: fit-content;
            animation: floatCard 6s ease-in-out infinite;
        }

            .mini-card:nth-child(2) {
                animation-delay: -2s;
                margin-left: 2rem;
            }

            .mini-card:nth-child(3) {
                animation-delay: -4s;
                margin-left: 1rem;
            }

        @@keyframes floatCard {
            0%, 100%

        {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-6px);
        }

        }

        .mini-cover {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
        }

        .mc-violet {
            background: linear-gradient(135deg, #4a1d96, #7c3aed);
        }

        .mc-cyan {
            background: linear-gradient(135deg, #0e7490, #00e5ff);
        }

        .mc-pink {
            background: linear-gradient(135deg, #9d174d, #f72585);
        }

        .mini-meta {
            min-width: 0;
        }

        .mini-song {
            font-size: 0.78rem;
            font-weight: 600;
            white-space: nowrap;
        }

        .mini-artist {
            font-size: 0.68rem;
            color: var(--text-secondary);
            white-space: nowrap;
        }

        .mini-wave {
            display: flex;
            align-items: center;
            gap: 2px;
            margin-left: auto;
            padding-left: 0.75rem;
        }

            .mini-wave span {
                display: block;
                width: 3px;
                border-radius: 3px;
                background: var(--accent-cyan);
                animation: barWave 1.3s ease-in-out infinite;
            }

                .mini-wave span:nth-child(1) {
                    height: 8px;
                    animation-delay: 0s;
                }

                .mini-wave span:nth-child(2) {
                    height: 14px;
                    animation-delay: 0.1s;
                }

                .mini-wave span:nth-child(3) {
                    height: 10px;
                    animation-delay: 0.2s;
                }

                .mini-wave span:nth-child(4) {
                    height: 16px;
                    animation-delay: 0.3s;
                }
        @@keyframes barWave {
            0%, 100%

        {
            transform: scaleY(1);
        }

        50% {
            transform: scaleY(0.3);
        }

        }

        /* ── ABSTRACT WAVEFORM ── */
        .waveform-bg {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 220px;
            pointer-events: none;
            z-index: 1;
            opacity: 0.25;
        }

        /* ─────────────────────────────────────────
                   RIGHT FORM PANEL
                ───────────────────────────────────────── */
        .form-panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: clamp(2rem, 5vw, 3rem) clamp(1.5rem, 4vw, 3rem);
            background: var(--bg-base);
            overflow-y: auto;
        }

        .register-card {
            width: 100%;
            max-width: 480px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-card);
            padding: clamp(2rem, 5vw, 2.75rem);
            backdrop-filter: blur(40px);
            box-shadow: 0 0 0 1px rgba(255,255,255,0.04), 0 30px 80px rgba(0, 0, 0, 0.6), 0 0 60px rgba(124, 58, 237, 0.08);
            position: relative;
            overflow: hidden;
            animation: cardIn 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
        }
        @@keyframes cardIn {
            from

        {
            opacity: 0;
            transform: translateY(28px) scale(0.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        }

        /* Top glow line */
        .register-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 10%;
            right: 10%;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent-violet), var(--accent-cyan), transparent);
            border-radius: 1px;
        }

        /* ── CARD HEADER ── */
        .card-head {
            text-align: center;
            margin-bottom: 2rem;
        }

        .card-icon-wrap {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 54px;
            height: 54px;
            background: linear-gradient(135deg, rgba(124,58,237,0.3), rgba(0,229,255,0.2));
            border: 1px solid rgba(124,58,237,0.35);
            border-radius: 16px;
            font-size: 1.5rem;
            margin-bottom: 1rem;
            box-shadow: 0 8px 24px rgba(124,58,237,0.25);
        }

        .card-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.65rem;
            font-weight: 800;
            letter-spacing: -0.8px;
            margin-bottom: 0.4rem;
        }

        .card-subtitle {
            font-size: 0.85rem;
            color: var(--text-secondary);
            font-weight: 300;
        }

        /* ── FORM ROW ── */
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.85rem;
        }

        /* ── INPUT GROUP ── */
        .input-group-sw {
            position: relative;
            margin-bottom: 0.85rem;
        }

        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 0.95rem;
            pointer-events: none;
            transition: color 0.25s;
            z-index: 2;
        }

        .sw-input {
            width: 100%;
            background: var(--input-bg);
            border: 1px solid var(--input-border);
            border-radius: var(--radius-input);
            color: var(--text-primary);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.875rem;
            padding: 0.8rem 1rem 0.8rem 2.65rem;
            outline: none;
            transition: border-color 0.25s, background 0.25s, box-shadow 0.25s;
        }

            .sw-input::placeholder {
                color: var(--text-muted);
            }

            .sw-input:focus {
                border-color: rgba(0, 229, 255, 0.45);
                background: rgba(0, 229, 255, 0.04);
                box-shadow: 0 0 0 3px rgba(0, 229, 255, 0.08), 0 4px 16px rgba(0,0,0,0.2);
            }

                .sw-input:focus + .input-icon,
                .input-group-sw:focus-within .input-icon {
                    color: var(--accent-cyan);
                }

        /* Override for icon-left pattern — icon comes BEFORE input in DOM for label association,
                   but visually we use absolute positioning so we flip the sibling order via CSS trick */
        .input-group-sw .input-icon {
            left: 14px;
        }

        .input-group-sw .sw-input {
            padding-left: 2.6rem;
        }

        /* Password eye toggle */
        .pw-toggle {
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 1rem;
            cursor: pointer;
            padding: 4px;
            border-radius: 6px;
            transition: color 0.2s;
            z-index: 2;
        }

            .pw-toggle:hover {
                color: var(--text-secondary);
            }

        .sw-input.has-toggle {
            padding-right: 2.8rem;
        }

        /* ── VALIDATION MESSAGES ── */
        .field-error {
            font-size: 0.72rem;
            color: var(--accent-pink);
            padding-left: 4px;
            margin-top: 4px;
            display: none;
        }

        .input-group-sw.is-invalid .sw-input {
            border-color: rgba(247, 37, 133, 0.5);
        }

        .input-group-sw.is-invalid .field-error {
            display: block;
        }

        /* ── PASSWORD STRENGTH ── */
        .pw-strength {
            margin-top: 8px;
        }

        .strength-bar-row {
            display: flex;
            gap: 4px;
            margin-bottom: 5px;
        }

        .strength-bar {
            flex: 1;
            height: 3px;
            border-radius: 3px;
            background: rgba(255,255,255,0.08);
            transition: background 0.3s;
        }

        .strength-label {
            font-size: 0.68rem;
            color: var(--text-muted);
        }

        /* ── TERMS ── */
        .terms-row {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 1.25rem;
        }

        .sw-checkbox {
            width: 18px;
            height: 18px;
            border: 1.5px solid var(--input-border);
            border-radius: 5px;
            background: var(--input-bg);
            appearance: none;
            -webkit-appearance: none;
            cursor: pointer;
            flex-shrink: 0;
            margin-top: 2px;
            transition: all 0.2s;
            position: relative;
        }

            .sw-checkbox:checked {
                background: linear-gradient(135deg, var(--accent-cyan), var(--accent-violet));
                border-color: transparent;
            }

                .sw-checkbox:checked::after {
                    content: '';
                    position: absolute;
                    left: 4px;
                    top: 2px;
                    width: 6px;
                    height: 9px;
                    border: 2px solid #fff;
                    border-top: none;
                    border-left: none;
                    transform: rotate(40deg);
                }

        .terms-text {
            font-size: 0.8rem;
            color: var(--text-secondary);
            line-height: 1.5;
        }

            .terms-text a {
                color: var(--accent-cyan);
                text-decoration: none;
            }

                .terms-text a:hover {
                    text-decoration: underline;
                }

        /* ── SUBMIT BUTTON ── */
        .btn-register {
            width: 100%;
            padding: 0.9rem 1.5rem;
            border: none;
            border-radius: var(--radius-pill);
            background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-violet) 60%, var(--accent-pink) 100%);
            background-size: 200% 100%;
            color: #fff;
            font-family: 'Syne', sans-serif;
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 6px 24px rgba(0, 229, 255, 0.28);
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 1.5rem;
        }

            .btn-register::after {
                content: '';
                position: absolute;
                inset: 0;
                background: rgba(255,255,255,0);
                transition: background 0.25s;
            }

            .btn-register:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 36px rgba(0, 229, 255, 0.4);
                background-position: 100% 0;
            }

            .btn-register:active {
                transform: translateY(0);
            }

            .btn-register .btn-arrow {
                transition: transform 0.25s;
            }

            .btn-register:hover .btn-arrow {
                transform: translateX(3px);
            }

        /* ── DIVIDER ── */
        .divider {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.25rem;
            color: var(--text-muted);
            font-size: 0.75rem;
        }

            .divider::before, .divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--input-border);
            }

        /* ── LOGIN LINK ── */
        .login-link {
            text-align: center;
            font-size: 0.83rem;
            color: var(--text-secondary);
        }

            .login-link a {
                color: var(--accent-cyan);
                text-decoration: none;
                font-weight: 600;
                transition: opacity 0.2s;
            }

                .login-link a:hover {
                    opacity: 0.75;
                    text-decoration: underline;
                }

        /* ── VALIDATION SUMMARY (ASP.NET) ── */
        .validation-summary-errors {
            background: rgba(247, 37, 133, 0.08);
            border: 1px solid rgba(247, 37, 133, 0.25);
            border-radius: 12px;
            padding: 0.85rem 1rem;
            margin-bottom: 1rem;
            font-size: 0.8rem;
            color: var(--accent-pink);
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 1.1rem;
            }

        .field-validation-error {
            font-size: 0.72rem;
            color: var(--accent-pink);
        }

        /* ── RESPONSIVE ── */
        @@media (max-width: 900px) {
            .register-page {
                grid-template-columns: 1fr;
            }

            .hero-panel {
                display: none;
            }

            .form-panel {
                min-height: 100vh;
                background: var(--bg-hero);
            }
        }

        @@media (max-width: 480px) {
            .form-row {
                grid-template-columns: 1fr;
            }

            .register-card {
                padding: 1.75rem 1.25rem;
            }
        }
    </style>
</head>
<body>

    <div class="register-page">

        <!-- ══════════════════════════════
             LEFT  —  HERO PANEL
        ══════════════════════════════ -->
        <aside class="hero-panel">
            <div class="hero-bg"></div>

            <!-- Waveform SVG background -->
            <svg class="waveform-bg" viewBox="0 0 800 220" preserveAspectRatio="none" fill="none"
                 xmlns="http://www.w3.org/2000/svg">
                <polyline points="0,110 30,60 60,150 90,40 120,130 150,80 180,160 210,50 240,120 270,90 300,155 330,45 360,115 390,70 420,140 450,55 480,125 510,85 540,150 570,40 600,120 630,75 660,145 690,55 720,110 750,80 780,135 800,95"
                          stroke="url(#wg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                <polyline points="0,130 25,80 55,165 85,60 115,145 145,95 175,170 205,65 235,135 265,100 295,165 325,60 355,130 385,85 415,155 445,70 475,140 505,100 535,165 565,55 595,135 625,90 655,160 685,70 715,125 745,95 775,150 800,110"
                          stroke="url(#wg2)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.5" />
                <defs>
                    <linearGradient id="wg" x1="0" y1="0" x2="800" y2="0" gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stop-color="#7c3aed" />
                        <stop offset="50%" stop-color="#00e5ff" />
                        <stop offset="100%" stop-color="#f72585" />
                    </linearGradient>
                    <linearGradient id="wg2" x1="0" y1="0" x2="800" y2="0" gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stop-color="#00e5ff" />
                        <stop offset="100%" stop-color="#7c3aed" />
                    </linearGradient>
                </defs>
            </svg>

            <!-- Logo -->
            <a href="#" class="hero-logo">
                <div class="hero-logo-icon"><i class="bi bi-soundwave"></i></div>
                <span class="hero-logo-text">SoundWave</span>
            </a>

            <!-- Hero Copy -->
            <div class="hero-content">
                <div class="hero-kicker">
                    <i class="bi bi-stars"></i> Şimdi Açık Beta'da
                </div>
                <h1 class="hero-title">
                    Hisset<br>
                    <span class="hl-cyan">Müzik</span><br>
                    <span class="hl-lime">Her Yerde</span>
                </h1>
                <p class="hero-desc">
                    Hesap oluşturun ve sizin için özel olarak hazırlanmış milyonlarca şarkı,
                    sanatçı ve çalma listesi keşfedin.
                </p>
                <div class="hero-stats">
                    <div class="stat-item">
                        <span class="stat-num">80M+</span>
                        <span class="stat-label">Parça</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-num">4.2M</span>
                        <span class="stat-label">Sanatçı</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-num">Free</span>
                        <span class="stat-label">Başlamak için</span>
                    </div>
                </div>
            </div>

        </aside>

        <!-- ══════════════════════════════
             RIGHT  —  REGISTER FORM
        ══════════════════════════════ -->
        <section class="form-panel">
            <div class="register-card">

                <!-- Card header -->
                <div class="card-head">
                    <div class="card-icon-wrap">🎵</div>
                    <h2 class="card-title">Hesap oluşturmak</h2>
                    <p class="card-subtitle">Ücretsiz yolculuğunuza bugün başlayın.</p>
                </div>

                <!-- ASP.NET Core Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <!-- ── REGISTER FORM ── -->
                <form method="post" id="registerForm" novalidate>

                    @Html.AntiForgeryToken()

                    <!-- Name + Surname -->
                    <div class="form-row">
                        <div class="input-group-sw" id="grp-name">
                            <i class="bi bi-person input-icon"></i>
                            <input asp-for="Name"
                                   class="sw-input"
                                   type="text"
                                   name="Name"
                                   id="Name"
                                   placeholder="Adınız"
                                   autocomplete="given-name" />
                            <span asp-validation-for="Name" class="field-validation-error field-error"></span>
                        </div>
                        <div class="input-group-sw" id="grp-surname">
                            <i class="bi bi-person input-icon"></i>
                            <input asp-for="Surname"
                                   class="sw-input"
                                   type="text"
                                   name="Surname"
                                   id="Surname"
                                   placeholder="Soyadınız"
                                   autocomplete="family-name" />
                            <span asp-validation-for="Surname" class="field-validation-error field-error"></span>
                        </div>
                    </div>

                    <!-- Username -->
                    <div class="input-group-sw" id="grp-username">
                        <i class="bi bi-at input-icon"></i>
                        <input asp-for="UserName"
                               class="sw-input"
                               type="text"
                               name="UserName"
                               id="UserName"
                               placeholder="Kullanıcı Adınız"
                               autocomplete="username" />
                        <span asp-validation-for="UserName" class="field-validation-error field-error"></span>
                    </div>

                    <!-- Email -->
                    <div class="input-group-sw" id="grp-email">
                        <i class="bi bi-envelope input-icon"></i>
                        <input asp-for="Email"
                               class="sw-input"
                               type="email"
                               name="Email"
                               id="Email"
                               placeholder="Email adresiniz"
                               autocomplete="email" />
                        <span asp-validation-for="Email" class="field-validation-error field-error"></span>
                    </div>

                    <!-- Password -->
                    <div class="input-group-sw" id="grp-password">
                        <i class="bi bi-lock input-icon"></i>
                        <input asp-for="Password"
                               class="sw-input has-toggle"
                               type="password"
                               name="Password"
                               id="Password"
                               placeholder="Şifreniz"
                               autocomplete="new-password"
                               oninput="checkStrength(this.value)" />
                        <button type="button" class="pw-toggle" id="pwToggle"
                                onclick="togglePassword()" title="Show / Hide password">
                            <i class="bi bi-eye" id="pwEyeIcon"></i>
                        </button>
                        <span asp-validation-for="Password" class="field-validation-error field-error"></span>

                        <!-- Password strength meter -->
                        <div class="pw-strength" id="pwStrength" style="display:none;">
                            <div class="strength-bar-row">
                                <div class="strength-bar" id="sb1"></div>
                                <div class="strength-bar" id="sb2"></div>
                                <div class="strength-bar" id="sb3"></div>
                                <div class="strength-bar" id="sb4"></div>
                            </div>
                            <span class="strength-label" id="strengthLabel">Weak</span>
                        </div>
                    </div>

                    <!-- Terms checkbox -->
                    <div class="terms-row">
                        <input type="checkbox" class="sw-checkbox" id="terms" name="terms" />
                        <label for="terms" class="terms-text">
                            SoundWave'in şartlarını kabul ediyorum.
                            <a href="#">Hizmet Şartları</a> ve
                            <a href="#">Gizlilik Politikası</a>
                        </label>
                    </div>

                    <!-- Submit -->
                    <button type="submit" class="btn-register" id="submitBtn">
                        <i class="bi bi-music-note-beamed"></i>
                        Hesap Oluştur
                        <i class="bi bi-arrow-right btn-arrow"></i>
                    </button>

                    <div class="divider">veya</div>

                    <!-- Login redirect -->
                    <p class="login-link">
                        Zaten bir hesabınız var mı?
                        <a asp-action="SingIn" asp-controller="Login">Giriş yap</a>
                    </p>

                </form>
            </div>
        </section>

    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        /* ── PASSWORD SHOW / HIDE ── */
        function togglePassword() {
            const pw   = document.getElementById('Password');
            const icon = document.getElementById('pwEyeIcon');
            if (pw.type === 'password') {
                pw.type      = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                pw.type      = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        /* ── PASSWORD STRENGTH ── */
        function checkStrength(val) {
            const wrap  = document.getElementById('pwStrength');
            const label = document.getElementById('strengthLabel');
            const bars  = [
                document.getElementById('sb1'),
                document.getElementById('sb2'),
                document.getElementById('sb3'),
                document.getElementById('sb4'),
            ];

            if (!val) { wrap.style.display = 'none'; return; }
            wrap.style.display = 'block';

            let score = 0;
            if (val.length >= 8)                score++;
            if (/[A-Z]/.test(val))              score++;
            if (/[0-9]/.test(val))              score++;
            if (/[^A-Za-z0-9]/.test(val))       score++;

            const configs = [
                { color: '#f72585', text: 'Weak'   },
                { color: '#fb923c', text: 'Fair'   },
                { color: '#facc15', text: 'Good'   },
                { color: '#06ffa5', text: 'Strong' },
            ];

            bars.forEach((bar, i) => {
                bar.style.background = i < score
                    ? configs[score - 1].color
                    : 'rgba(255,255,255,0.08)';
            });
            label.textContent  = configs[score - 1]?.text ?? 'Weak';
            label.style.color  = configs[score - 1]?.color ?? '#f72585';
        }

        /* ── CLIENT-SIDE VALIDATION HIGHLIGHT ── */
        document.getElementById('registerForm').addEventListener('submit', function (e) {
            let valid = true;

            const fields = [
                { id: 'Name',     grp: 'grp-name',     msg: 'First name is required.'  },
                { id: 'Surname',  grp: 'grp-surname',  msg: 'Last name is required.'   },
                { id: 'UserName', grp: 'grp-username', msg: 'Username is required.'    },
                { id: 'Email',    grp: 'grp-email',    msg: 'A valid email is required.' },
                { id: 'Password', grp: 'grp-password', msg: 'Password is required.'    },
            ];

            fields.forEach(f => {
                const el  = document.getElementById(f.id);
                const grp = document.getElementById(f.grp);
                const err = grp.querySelector('.field-error') || grp.querySelector('.field-validation-error');
                const isEmpty = !el.value.trim();
                const isInvalidEmail = f.id === 'Email' && el.value && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(el.value);

                if (isEmpty || isInvalidEmail) {
                    grp.classList.add('is-invalid');
                    if (err && !err.textContent) err.textContent = f.msg;
                    if (err) err.style.display = 'block';
                    valid = false;
                } else {
                    grp.classList.remove('is-invalid');
                    if (err) err.style.display = 'none';
                }
            });

            const terms = document.getElementById('terms');
            if (!terms.checked) {
                terms.style.outline = '2px solid rgba(247,37,133,0.6)';
                valid = false;
            } else {
                terms.style.outline = '';
            }

            if (!valid) e.preventDefault();
        });

        /* ── CLEAR ERRORS ON INPUT ── */
        document.querySelectorAll('.sw-input').forEach(input => {
            input.addEventListener('input', () => {
                const grp = input.closest('.input-group-sw');
                if (grp) {
                    grp.classList.remove('is-invalid');
                    const err = grp.querySelector('.field-error, .field-validation-error');
                    if (err) err.style.display = 'none';
                }
            });
        });
    </script>

</body>
</html>


