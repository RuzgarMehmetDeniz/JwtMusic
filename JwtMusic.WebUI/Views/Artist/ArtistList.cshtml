@model List<JwtMusic.WebUI.Dtos.ResultArtistDto>
@{
    Layout = null;
    var token = ViewBag.Token as string ?? "";
    var userRole = ViewBag.UserRole as string ?? "Basic";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Canlı Müzik — Sanatçılar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bg-root: #0c0c0e;
            --bg-sidebar: #111113;
            --bg-main: #0c0c0e;
            --bg-card: #181819;
            --bg-card-hover: #202022;
            --bg-surface: #1c1c1f;
            --bg-input: #1a1a1c;
            --accent: #c9a84c;
            --accent-dim: rgba(201,168,76,0.12);
            --accent-border: rgba(201,168,76,0.28);
            --accent-glow: 0 0 24px rgba(201,168,76,0.18);
            --text-1: #e8e8ea;
            --text-2: #8a8a94;
            --text-3: #46464e;
            --border: rgba(255,255,255,0.055);
            --border-hover: rgba(255,255,255,0.11);
            --sidebar-w: 224px;
            --player-h: 76px;
            --radius-card: 14px;
            --radius-sm: 8px;
            --radius-pill: 100px;
            --transition: 0.22s cubic-bezier(0.4,0,0.2,1);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            height: 100%;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-root);
            color: var(--text-1);
            height: 100%;
            overflow: hidden;
            display: grid;
            grid-template-columns: var(--sidebar-w) 1fr;
            grid-template-rows: 1fr var(--player-h);
            grid-template-areas: "sidebar main" "player player";
        }

        img {
            display: block;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
            cursor: pointer;
        }

        /* SIDEBAR */
        .sidebar {
            grid-area: sidebar;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            user-select: none;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 22px 20px 20px;
            border-bottom: 1px solid var(--border);
        }

        .logo-mark {
            width: 30px;
            height: 30px;
            background: var(--accent);
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .logo-mark i {
                color: #0c0c0e;
                font-size: 0.95rem;
            }

        .logo-wordmark {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 0.95rem;
            letter-spacing: -0.3px;
            color: var(--text-1);
        }

        .sidebar-section {
            padding: 20px 12px 8px;
        }

        .sidebar-label {
            font-size: 0.65rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-3);
            padding: 0 8px;
            margin-bottom: 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 10px;
            border-radius: var(--radius-sm);
            color: var(--text-2);
            font-size: 0.855rem;
            font-weight: 500;
            cursor: pointer;
            transition: background var(--transition), color var(--transition);
            position: relative;
            text-decoration: none;
        }

            .nav-item i {
                font-size: 1rem;
                width: 18px;
                flex-shrink: 0;
                text-align: center;
            }

            .nav-item:hover {
                background: rgba(255,255,255,0.04);
                color: var(--text-1);
            }

            .nav-item.active {
                color: var(--text-1);
                background: rgba(255,255,255,0.05);
            }

                .nav-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 20%;
                    bottom: 20%;
                    width: 2.5px;
                    border-radius: 2px;
                    background: var(--accent);
                }

        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 8px 12px;
        }

        /* MAIN */
        .main {
            grid-area: main;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            background: var(--bg-main);
            scrollbar-width: thin;
            scrollbar-color: var(--bg-surface) transparent;
        }

            .main::-webkit-scrollbar {
                width: 5px;
            }

            .main::-webkit-scrollbar-track {
                background: transparent;
            }

            .main::-webkit-scrollbar-thumb {
                background: var(--bg-surface);
                border-radius: 4px;
            }

        /* TOPBAR */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 28px;
            background: rgba(12,12,14,0.88);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--border);
            gap: 16px;
        }

        .topbar-breadcrumb {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 700;
            font-size: 1rem;
            color: var(--text-1);
            letter-spacing: -0.3px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .search-field {
            position: relative;
            display: flex;
            align-items: center;
        }

            .search-field i {
                position: absolute;
                left: 12px;
                color: var(--text-3);
                font-size: 0.8rem;
                pointer-events: none;
            }

        .search-input {
            background: var(--bg-input);
            border: 1px solid var(--border);
            color: var(--text-1);
            border-radius: var(--radius-pill);
            padding: 7px 14px 7px 32px;
            font-size: 0.8rem;
            font-family: 'Inter', sans-serif;
            width: 210px;
            outline: none;
            transition: border-color var(--transition), box-shadow var(--transition), width var(--transition);
        }

            .search-input::placeholder {
                color: var(--text-3);
            }

            .search-input:focus {
                border-color: var(--accent-border);
                box-shadow: 0 0 0 3px rgba(201,168,76,0.08);
                width: 260px;
            }

        .topbar-icon-btn {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--bg-surface);
            border: 1px solid var(--border);
            color: var(--text-2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            cursor: pointer;
            transition: background var(--transition), color var(--transition);
        }

            .topbar-icon-btn:hover {
                background: var(--bg-card-hover);
                color: var(--text-1);
            }

        /* CONTENT */
        .content {
            padding: 28px 28px 40px;
            flex: 1;
        }

        .page-header {
            margin-bottom: 24px;
        }

            .page-header h1 {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 1.75rem;
                font-weight: 800;
                letter-spacing: -0.6px;
                color: var(--text-1);
                margin-bottom: 4px;
            }

            .page-header p {
                font-size: 0.83rem;
                color: var(--text-2);
                font-weight: 400;
            }

        /* FILTERS */
        .filters-row {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 24px;
        }

        .chip {
            padding: 6px 14px;
            border-radius: var(--radius-pill);
            font-size: 0.78rem;
            font-weight: 500;
            cursor: pointer;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text-2);
            transition: all var(--transition);
            letter-spacing: 0.01em;
        }

            .chip:hover {
                border-color: var(--border-hover);
                color: var(--text-1);
                background: rgba(255,255,255,0.03);
            }

            .chip.active {
                background: var(--accent);
                border-color: var(--accent);
                color: #0c0c0e;
                font-weight: 600;
            }

        /* ARTIST GRID */
        .artist-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 14px;
        }

        .artist-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-card);
            overflow: hidden;
            cursor: pointer;
            transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
            position: relative;
        }

            .artist-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 16px 40px rgba(0,0,0,0.55);
                border-color: rgba(201,168,76,0.22);
            }

            .artist-card.hide {
                display: none !important;
            }

            .artist-card::after {
                content: '';
                position: absolute;
                inset: 0;
                border-radius: var(--radius-card);
                border: 1.5px solid var(--accent);
                opacity: 0;
                transition: opacity var(--transition);
                pointer-events: none;
            }

            .artist-card:hover::after {
                opacity: 1;
            }

        /* CARD IMAGE */
        .card-img-wrap {
            position: relative;
            width: 100%;
            aspect-ratio: 1;
            overflow: hidden;
            background: var(--bg-surface);
        }

        .card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.38s cubic-bezier(0.25,0.8,0.25,1);
            display: block;
        }

        .card-img-wrap .img-fallback {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            background: linear-gradient(145deg, #1e1e22, #2a2a30);
        }

        .artist-card:hover .card-img {
            transform: scale(1.06);
        }

        .card-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, transparent 55%);
            opacity: 0;
            transition: opacity var(--transition);
            display: flex;
            align-items: flex-end;
            justify-content: flex-end;
            padding: 12px;
            gap: 8px;
        }

        .artist-card:hover .card-overlay {
            opacity: 1;
        }

        .overlay-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.18);
            background: rgba(12,12,14,0.7);
            color: var(--text-1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            cursor: pointer;
            transition: background var(--transition), border-color var(--transition), transform 0.15s;
            backdrop-filter: blur(6px);
            text-decoration: none;
        }

            .overlay-btn:hover {
                background: var(--accent);
                border-color: var(--accent);
                color: #0c0c0e;
                transform: scale(1.08);
            }

        /* ▶ Play butonu — artık sarı, tıklanınca şarkı çalar */
        .overlay-btn-play {
            width: 40px;
            height: 40px;
            background: var(--accent);
            border-color: var(--accent);
            color: #0c0c0e;
            font-size: 0.95rem;
        }

            .overlay-btn-play:hover {
                background: #d4b360;
                transform: scale(1.1);
            }

        /* CARD BODY */
        .card-body {
            padding: 12px 13px 13px;
        }

        .card-name {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.9rem;
            font-weight: 700;
            letter-spacing: -0.2px;
            color: var(--text-1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 2px;
        }

        .card-genre {
            font-size: 0.72rem;
            color: var(--text-2);
            margin-bottom: 10px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .card-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
        }

        .card-listeners {
            font-size: 0.7rem;
            color: var(--text-3);
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .card-listeners i {
                color: var(--accent);
                font-size: 0.65rem;
            }

        .btn-follow {
            font-size: 0.7rem;
            font-weight: 600;
            padding: 4px 11px;
            border-radius: var(--radius-pill);
            border: 1px solid var(--accent-border);
            background: transparent;
            color: var(--accent);
            cursor: pointer;
            transition: all var(--transition);
            white-space: nowrap;
            letter-spacing: 0.01em;
        }

            .btn-follow:hover {
                background: var(--accent-dim);
            }

            .btn-follow.following {
                background: var(--accent);
                border-color: var(--accent);
                color: #0c0c0e;
            }

        /* EMPTY STATE */
        .no-results {
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 5rem 1rem;
            color: var(--text-3);
            grid-column: 1 / -1;
        }

            .no-results i {
                font-size: 2.5rem;
                margin-bottom: 12px;
                display: block;
                color: var(--text-3);
            }

            .no-results p {
                font-size: 0.85rem;
                max-width: 260px;
                line-height: 1.6;
            }

            .no-results strong {
                display: block;
                font-size: 0.95rem;
                color: var(--text-2);
                margin-bottom: 4px;
                font-family: 'Plus Jakarta Sans', sans-serif;
            }

        /* PLAYER */
        .player {
            grid-area: player;
            background: #111113;
            border-top: 1px solid var(--border);
            display: grid;
            grid-template-columns: 280px 1fr 280px;
            align-items: center;
            padding: 0 20px;
            gap: 12px;
            z-index: 100;
        }

        .player-track {
            display: flex;
            align-items: center;
            gap: 11px;
            min-width: 0;
        }

        .player-cover {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-sm);
            background: var(--bg-surface);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
            overflow: hidden;
        }

            .player-cover img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .player-info {
            min-width: 0;
            flex: 1;
        }

        .player-song {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .player-artist {
            font-size: 0.72rem;
            color: var(--text-2);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 1px;
        }

        .player-like-btn {
            background: none;
            border: none;
            color: var(--text-3);
            font-size: 0.9rem;
            cursor: pointer;
            padding: 5px;
            transition: color var(--transition);
            flex-shrink: 0;
        }

            .player-like-btn:hover, .player-like-btn.liked {
                color: var(--accent);
            }

        .player-center {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 7px;
        }

        .player-controls {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .ctrl-btn {
            background: none;
            border: none;
            color: var(--text-2);
            font-size: 0.9rem;
            cursor: pointer;
            padding: 0;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color var(--transition), background var(--transition);
        }

            .ctrl-btn:hover {
                color: var(--text-1);
                background: rgba(255,255,255,0.05);
            }

        .ctrl-btn-play {
            width: 38px;
            height: 38px;
            background: var(--text-1);
            color: var(--bg-root);
            font-size: 1rem;
            border-radius: 50%;
            transition: transform 0.15s, background var(--transition);
        }

            .ctrl-btn-play:hover {
                background: #fff;
                color: var(--bg-root);
                transform: scale(1.05);
            }

        .player-progress {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            max-width: 440px;
        }

        .time-lbl {
            font-size: 0.65rem;
            color: var(--text-3);
            min-width: 30px;
            text-align: center;
            font-variant-numeric: tabular-nums;
        }

        .progress-track {
            flex: 1;
            height: 3px;
            background: rgba(255,255,255,0.08);
            border-radius: 3px;
            cursor: pointer;
            position: relative;
        }

            .progress-track:hover {
                height: 4px;
            }

        .progress-fill {
            height: 100%;
            border-radius: 3px;
            background: var(--text-1);
            width: 0%;
            position: relative;
            transition: width 0.1s linear;
        }

        .progress-track:hover .progress-fill {
            background: var(--accent);
        }

        .progress-fill::after {
            content: '';
            position: absolute;
            right: -4px;
            top: 50%;
            transform: translateY(-50%) scale(0);
            width: 9px;
            height: 9px;
            background: #fff;
            border-radius: 50%;
            transition: transform 0.15s;
        }

        .progress-track:hover .progress-fill::after {
            transform: translateY(-50%) scale(1);
        }

        .player-right {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
        }

            .player-right .ctrl-btn {
                font-size: 0.85rem;
            }

        .vol-wrap {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .vol-btn {
            background: none;
            border: none;
            color: var(--text-2);
            font-size: 0.9rem;
            cursor: pointer;
            padding: 4px;
            transition: color var(--transition);
        }

            .vol-btn:hover {
                color: var(--text-1);
            }

        .vol-track {
            width: 78px;
            height: 3px;
            background: rgba(255,255,255,0.08);
            border-radius: 3px;
            cursor: pointer;
            position: relative;
        }

        .vol-fill {
            height: 100%;
            border-radius: 3px;
            background: rgba(255,255,255,0.3);
            width: 70%;
            transition: background var(--transition);
        }

        .vol-track:hover .vol-fill {
            background: var(--text-1);
        }

        /* Waveform */
        .waveform {
            display: flex;
            align-items: center;
            gap: 2px;
            height: 14px;
        }

            .waveform span {
                display: block;
                width: 2.5px;
                border-radius: 2px;
                background: var(--accent);
                animation: wv 1.1s ease-in-out infinite;
            }

                .waveform span:nth-child(1) {
                    height: 5px;
                    animation-delay: 0s;
                }

                .waveform span:nth-child(2) {
                    height: 12px;
                    animation-delay: 0.1s;
                }

                .waveform span:nth-child(3) {
                    height: 8px;
                    animation-delay: 0.2s;
                }

                .waveform span:nth-child(4) {
                    height: 14px;
                    animation-delay: 0.3s;
                }

                .waveform span:nth-child(5) {
                    height: 6px;
                    animation-delay: 0.4s;
                }

        @@keyframes wv {
            0%, 100% {
                transform: scaleY(1);
            }

            50% {
                transform: scaleY(0.3);
            }
        }

        .waveform.paused span {
            animation-play-state: paused;
        }

        /* Loading spinner on card */
        .card-loading-overlay {
            position: absolute;
            inset: 0;
            border-radius: var(--radius-card);
            background: rgba(12,12,14,0.7);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 10;
        }

            .card-loading-overlay.active {
                display: flex;
            }

        @@keyframes spin {
            to

        {
            transform: rotate(360deg);
        }

        }

        .spinner {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            border: 2px solid rgba(201,168,76,0.3);
            border-top-color: var(--accent);
            animation: spin 0.7s linear infinite;
        }

        /* Responsive */
        @@media (max-width: 900px) {
            body {
                grid-template-columns: 1fr;
                grid-template-rows: 52px 1fr var(--player-h);
                grid-template-areas: "sidebar" "main" "player";
                overflow: hidden;
            }

            .sidebar {
                flex-direction: row;
                border-right: none;
                border-bottom: 1px solid var(--border);
                overflow-x: auto;
                overflow-y: hidden;
            }

            .sidebar-logo {
                padding: 12px 16px;
                border-bottom: none;
                border-right: 1px solid var(--border);
            }

            .sidebar-section {
                display: flex;
                flex-direction: row;
                padding: 8px;
                gap: 2px;
                align-items: center;
            }

            .sidebar-label, .sidebar-divider {
                display: none;
            }

            .nav-item.active::before {
                top: auto;
                left: 20%;
                right: 20%;
                bottom: 0;
                height: 2px;
                width: auto;
            }

            .player {
                grid-template-columns: 1fr auto;
            }

            .player-right {
                display: none;
            }
        }

        @@media (max-width: 600px) {
            .artist-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 10px;
            }

            .content {
                padding: 16px 14px 28px;
            }

            .topbar {
                padding: 10px 14px;
            }

            .search-input {
                width: 140px;
            }

                .search-input:focus {
                    width: 160px;
                }
        }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-mark"><i class="bi bi-soundwave"></i></div>
            <span class="logo-wordmark">Canlı Müzik</span>
        </div>
        <nav class="sidebar-section">
            <span class="sidebar-label">Keşfet</span>
            <a href="/Song/SongList" class="nav-item"><i class="bi bi-house"></i> Ana Sayfa</a>
            <a href="/Artist/ArtistList" class="nav-item"><i class="bi bi-people"></i> Sanatçılar</a>
            <a href="/Song/SongList" class="nav-item"><i class="bi bi-music-note-list"></i> Şarkılar</a>
            <a href="/Recommendation/Index" class="nav-item"><i class="bi bi-stars"></i> Önerilenler</a>
        </nav>
        <div class="sidebar-divider"></div>
        <nav class="sidebar-section">
            <span class="sidebar-label">Kitaplık</span>
            <a href="/LikedSongs/Index" class="nav-item"><i class="bi bi-heart"></i> Beğendiklerim</a>
            <a href="/Playlist/Index" class="nav-item"><i class="bi bi-collection-play"></i> Çalma Listeleri</a>
            <a href="/History/Index" class="nav-item"><i class="bi bi-clock-history"></i> Dinleme Geçmişi</a>
        </nav>
        <div class="sidebar-divider"></div>
        <nav class="sidebar-section">
            <a href="/Settings/Index" class="nav-item"><i class="bi bi-gear"></i> Ayarlar</a>
            <a href="/Login/Logout" class="nav-item" onclick="return confirm('Çıkış yapmak istediğinize emin misiniz?');">
                <i class="bi bi-box-arrow-right"></i> Çıkış Yap
            </a>
        </nav>
    </aside>

    <!-- MAIN -->
    <main class="main">
        <div class="topbar">
            <span class="topbar-breadcrumb">Sanatçılar</span>
            <div class="topbar-right">
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input class="search-input" type="text" id="searchInput" placeholder="Sanatçı ara..." autocomplete="off">
                </div>
                <button class="topbar-icon-btn" title="Bildirimler"><i class="bi bi-bell"></i></button>
            </div>
        </div>

        <div class="content">
            <div class="page-header">
                <h1>Popüler Sanatçılar</h1>
                <p>
                    @if (Model != null)
                    {
                        @($"{Model.Count} sanatçı listeleniyor")
                    }
                    else
                    {
                        @("Sanatçılar yükleniyor...")
                    }
                </p>
            </div>

            <div class="filters-row" id="filters">
                <button class="chip active" data-filter="all">Tümü</button>
                <button class="chip" data-filter="pop">Pop</button>
                <button class="chip" data-filter="r&b">R&amp;B</button>
                <button class="chip" data-filter="rock">Rock</button>
                <button class="chip" data-filter="hip-hop">Hip-Hop</button>
                <button class="chip" data-filter="electronic">Elektronik</button>
                <button class="chip" data-filter="alternative">Alternatif</button>
            </div>

            <div class="artist-grid" id="artistGrid">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var rawBio = item.Bio ?? "";
                        var cleanGenre = rawBio.ToString().ToLower()
                        .Replace(" ", "").Replace("-", "").Replace("&", "")
                        .Replace("ı", "i").Replace("ğ", "g").Replace("ü", "u")
                        .Replace("ş", "s").Replace("ö", "o").Replace("ç", "c");

                        <div class="artist-card" data-genre="@cleanGenre" data-name="@item.Name" id="card-@item.ArtistId">
                            <div class="card-img-wrap">
                                <img src="@item.ImageUrl" alt="@item.Name" class="card-img"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                <div class="img-fallback" style="display:none;">🎵</div>

                                <!-- Loading spinner (görünür olur API çağrısı sırasında) -->
                                <div class="card-loading-overlay" id="loading-@item.ArtistId">
                                    <div class="spinner"></div>
                                </div>

                                <div class="card-overlay">
                                    <!-- Takip Et butonu (overlay ikon) -->
                                    <button class="overlay-btn" title="Takip Et"
                                            onclick="toggleFollow(this, @item.ArtistId); event.preventDefault(); event.stopPropagation();"
                                            data-following="@(((List<int>)(ViewBag.FollowedArtistIds ?? new List<int>())).Contains(item.ArtistId) ? "true" : "false")">
                                        <i class="bi @(((List<int>)(ViewBag.FollowedArtistIds ?? new List<int>())).Contains(item.ArtistId) ? "bi-person-check-fill" : "bi-person-plus")"></i>
                                    </button>

                                    <!-- ▶ Rastgele şarkı oynat — artık sayfa değişmiyor -->
                                    <button class="overlay-btn overlay-btn-play"
                                            title="Rastgele Çal"
                                            onclick="playRandomSong(@item.ArtistId, '@Html.Raw(item.Name.Replace("'", "\\'"))', '@item.ImageUrl', this); event.stopPropagation();">
                                        <i class="bi bi-play-fill"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="card-body">
                                <a href="/Artist/ArtistDetail/@item.ArtistId">
                                    <div class="card-name">@item.Name</div>
                                </a>
                                <div class="card-genre">@item.Bio</div>
                                <div class="card-meta">
                                    <span class="card-listeners">
                                        <i class="bi bi-person-fill"></i>
                                        @item.MonthlyListeners.ToString("N0") M
                                    </span>
                                    <!-- Kart altı Takip Et butonu — başlangıç durumu DB'den geliyor -->
                                    @{
                                        var isFollowed = ((List<int>)(ViewBag.FollowedArtistIds ?? new List<int>())).Contains(item.ArtistId);
                                    }
                                    <button class="btn-follow @(isFollowed ? "following" : "")"
                                            onclick="toggleFollowBtn(this, @item.ArtistId)">
                                        @(isFollowed ? "✓ Takip Ediliyor" : "Takip Et")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="no-results" style="display:flex;">
                        <i class="bi bi-exclamation-circle"></i>
                        <strong>Sanatçı bulunamadı</strong>
                        <p>Veritabanından sanatçı verisi yüklenemedi.</p>
                    </div>
                }

                <div id="noResults" class="no-results">
                    <i class="bi bi-music-note-beamed"></i>
                    <strong>Sonuç yok</strong>
                    <p>Bu arama veya filtre için sanatçı bulunamadı.</p>
                </div>
            </div>
        </div>
    </main>

    <!-- PLAYER -->
    <div class="player" id="player">
        <div class="player-track">
            <div class="player-cover" id="playerCover">🎵</div>
            <div class="player-info">
                <div class="player-song" id="playerSong">Bir şarkı seçin</div>
                <div class="player-artist" id="playerArtist">—</div>
            </div>
            <button class="player-like-btn" id="heartBtn" onclick="toggleHeart(this)" title="Beğen">
                <i class="bi bi-heart"></i>
            </button>
            <div class="waveform paused" id="waveform">
                <span></span><span></span><span></span><span></span><span></span>
            </div>
        </div>

        <div class="player-center">
            <div class="player-controls">
                <button class="ctrl-btn" title="Karıştır"><i class="bi bi-shuffle"></i></button>
                <button class="ctrl-btn" title="Önceki" onclick="prevTrack()"><i class="bi bi-skip-start-fill"></i></button>
                <button class="ctrl-btn ctrl-btn-play" id="playBtn" onclick="togglePlay()" title="Oynat / Durdur">
                    <i class="bi bi-play-fill" id="playIcon"></i>
                </button>
                <button class="ctrl-btn" title="Sonraki" onclick="nextTrack()"><i class="bi bi-skip-end-fill"></i></button>
                <button class="ctrl-btn" title="Tekrarla"><i class="bi bi-repeat"></i></button>
            </div>
            <div class="player-progress">
                <span class="time-lbl" id="currentTime">0:00</span>
                <div class="progress-track" id="progressBar" onclick="seekTo(event)">
                    <div class="progress-fill" id="progressFill"></div>
                </div>
                <span class="time-lbl" id="totalTime">0:00</span>
            </div>
        </div>

        <div class="player-right">
            <button class="ctrl-btn" title="Sıra"><i class="bi bi-collection"></i></button>
            <button class="ctrl-btn" title="Cihazlar"><i class="bi bi-tv"></i></button>
            <div class="vol-wrap">
                <button class="vol-btn" onclick="toggleMute()" id="volBtn" title="Ses">
                    <i class="bi bi-volume-up-fill" id="volIcon"></i>
                </button>
                <div class="vol-track" id="volTrack" onclick="setVolume(event)">
                    <div class="vol-fill" id="volFill"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gizli YouTube container -->
    <div id="ytPlayer" style="display:none; position:absolute; pointer-events:none;"></div>

    <!-- SCRIPTS -->
    <script>
        /* ══════════════════════════════════════════
           YouTube IFrame API
        ══════════════════════════════════════════ */
        var tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        document.head.appendChild(tag);

        let ytPlayer;
        let ytReady = false;
        let pendingVideoId = null;  // API hazır olmadan önce gelen istek
        let volumeVal = 70;
        let isMuted = false;
        let progressInterval;

        function onYouTubeIframeAPIReady() {
            ytPlayer = new YT.Player('ytPlayer', {
                height: '0', width: '0',
                playerVars: { controls: 0, disablekb: 1, rel: 0 },
                events: {
                    onReady: function() {
                        ytReady = true;
                        ytPlayer.setVolume(volumeVal);
                        document.getElementById('volFill').style.width = volumeVal + '%';
                        // Eğer play butonu API hazır olmadan basıldıysa şimdi çal
                        if (pendingVideoId) {
                            ytPlayer.loadVideoById(pendingVideoId);
                            pendingVideoId = null;
                        }
                    },
                    onStateChange: function(e) {
                        if (e.data === YT.PlayerState.PLAYING) {
                            document.getElementById('playIcon').className = 'bi bi-pause-fill';
                            document.getElementById('waveform').classList.remove('paused');
                            startProgressLoop();
                        } else if (e.data === YT.PlayerState.PAUSED || e.data === YT.PlayerState.BUFFERING) {
                            document.getElementById('playIcon').className = 'bi bi-play-fill';
                            document.getElementById('waveform').classList.add('paused');
                        } else if (e.data === YT.PlayerState.ENDED) {
                            document.getElementById('playIcon').className = 'bi bi-play-fill';
                            document.getElementById('waveform').classList.add('paused');
                            clearInterval(progressInterval);
                        }
                    },
                    onError: function(e) { console.error('YouTube hatası:', e.data); }
                }
            });
        }

        /* ══════════════════════════════════════════
           Controller'dan gelen şarkı listesi
           (fetch() yapmaya gerek yok, sayfa yüklenirken hazır)
        ══════════════════════════════════════════ */
        const ALL_SONGS = @Html.Raw(ViewBag.SongsJson ?? "[]");

        /* ══════════════════════════════════════════
           ANA FONKSİYON: Rastgele şarkı oynat
           artistId    → sanatçı ID'si
           artistName  → player'da gösterilecek isim
           artistImg   → player cover resmi
           btn         → tıklanan play butonu (spinner için)
        ══════════════════════════════════════════ */
        function playRandomSong(artistId, artistName, artistImg, btn) {
            // Spinner aç
            const loadingEl = document.getElementById('loading-' + artistId);
            if (loadingEl) loadingEl.classList.add('active');

            try {
                // Bu sanatçıya ait şarkıları filtrele (ArtistId — controller ile aynı alan adı)
                const artistSongs = ALL_SONGS.filter(s => s.ArtistId == artistId);

                if (!artistSongs || artistSongs.length === 0) {
                    alert(artistName + ' için şarkı bulunamadı.');
                    return;
                }

                // Rastgele birini seç
                const song = artistSongs[Math.floor(Math.random() * artistSongs.length)];

                // YouTube ID'yi çıkar
                const videoId = getYoutubeId(song.AudioUrl ?? song.audioUrl ?? '');
                if (!videoId) {
                    console.error('Geçersiz YouTube URL:', song.AudioUrl ?? song.audioUrl);
                    return;
                }

                // Player bilgilerini güncelle
                document.getElementById('playerSong').textContent   = song.Title ?? song.title ?? '—';
                document.getElementById('playerArtist').textContent = artistName;

                // Cover resmi güncelle
                const cover = document.getElementById('playerCover');
                if (artistImg) {
                    cover.innerHTML = `<img src="${artistImg}" alt="${artistName}" onerror="this.parentElement.textContent='🎵'">`;
                }

                // Oynat
                if (ytReady && ytPlayer && ytPlayer.loadVideoById) {
                    ytPlayer.loadVideoById(videoId);
                } else {
                    pendingVideoId = videoId;  // YouTube API henüz hazır değil, beklet
                }

            } catch (err) {
                console.error('Şarkı yüklenirken hata:', err);
            } finally {
                if (loadingEl) loadingEl.classList.remove('active');
            }
        }

        /* ══════════════════════════════════════════
           Player kontrolleri
        ══════════════════════════════════════════ */
        function togglePlay() {
            if (!ytPlayer || !ytPlayer.getPlayerState) return;
            const state = ytPlayer.getPlayerState();
            if (state === YT.PlayerState.PLAYING) {
                ytPlayer.pauseVideo();
            } else {
                ytPlayer.playVideo();
            }
        }

        function prevTrack() {
            if (ytPlayer && ytPlayer.seekTo) ytPlayer.seekTo(0, true);
        }

        function nextTrack() {
            // Bir sonraki şarkı mantığı eklenebilir
        }

        function startProgressLoop() {
            clearInterval(progressInterval);
            progressInterval = setInterval(() => {
                if (!ytPlayer || !ytPlayer.getCurrentTime) return;
                const cur = ytPlayer.getCurrentTime();
                const dur = ytPlayer.getDuration();
                if (dur > 0) {
                    document.getElementById('progressFill').style.width = (cur / dur * 100) + '%';
                    document.getElementById('currentTime').textContent = formatTime(cur);
                    document.getElementById('totalTime').textContent   = formatTime(dur);
                }
            }, 500);
        }

        function seekTo(e) {
            if (!ytPlayer || !ytPlayer.getDuration) return;
            const bar  = document.getElementById('progressBar');
            const rect = bar.getBoundingClientRect();
            const ratio = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
            ytPlayer.seekTo(ratio * ytPlayer.getDuration(), true);
            document.getElementById('progressFill').style.width = (ratio * 100) + '%';
        }

        function setVolume(e) {
            if (!ytPlayer || !ytPlayer.setVolume) return;
            const track = document.getElementById('volTrack');
            const rect  = track.getBoundingClientRect();
            volumeVal = Math.min(100, Math.max(0, ((e.clientX - rect.left) / rect.width) * 100));
            isMuted = false;
            ytPlayer.unMute();
            ytPlayer.setVolume(volumeVal);
            document.getElementById('volFill').style.width = volumeVal + '%';
            updateVolIcon();
        }

        function toggleMute() {
            if (!ytPlayer) return;
            if (ytPlayer.isMuted()) {
                ytPlayer.unMute(); ytPlayer.setVolume(volumeVal);
                document.getElementById('volFill').style.width = volumeVal + '%';
                isMuted = false;
            } else {
                ytPlayer.mute();
                document.getElementById('volFill').style.width = '0%';
                isMuted = true;
            }
            updateVolIcon();
        }

        function updateVolIcon() {
            const icon = document.getElementById('volIcon');
            icon.className = (isMuted || volumeVal === 0) ? 'bi bi-volume-mute-fill' : 'bi bi-volume-up-fill';
        }

        function toggleHeart(btn) {
            btn.classList.toggle('liked');
            btn.querySelector('i').className = btn.classList.contains('liked') ? 'bi bi-heart-fill' : 'bi bi-heart';
        }

        function toggleFollowBtn(btn, artistId) {
            fetch(`https://localhost:7185/api/Follows/toggle/${artistId}`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer @token`,
                    'Content-Type': 'application/json'
                }
            })
            .then(res => res.json())
            .then(data => {
                const following = data.isFollowing;
                btn.classList.toggle('following', following);
                btn.textContent = following ? '✓ Takip Ediliyor' : 'Takip Et';
            })
            .catch(err => console.error('Takip hatası:', err));
        }

        function toggleFollow(btn, artistId) {
            fetch(`https://localhost:7185/api/Follows/toggle/${artistId}`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer @token`,
                    'Content-Type': 'application/json'
                }
            })
            .then(res => res.json())
            .then(data => {
                const following = data.isFollowing;
                btn.setAttribute('data-following', String(following));
                btn.querySelector('i').className = following ? 'bi bi-person-check-fill' : 'bi bi-person-plus';
                btn.title = following ? 'Takip Ediliyor' : 'Takip Et';
            })
            .catch(err => console.error('Takip hatası:', err));
        }

        function formatTime(secs) {
            const m = Math.floor(secs / 60);
            const s = Math.floor(secs % 60);
            return m + ':' + String(s).padStart(2, '0');
        }

        function getYoutubeId(url) {
            if (!url) return null;
            if (url.length === 11 && !url.includes('/') && !url.includes('?')) return url;
            const m = url.match(/^.*(youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/);
            return (m && m[2].length === 11) ? m[2] : null;
        }

        /* ══════════════════════════════════════════
           Arama & Genre filtresi
        ══════════════════════════════════════════ */
        document.addEventListener("DOMContentLoaded", function () {
            const chips       = document.querySelectorAll(".chip");
            const searchInput = document.getElementById("searchInput");
            const noResults   = document.getElementById("noResults");
            if (noResults) noResults.style.display = "none";

            function applyFilters() {
                const activeChip = document.querySelector(".chip.active");
                const selectedFilter = activeChip
                    ? activeChip.getAttribute("data-filter").toLowerCase().replace("-","").replace("&","").replace(" ","").trim()
                    : "all";
                const query = searchInput ? searchInput.value.trim().toLowerCase() : "";
                const cards = document.querySelectorAll(".artist-grid .artist-card");
                let visible = 0;

                cards.forEach(card => {
                    const genre = (card.getAttribute("data-genre") || "").toLowerCase();
                    const name  = (card.getAttribute("data-name") || "").toLowerCase();
                    const genreMatch = selectedFilter === "all" || genre.includes(selectedFilter);
                    const nameMatch  = name.includes(query);
                    if (genreMatch && nameMatch) { card.classList.remove("hide"); visible++; }
                    else card.classList.add("hide");
                });

                if (noResults) noResults.style.display = visible === 0 ? "flex" : "none";
            }

            chips.forEach(chip => {
                chip.addEventListener("click", function () {
                    chips.forEach(c => c.classList.remove("active"));
                    this.classList.add("active");
                    applyFilters();
                });
            });

            if (searchInput) searchInput.addEventListener("input", applyFilters);
        });
    </script>
</body>
</html>
