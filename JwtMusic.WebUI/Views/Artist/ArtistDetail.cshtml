@model JwtMusic.WebUI.Models.ArtistDetailViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Artist.Name — Canlı Müzik</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* ─── TOKENS (same system as ArtistList) ──────────── */
        :root {
            --bg-root: #0c0c0e;
            --bg-sidebar: #111113;
            --bg-main: #0c0c0e;
            --bg-card: #181819;
            --bg-card-hover: #202022;
            --bg-surface: #1c1c1f;
            --bg-input: #1a1a1c;
            --accent: #c9a84c;
            --accent-dim: rgba(201,168,76,0.12);
            --accent-border: rgba(201,168,76,0.28);
            --accent-glow: 0 0 24px rgba(201,168,76,0.18);
            --text-1: #e8e8ea;
            --text-2: #8a8a94;
            --text-3: #46464e;
            --border: rgba(255,255,255,0.055);
            --border-hover: rgba(255,255,255,0.11);
            --sidebar-w: 224px;
            --player-h: 76px;
            --radius-card: 14px;
            --radius-sm: 8px;
            --radius-pill: 100px;
            --transition: 0.22s cubic-bezier(0.4,0,0.2,1);
        }

        /* ─── RESET ──────────────────────────────────────── */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            height: 100%;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-root);
            color: var(--text-1);
            height: 100%;
            overflow: hidden;
            display: grid;
            grid-template-columns: var(--sidebar-w) 1fr;
            grid-template-rows: 1fr var(--player-h);
            grid-template-areas:
                "sidebar main"
                "player  player";
        }

        img {
            display: block;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
            cursor: pointer;
        }

        /* ─── SIDEBAR ─────────────────────────────────────── */
        .sidebar {
            grid-area: sidebar;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            user-select: none;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 22px 20px 20px;
            border-bottom: 1px solid var(--border);
        }

        .logo-mark {
            width: 30px;
            height: 30px;
            background: var(--accent);
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .logo-mark i {
                color: #0c0c0e;
                font-size: 0.95rem;
            }

        .logo-wordmark {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 0.95rem;
            letter-spacing: -0.3px;
            color: var(--text-1);
        }

        .sidebar-section {
            padding: 20px 12px 8px;
        }

        .sidebar-label {
            font-size: 0.65rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-3);
            padding: 0 8px;
            margin-bottom: 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 10px;
            border-radius: var(--radius-sm);
            color: var(--text-2);
            font-size: 0.855rem;
            font-weight: 500;
            cursor: pointer;
            transition: background var(--transition), color var(--transition);
            position: relative;
            text-decoration: none;
        }

            .nav-item i {
                font-size: 1rem;
                width: 18px;
                flex-shrink: 0;
                text-align: center;
            }

            .nav-item:hover {
                background: rgba(255,255,255,0.04);
                color: var(--text-1);
            }

            .nav-item.active {
                color: var(--text-1);
                background: rgba(255,255,255,0.05);
            }

                .nav-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 20%;
                    bottom: 20%;
                    width: 2.5px;
                    border-radius: 2px;
                    background: var(--accent);
                }

        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 8px 12px;
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 16px 12px;
            border-top: 1px solid var(--border);
        }

        .user-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: background var(--transition);
        }

            .user-row:hover {
                background: rgba(255,255,255,0.04);
            }

        .user-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--bg-surface);
            border: 1.5px solid var(--border-hover);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--accent);
            flex-shrink: 0;
        }

        .user-info {
            min-width: 0;
        }

        .user-name {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-plan {
            font-size: 0.65rem;
            color: var(--accent);
            font-weight: 500;
        }

        /* ─── MAIN ───────────────────────────────────────── */
        .main {
            grid-area: main;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            background: var(--bg-main);
            scrollbar-width: thin;
            scrollbar-color: var(--bg-surface) transparent;
        }

            .main::-webkit-scrollbar {
                width: 5px;
            }

            .main::-webkit-scrollbar-track {
                background: transparent;
            }

            .main::-webkit-scrollbar-thumb {
                background: var(--bg-surface);
                border-radius: 4px;
            }

        /* ─── TOPBAR ─────────────────────────────────────── */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 28px;
            background: rgba(12,12,14,0.88);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--border);
            gap: 16px;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .back-btn {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--bg-surface);
            border: 1px solid var(--border);
            color: var(--text-2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            text-decoration: none;
            transition: background var(--transition), color var(--transition);
        }

            .back-btn:hover {
                background: var(--bg-card-hover);
                color: var(--text-1);
            }

        .topbar-breadcrumb {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 700;
            font-size: 1rem;
            color: var(--text-1);
            letter-spacing: -0.3px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .search-field {
            position: relative;
            display: flex;
            align-items: center;
        }

            .search-field i {
                position: absolute;
                left: 12px;
                color: var(--text-3);
                font-size: 0.8rem;
                pointer-events: none;
            }

        .search-input {
            background: var(--bg-input);
            border: 1px solid var(--border);
            color: var(--text-1);
            border-radius: var(--radius-pill);
            padding: 7px 14px 7px 32px;
            font-size: 0.8rem;
            font-family: 'Inter', sans-serif;
            width: 210px;
            outline: none;
            transition: border-color var(--transition), box-shadow var(--transition), width var(--transition);
        }

            .search-input::placeholder {
                color: var(--text-3);
            }

            .search-input:focus {
                border-color: var(--accent-border);
                box-shadow: 0 0 0 3px rgba(201,168,76,0.08);
                width: 260px;
            }

        /* ─── ARTIST HERO ────────────────────────────────── */
        .artist-hero {
            position: relative;
            min-height: 280px;
            display: flex;
            align-items: flex-end;
            overflow: hidden;
        }

        /* Blurred background from artist image */
        .hero-bg-blur {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center top;
            filter: blur(28px) brightness(0.28) saturate(0.6);
            transform: scale(1.08);
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient( to bottom, rgba(12,12,14,0.15) 0%, rgba(12,12,14,0.6) 60%, rgba(12,12,14,1) 100% );
        }

        .hero-content {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: flex-end;
            gap: 28px;
            padding: 32px 28px 28px;
            width: 100%;
        }

        .artist-photo {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(255,255,255,0.08);
            box-shadow: 0 12px 40px rgba(0,0,0,0.7), var(--accent-glow);
            flex-shrink: 0;
            transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
        }

            .artist-photo:hover {
                transform: scale(1.04);
            }

        .artist-photo-fallback {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            background: var(--bg-surface);
            border: 3px solid rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            flex-shrink: 0;
        }

        .hero-info {
            min-width: 0;
            padding-bottom: 4px;
        }

        .hero-verified {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--accent);
            margin-bottom: 8px;
        }

        .hero-name {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: clamp(2rem, 4.5vw, 3.5rem);
            font-weight: 800;
            letter-spacing: -1.5px;
            line-height: 1.05;
            color: var(--text-1);
            margin-bottom: 14px;
        }

        .hero-stats {
            display: flex;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .hero-stat {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.82rem;
            color: var(--text-2);
        }

            .hero-stat i {
                color: var(--accent);
                font-size: 0.75rem;
            }

            .hero-stat strong {
                color: var(--text-1);
                font-weight: 600;
            }

        /* ─── CONTENT AREA ───────────────────────────────── */
        .content {
            padding: 24px 28px 40px;
            flex: 1;
        }

        /* ─── ACTION BAR ─────────────────────────────────── */
        .action-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 28px;
            flex-wrap: wrap;
        }

        .btn-play-all {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--accent);
            color: #0c0c0e;
            border: none;
            border-radius: var(--radius-pill);
            padding: 10px 22px;
            font-size: 0.85rem;
            font-weight: 700;
            font-family: 'Plus Jakarta Sans', sans-serif;
            letter-spacing: -0.2px;
            cursor: pointer;
            transition: background var(--transition), transform 0.15s;
            box-shadow: var(--accent-glow);
        }

            .btn-play-all:hover {
                background: #d4b360;
                transform: scale(1.02);
            }

        .btn-follow {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: transparent;
            border: 1px solid var(--accent-border);
            color: var(--accent);
            border-radius: var(--radius-pill);
            padding: 10px 20px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all var(--transition);
            letter-spacing: 0.01em;
        }

            .btn-follow:hover, .btn-follow.following {
                background: var(--accent-dim);
            }

            .btn-follow.following {
                background: var(--accent);
                border-color: var(--accent);
                color: #0c0c0e;
            }

        .btn-more {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            cursor: pointer;
            transition: background var(--transition), border-color var(--transition), color var(--transition);
        }

            .btn-more:hover {
                background: var(--bg-surface);
                border-color: var(--border-hover);
                color: var(--text-1);
            }

        /* ─── SECTION HEADER ─────────────────────────────── */
        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }

        .section-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-1);
            letter-spacing: -0.2px;
        }

        .section-count {
            font-size: 0.75rem;
            color: var(--text-3);
        }

        /* ─── TRACK LIST ─────────────────────────────────── */
        .track-list {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .track-row {
            display: grid;
            grid-template-columns: 40px 1fr auto auto;
            align-items: center;
            gap: 12px;
            padding: 8px 12px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: background var(--transition);
            position: relative;
        }

            .track-row:hover {
                background: var(--bg-surface);
            }

            .track-row.playing-now {
                background: var(--accent-dim);
            }

                .track-row.playing-now .track-num {
                    color: var(--accent);
                }

        .track-num {
            font-size: 0.82rem;
            color: var(--text-3);
            text-align: center;
            font-variant-numeric: tabular-nums;
            transition: color var(--transition);
        }

        /* On hover replace number with play icon */
        .track-row:not(.playing-now):hover .track-num-val {
            display: none;
        }

        .track-row .track-play-icon {
            display: none;
            color: var(--text-2);
            font-size: 0.85rem;
        }

        .track-row:not(.playing-now):hover .track-play-icon {
            display: block;
        }

        /* Playing-now animated bars */
        .track-row.playing-now .track-num-val {
            display: none;
        }

        .track-row.playing-now .track-bars {
            display: flex !important;
        }

        .track-bars {
            display: none;
            align-items: flex-end;
            gap: 2px;
            height: 13px;
            justify-content: center;
        }

            .track-bars span {
                display: block;
                width: 2.5px;
                border-radius: 2px;
                background: var(--accent);
                animation: tb 0.9s ease-in-out infinite;
            }

                .track-bars span:nth-child(1) {
                    height: 6px;
                    animation-delay: 0s;
                }

                .track-bars span:nth-child(2) {
                    height: 11px;
                    animation-delay: 0.15s;
                }

                .track-bars span:nth-child(3) {
                    height: 8px;
                    animation-delay: 0.05s;
                }

        @@keyframes tb {
            0%, 100% {
                transform: scaleY(1);
            }

            50% {
                transform: scaleY(0.35);
            }
        }

        .track-info {
            min-width: 0;
        }

        .track-title {
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .track-row.playing-now .track-title {
            color: var(--accent);
        }

        .track-label {
            font-size: 0.7rem;
            color: var(--text-3);
            margin-top: 1px;
        }

        .track-duration {
            font-size: 0.78rem;
            color: var(--text-3);
            font-variant-numeric: tabular-nums;
            text-align: right;
        }

        .track-like-btn {
            background: none;
            border: none;
            color: var(--text-3);
            font-size: 0.85rem;
            cursor: pointer;
            padding: 4px;
            opacity: 0;
            transition: opacity var(--transition), color var(--transition);
        }

            .track-row:hover .track-like-btn,
            .track-like-btn.liked {
                opacity: 1;
            }

            .track-like-btn.liked {
                color: var(--accent);
            }

        /* ─── EMPTY STATE ────────────────────────────────── */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 4rem 2rem;
            border: 1px dashed var(--border);
            border-radius: var(--radius-card);
            color: var(--text-3);
        }

            .empty-state i {
                font-size: 2rem;
                margin-bottom: 12px;
                display: block;
            }

            .empty-state p {
                font-size: 0.85rem;
                color: var(--text-2);
            }

        /* ─── PLAYER ─────────────────────────────────────── */
        .player {
            grid-area: player;
            background: #111113;
            border-top: 1px solid var(--border);
            display: grid;
            grid-template-columns: 280px 1fr 280px;
            align-items: center;
            padding: 0 20px;
            gap: 12px;
            z-index: 100;
        }

        .player-track {
            display: flex;
            align-items: center;
            gap: 11px;
            min-width: 0;
        }

        .player-cover {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-sm);
            background: var(--bg-surface);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
            overflow: hidden;
        }

            .player-cover img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .player-info {
            min-width: 0;
            flex: 1;
        }

        .player-song {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .player-artist {
            font-size: 0.72rem;
            color: var(--text-2);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 1px;
        }

        .player-like-btn {
            background: none;
            border: none;
            color: var(--text-3);
            font-size: 0.9rem;
            cursor: pointer;
            padding: 5px;
            transition: color var(--transition);
            flex-shrink: 0;
        }

            .player-like-btn:hover, .player-like-btn.liked {
                color: var(--accent);
            }

        /* Waveform */
        .waveform {
            display: flex;
            align-items: center;
            gap: 2px;
            height: 14px;
        }

            .waveform span {
                display: block;
                width: 2.5px;
                border-radius: 2px;
                background: var(--accent);
                animation: wv 1.1s ease-in-out infinite;
            }

                .waveform span:nth-child(1) {
                    height: 5px;
                    animation-delay: 0s;
                }

                .waveform span:nth-child(2) {
                    height: 12px;
                    animation-delay: 0.1s;
                }

                .waveform span:nth-child(3) {
                    height: 8px;
                    animation-delay: 0.2s;
                }

                .waveform span:nth-child(4) {
                    height: 14px;
                    animation-delay: 0.3s;
                }

                .waveform span:nth-child(5) {
                    height: 6px;
                    animation-delay: 0.4s;
                }

        @@keyframes wv {
            0%, 100% {
                transform: scaleY(1);
            }

            50% {
                transform: scaleY(0.3);
            }
        }

        .waveform.paused span {
            animation-play-state: paused;
        }

        .player-center {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 7px;
        }

        .player-controls {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .ctrl-btn {
            background: none;
            border: none;
            color: var(--text-2);
            font-size: 0.9rem;
            cursor: pointer;
            padding: 0;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color var(--transition), background var(--transition);
        }

            .ctrl-btn:hover {
                color: var(--text-1);
                background: rgba(255,255,255,0.05);
            }

        .ctrl-btn-play {
            width: 38px;
            height: 38px;
            background: var(--text-1);
            color: var(--bg-root);
            font-size: 1rem;
            border-radius: 50%;
            transition: transform 0.15s, background var(--transition);
        }

            .ctrl-btn-play:hover {
                background: #fff;
                transform: scale(1.05);
            }

        .player-progress {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            max-width: 440px;
        }

        .time-lbl {
            font-size: 0.65rem;
            color: var(--text-3);
            min-width: 34px;
            text-align: center;
            font-variant-numeric: tabular-nums;
        }

        .progress-track {
            flex: 1;
            height: 3px;
            background: rgba(255,255,255,0.08);
            border-radius: 3px;
            cursor: pointer;
            position: relative;
        }

            .progress-track:hover {
                height: 4px;
            }

        .progress-fill {
            height: 100%;
            border-radius: 3px;
            background: var(--text-1);
            width: 0%;
            position: relative;
            transition: width 0.2s linear;
        }

        .progress-track:hover .progress-fill {
            background: var(--accent);
        }

        .progress-fill::after {
            content: '';
            position: absolute;
            right: -4px;
            top: 50%;
            transform: translateY(-50%) scale(0);
            width: 9px;
            height: 9px;
            background: #fff;
            border-radius: 50%;
            transition: transform 0.15s;
        }

        .progress-track:hover .progress-fill::after {
            transform: translateY(-50%) scale(1);
        }

        .player-right {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
        }

            .player-right .ctrl-btn {
                font-size: 0.85rem;
            }

        .vol-wrap {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .vol-btn {
            background: none;
            border: none;
            color: var(--text-2);
            font-size: 0.9rem;
            cursor: pointer;
            padding: 4px;
            transition: color var(--transition);
        }

            .vol-btn:hover {
                color: var(--text-1);
            }

        .vol-track {
            width: 78px;
            height: 3px;
            background: rgba(255,255,255,0.08);
            border-radius: 3px;
            cursor: pointer;
        }

        .vol-fill {
            height: 100%;
            border-radius: 3px;
            background: rgba(255,255,255,0.3);
            width: 70%;
            transition: background var(--transition);
        }

        .vol-track:hover .vol-fill {
            background: var(--text-1);
        }

        /* ─── RESPONSIVE ─────────────────────────────────── */
        @@media (max-width: 900px) {
            body {
                grid-template-columns: 1fr;
                grid-template-rows: 52px 1fr var(--player-h);
                grid-template-areas:
                    "sidebar"
                    "main"
                    "player";
                overflow: hidden;
            }

            .sidebar {
                flex-direction: row;
                border-right: none;
                border-bottom: 1px solid var(--border);
                overflow-x: auto;
                overflow-y: hidden;
            }

            .sidebar-logo {
                padding: 12px 16px;
                border-bottom: none;
                border-right: 1px solid var(--border);
            }

            .sidebar-section {
                display: flex;
                flex-direction: row;
                padding: 8px;
                gap: 2px;
                align-items: center;
            }

            .sidebar-label, .sidebar-divider, .sidebar-footer {
                display: none;
            }

            .nav-item.active::before {
                top: auto;
                left: 20%;
                right: 20%;
                bottom: 0;
                height: 2px;
                width: auto;
            }

            .player {
                grid-template-columns: 1fr auto;
            }

            .player-right {
                display: none;
            }

            .artist-photo, .artist-photo-fallback {
                width: 110px;
                height: 110px;
            }

            .hero-content {
                padding: 20px 16px 20px;
                gap: 16px;
            }
        }

        @@media (max-width: 600px) {
            .content {
                padding: 16px 14px 28px;
            }

            .topbar {
                padding: 10px 14px;
            }

            .hero-name {
                letter-spacing: -0.8px;
            }

            .track-row {
                grid-template-columns: 36px 1fr auto;
            }

            .track-duration {
                display: none;
            }

            .search-input {
                width: 140px;
            }

                .search-input:focus {
                    width: 160px;
                }
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-mark"><i class="bi bi-soundwave"></i></div>
            <span class="logo-wordmark">Canlı Müzik</span>
        </div>

        <nav class="sidebar-section">
            <span class="sidebar-label">Keşfet</span>
            <a href="/Artist/ArtistList" class="nav-item"><i class="bi bi-people"></i> Sanatçılar</a>
            <a href="/Song/SongList/" class="nav-item"><i class="bi bi-music-note-list"></i> Şarkılar</a>
        </nav>

        <div class="sidebar-divider"></div>

        <nav class="sidebar-section">
            <span class="sidebar-label">Kitaplık</span>
            <a href="#" class="nav-item"><i class="bi bi-heart"></i> Beğendiklerim</a>
            <a href="#" class="nav-item"><i class="bi bi-collection-play"></i> Çalma Listeleri</a>
            <a href="#" class="nav-item"><i class="bi bi-clock-history"></i> Son Dinlenenler</a>
        </nav>

        <div class="sidebar-footer">
            <div class="user-row">
                <div class="user-avatar">K</div>
                <div class="user-info">
                    <div class="user-name">Kullanıcı</div>
                    <div class="user-plan">Ücretsiz Plan</div>
                </div>
            </div>
        </div>
    </aside>

    <main class="main">

        <div class="topbar">
            <div class="topbar-left">
                <a href="/Artist/ArtistList" class="back-btn" title="Geri">
                    <i class="bi bi-chevron-left"></i>
                </a>
                <span class="topbar-breadcrumb">@Model.Artist.Name</span>
            </div>
            <div class="topbar-right">
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input class="search-input"
                           type="text"
                           id="songSearchInput"
                           oninput="filterSongs()"
                           placeholder="Şarkılarda ara..."
                           autocomplete="off">
                </div>
            </div>
        </div>

        <div class="artist-hero">
            <div class="hero-bg-blur" style="background-image: url('@Model.Artist.ImageUrl');"></div>
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <img src="@Model.Artist.ImageUrl"
                     alt="@Model.Artist.Name"
                     class="artist-photo"
                     onerror="this.style.display='none'; document.getElementById('photoFallback').style.display='flex';">
                <div class="artist-photo-fallback" id="photoFallback" style="display:none;">🎵</div>

                <div class="hero-info">
                    <div class="hero-verified">
                        <i class="bi bi-patch-check-fill"></i> Doğrulanmış Sanatçı
                    </div>
                    <h1 class="hero-name">@Model.Artist.Name</h1>
                    <div class="hero-stats">
                        <div class="hero-stat">
                            <i class="bi bi-person-fill"></i>
                            <span><strong>@Model.Artist.MonthlyListeners.ToString("N0")</strong> aylık dinleyici</span>
                        </div>
                        <div class="hero-stat">
                            <i class="bi bi-music-note-list"></i>
                            <span><strong>@(Model.Songs != null ? Model.Songs.Count : 0)</strong> parça</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Artist.Bio))
                        {
                            <div class="hero-stat">
                                <i class="bi bi-tag"></i>
                                <span>@Model.Artist.Bio</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="content">

            <div class="action-bar">
                <button class="btn-play-all" onclick="playAll()">
                    <i class="bi bi-play-fill"></i> Tümünü Oynat
                </button>
                <button class="btn-follow" id="followBtn" onclick="toggleFollowBtn(this, '@Model.Artist.ArtistId')">
                    <i class="bi bi-person-plus"></i> Takip Et
                </button>
                <button class="btn-more" title="Daha fazla"><i class="bi bi-three-dots"></i></button>
            </div>

            <div class="section-header">
                <span class="section-title">Popüler Şarkılar</span>
                <span class="section-count">
                    @(Model.Songs != null ? Model.Songs.Count : 0) şarkı
                </span>
            </div>

            <div class="track-list" id="trackListContainer">
                @if (Model.Songs != null && Model.Songs.Any())
                {
                    int index = 0;
                    foreach (var song in Model.Songs)
                    {
                        <div class="track-row"
                             id="track-@index"
                             data-title="@song.Title.ToLower()"
                             onclick="playTrackAtIndex(@index)">
                            <div class="track-num">
                                <span class="track-num-val">@(index + 1)</span>
                                <i class="bi bi-play-fill track-play-icon"></i>
                                <div class="track-bars">
                                    <span></span><span></span><span></span>
                                </div>
                            </div>

                            <div class="track-info">
                                <div class="track-title">@song.Title</div>
                                <div class="track-label">Şarkı</div>
                            </div>

                            <div class="track-duration">@song.Duration.ToString(@"mm\:ss")</div>

                            <button class="track-like-btn"
                                    onclick="toggleLike(event, this)"
                                    title="Beğen">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>
                        index++;
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-music-note"></i>
                        <p>Bu sanatçıya ait şarkı bulunamadı.</p>
                    </div>
                }
            </div>
        </div>
    </main>

    <div class="player" id="player">

        <div class="player-track">
            <div class="player-cover" id="playerCover">🎵</div>
            <div class="player-info">
                <div class="player-song" id="pTitle">
                    @(Model.Songs != null && Model.Songs.Any() ? Model.Songs.First().Title : "Oynatılmıyor")
                </div>
                <div class="player-artist" id="pArtist">@Model.Artist.Name</div>
            </div>
            <button class="player-like-btn"
                    id="heartBtn"
                    onclick="toggleHeart(this)"
                    title="Beğen">
                <i class="bi bi-heart"></i>
            </button>
            <div class="waveform paused" id="waveform">
                <span></span><span></span><span></span><span></span><span></span>
            </div>
        </div>

        <div class="player-center">
            <div class="player-controls">
                <button class="ctrl-btn" title="Karıştır"><i class="bi bi-shuffle"></i></button>
                <button class="ctrl-btn" title="Önceki" onclick="playPrevious()"><i class="bi bi-skip-start-fill"></i></button>
                <button class="ctrl-btn ctrl-btn-play" id="playBtn" onclick="togglePlay()" title="Oynat / Durdur">
                    <i class="bi bi-play-fill" id="playIcon"></i>
                </button>
                <button class="ctrl-btn" title="Sonraki" onclick="playNext()"><i class="bi bi-skip-end-fill"></i></button>
                <button class="ctrl-btn" title="Tekrarla"><i class="bi bi-repeat"></i></button>
            </div>
            <div class="player-progress">
                <span class="time-lbl" id="currentTime">00:00</span>
                <div class="progress-track" id="progressBar" onclick="seek(event)">
                    <div class="progress-fill" id="progressFill"></div>
                </div>
                <span class="time-lbl" id="totalTime">00:00</span>
            </div>
        </div>

        <div class="player-right">
            <button class="ctrl-btn" title="Sıra"><i class="bi bi-collection"></i></button>
            <div class="vol-wrap">
                <button class="vol-btn" onclick="toggleMute()" id="volBtn" title="Ses">
                    <i class="bi bi-volume-up-fill" id="volIcon"></i>
                </button>
                <div class="vol-track" id="volTrack" onclick="setVolume(event)">
                    <div class="vol-fill" id="volFill"></div>
                </div>
            </div>
        </div>
    </div>

    <div id="ytPlayer" style="display:none; position:absolute; pointer-events:none;"></div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        /* ── Track data from Razor ── */
        const tracks = [];
        @if (Model.Songs != null)
        {
                foreach (var song in Model.Songs)
                {
                        <text>
                        tracks.push({
                            audioUrl: '@song.AudioUrl',
                            title:    '@Html.Raw(song.Title.Replace("'", "\\'"))',
                            artist:   '@Html.Raw(Model.Artist.Name.Replace("'", "\\'"))'
                        });
                        </text>
                }
        }

        /* ── YouTube IFrame API ── */
        var tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        document.getElementsByTagName('script')[0].parentNode.insertBefore(tag, document.getElementsByTagName('script')[0]);

        let ytPlayer;
        let progressInterval;
        let currentTrackIndex = -1;
        let lastVolume = 80;
        let isMuted = false;

        function onYouTubeIframeAPIReady() {
            ytPlayer = new YT.Player('ytPlayer', {
                height: '0',
                width:  '0',
                playerVars: { controls: 0, disablekb: 1, rel: 0 },
                events: {
                    onReady:       onPlayerReady,
                    onStateChange: onPlayerStateChange,
                    onError:       onPlayerError
                }
            });
        }

        function onPlayerReady() {
            ytPlayer.setVolume(lastVolume);
            document.getElementById('volFill').style.width = lastVolume + '%';
            checkInitialFollowState();
        }

        function onPlayerStateChange(event) {
            if (event.data === YT.PlayerState.PLAYING) {
                document.getElementById('playIcon').className = 'bi bi-pause-fill';
                document.getElementById('waveform').classList.remove('paused');
                startProgressLoop();
            } else if (event.data === YT.PlayerState.PAUSED || event.data === YT.PlayerState.BUFFERING) {
                document.getElementById('playIcon').className = 'bi bi-play-fill';
                document.getElementById('waveform').classList.add('paused');
            } else if (event.data === YT.PlayerState.ENDED) {
                playNext();
            }
        }

        function onPlayerError(event) {
            console.error("YouTube Hatası:", event.data);
        }

        /* ── Playback ── */
        function getYoutubeId(url) {
            if (!url) return null;
            if (url.length === 11 && !url.includes('/') && !url.includes('?')) return url;
            const m = url.match(/^.*(youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/);
            return (m && m[2].length === 11) ? m[2] : null;
        }

        function playTrackAtIndex(index) {
            if (index < 0 || index >= tracks.length) return;

            if (currentTrackIndex !== -1) {
                const old = document.getElementById('track-' + currentTrackIndex);
                if (old) old.classList.remove('playing-now');
            }

            currentTrackIndex = index;
            const track = tracks[index];
            const videoId = getYoutubeId(track.audioUrl);

            if (!videoId) { console.error("Geçersiz YouTube URL:", track.audioUrl); return; }

            const row = document.getElementById('track-' + index);
            if (row) row.classList.add('playing-now');

            document.getElementById('pTitle').textContent  = track.title;
            document.getElementById('pArtist').textContent = track.artist;

            if (ytPlayer && ytPlayer.loadVideoById) {
                ytPlayer.loadVideoById(videoId);
            }
        }

        function playAll() {
            if (tracks.length > 0) playTrackAtIndex(0);
        }

        function playNext() {
            if (tracks.length === 0) return;
            const next = (currentTrackIndex + 1) < tracks.length ? currentTrackIndex + 1 : 0;
            playTrackAtIndex(next);
        }

        function playPrevious() {
            if (tracks.length === 0) return;
            const prev = (currentTrackIndex - 1) >= 0 ? currentTrackIndex - 1 : tracks.length - 1;
            playTrackAtIndex(prev);
        }

        function togglePlay() {
            if (currentTrackIndex === -1 && tracks.length > 0) { playTrackAtIndex(0); return; }
            if (!ytPlayer || !ytPlayer.getPlayerState) return;

            const state = ytPlayer.getPlayerState();
            if (state === YT.PlayerState.PLAYING) {
                ytPlayer.pauseVideo();
            } else {
                ytPlayer.playVideo();
            }
        }

        /* ── Progress bar ── */
        function startProgressLoop() {
            clearInterval(progressInterval);
            progressInterval = setInterval(() => {
                if (!ytPlayer || !ytPlayer.getCurrentTime) return;
                const cur = ytPlayer.getCurrentTime();
                const dur = ytPlayer.getDuration();
                if (dur > 0) {
                    document.getElementById('progressFill').style.width = (cur / dur * 100) + '%';
                    document.getElementById('currentTime').textContent = formatTime(cur);
                    document.getElementById('totalTime').textContent   = formatTime(dur);
                }
            }, 800);
        }

        function seek(e) {
            if (!ytPlayer || !ytPlayer.getDuration) return;
            const bar = document.getElementById('progressBar');
            const rect = bar.getBoundingClientRect();
            const ratio = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
            const dur = ytPlayer.getDuration();
            ytPlayer.seekTo(ratio * dur, true);
            document.getElementById('progressFill').style.width = (ratio * 100) + '%';
        }

        /* ── Volume ── */
        function setVolume(e) {
            if (!ytPlayer || !ytPlayer.setVolume) return;
            const track = document.getElementById('volTrack');
            const rect  = track.getBoundingClientRect();
            lastVolume  = Math.min(100, Math.max(0, ((e.clientX - rect.left) / rect.width) * 100));
            isMuted = false;
            ytPlayer.unMute();
            ytPlayer.setVolume(lastVolume);
            updateVolUI(lastVolume);
        }

        function toggleMute() {
            if (!ytPlayer || !ytPlayer.isMuted) return;
            if (ytPlayer.isMuted()) {
                ytPlayer.unMute();
                ytPlayer.setVolume(lastVolume);
                updateVolUI(lastVolume);
                isMuted = false;
            } else {
                lastVolume = ytPlayer.getVolume() || 80;
                ytPlayer.mute();
                updateVolUI(0);
                isMuted = true;
            }
        }

        function updateVolUI(vol) {
            document.getElementById('volFill').style.width = vol + '%';
            const icon = document.getElementById('volIcon');
            icon.className = vol === 0
                ? 'bi bi-volume-mute-fill'
                : vol < 50
                    ? 'bi bi-volume-down-fill'
                    : 'bi bi-volume-up-fill';
        }

        /* ── API Destekli Takip İşlemleri ── */
        function toggleFollowBtn(btn, artistId) {
            var token = '@Context.Session.GetString("JwtToken")?.Trim().Replace("\"", "")';

            $.ajax({
                url: 'https://localhost:7185/api/Follows/toggle/' + artistId,
                type: 'POST',
                beforeSend: function (xhr) {
                    if (token) {
                        xhr.setRequestHeader('Authorization', 'Bearer ' + token);
                    }
                },
                success: function (response) {
                    if (response.isFollowing) {
                        $(btn).addClass('following').html('<i class="bi bi-person-check-fill"></i> Takip Ediliyor');
                    } else {
                        $(btn).removeClass('following').html('<i class="bi bi-person-plus"></i> Takip Et');
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 401) {
                        alert('Bu işlemi gerçekleştirmek için lütfen giriş yapın.');
                    } else {
                        alert('Takip işlemi esnasında bir hata meydana geldi.');
                    }
                }
            });
        }

        function checkInitialFollowState() {
            var artistId = '@Model.Artist.ArtistId';
            var token = '@Context.Session.GetString("JwtToken")?.Trim().Replace("\"", "")';
            if(!artistId || !token) return;

            $.ajax({
                url: 'https://localhost:7185/api/Follows/is-following/' + artistId,
                type: 'GET',
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'Bearer ' + token);
                },
                success: function (response) {
                    var btn = document.getElementById('followBtn');
                    if (btn && response.isFollowing) {
                        $(btn).addClass('following').html('<i class="bi bi-person-check-fill"></i> Takip Ediliyor');
                    }
                }
            });
        }

        /* ── UI Toggles ── */
        function toggleHeart(btn) {
            btn.classList.toggle('liked');
            btn.querySelector('i').className = btn.classList.contains('liked')
                ? 'bi bi-heart-fill'
                : 'bi bi-heart';
        }

        function toggleLike(e, btn) {
            e.stopPropagation(); // Satırın genel tıklama olayını (şarkıyı oynatmayı) engeller
            btn.classList.toggle('liked');
            btn.querySelector('i').className = btn.classList.contains('liked')
                ? 'bi bi-heart-fill'
                : 'bi bi-heart';
        }

        /* ── Song search filter ── */
        function filterSongs() {
            const q    = document.getElementById('songSearchInput').value.toLowerCase().trim();
            const rows = document.querySelectorAll('.track-row');
            rows.forEach(row => {
                const title = row.getAttribute('data-title') || '';
                row.style.display = title.includes(q) ? '' : 'none';
            });
        }

        /* ── Helpers ── */
        function formatTime(secs) {
            const m = Math.floor(secs / 60);
            const s = Math.floor(secs % 60);
            return (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
        }
    </script>
</body>
</html>
