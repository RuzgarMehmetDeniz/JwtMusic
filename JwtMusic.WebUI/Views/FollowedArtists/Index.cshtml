@using JwtMusic.WebUI.Dtos
@model List<ResultArtistDto>
@{
    Layout = null;
    var token = ViewBag.Token as string ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Takip Ettiklerim — Canlı Müzik</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bg-root: #0c0c0e;
            --bg-sidebar: #111113;
            --bg-main: #0c0c0e;
            --bg-card: #181819;
            --bg-card-hover: #202022;
            --bg-surface: #1c1c1f;
            --bg-input: #1a1a1c;
            --accent: #c9a84c;
            --accent-dim: rgba(201,168,76,0.12);
            --accent-border: rgba(201,168,76,0.28);
            --accent-glow: 0 0 24px rgba(201,168,76,0.18);
            --text-1: #e8e8ea;
            --text-2: #8a8a94;
            --text-3: #46464e;
            --border: rgba(255,255,255,0.055);
            --border-hover: rgba(255,255,255,0.11);
            --sidebar-w: 224px;
            --player-h: 76px;
            --radius-card: 14px;
            --radius-sm: 8px;
            --radius-pill: 100px;
            --transition: 0.22s cubic-bezier(0.4,0,0.2,1);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            height: 100%;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-root);
            color: var(--text-1);
            height: 100%;
            overflow: hidden;
            display: grid;
            grid-template-columns: var(--sidebar-w) 1fr;
            grid-template-rows: 1fr var(--player-h);
            grid-template-areas:
                "sidebar main"
                "player  player";
        }

        img {
            display: block;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
            cursor: pointer;
        }

        /* ─── SIDEBAR ─────────────────────────────────────── */
        .sidebar {
            grid-area: sidebar;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            user-select: none;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 22px 20px 20px;
            border-bottom: 1px solid var(--border);
        }

        .logo-mark {
            width: 30px;
            height: 30px;
            background: var(--accent);
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .logo-mark i {
                color: #0c0c0e;
                font-size: 0.95rem;
            }

        .logo-wordmark {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 0.95rem;
            letter-spacing: -0.3px;
            color: var(--text-1);
        }

        .sidebar-section {
            padding: 20px 12px 8px;
        }

        .sidebar-label {
            font-size: 0.65rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-3);
            padding: 0 8px;
            margin-bottom: 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 10px;
            border-radius: var(--radius-sm);
            color: var(--text-2);
            font-size: 0.855rem;
            font-weight: 500;
            cursor: pointer;
            transition: background var(--transition), color var(--transition);
            position: relative;
            text-decoration: none;
        }

            .nav-item i {
                font-size: 1rem;
                width: 18px;
                flex-shrink: 0;
                text-align: center;
            }

            .nav-item:hover {
                background: rgba(255,255,255,0.04);
                color: var(--text-1);
            }

            .nav-item.active {
                color: var(--text-1);
                background: rgba(255,255,255,0.05);
            }

                .nav-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 20%;
                    bottom: 20%;
                    width: 2.5px;
                    border-radius: 2px;
                    background: var(--accent);
                }

        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 8px 12px;
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 16px 12px;
            border-top: 1px solid var(--border);
        }

        .user-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: background var(--transition);
        }

            .user-row:hover {
                background: rgba(255,255,255,0.04);
            }

        .user-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--bg-surface);
            border: 1.5px solid var(--border-hover);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--accent);
            flex-shrink: 0;
            overflow: hidden;
        }

            .user-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .user-info {
            min-width: 0;
        }

        .user-name {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-plan {
            font-size: 0.65rem;
            color: var(--accent);
            font-weight: 500;
        }

        /* ─── MAIN ───────────────────────────────────────── */
        .main {
            grid-area: main;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            background: var(--bg-main);
            scrollbar-width: thin;
            scrollbar-color: var(--bg-surface) transparent;
        }

            .main::-webkit-scrollbar {
                width: 5px;
            }

            .main::-webkit-scrollbar-track {
                background: transparent;
            }

            .main::-webkit-scrollbar-thumb {
                background: var(--bg-surface);
                border-radius: 4px;
            }

        /* ─── TOPBAR ─────────────────────────────────────── */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 28px;
            background: rgba(12,12,14,0.88);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--border);
            gap: 16px;
        }

        .topbar-breadcrumb {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 700;
            font-size: 1rem;
            color: var(--text-1);
            letter-spacing: -0.3px;
        }

        .search-field {
            position: relative;
            display: flex;
            align-items: center;
        }

            .search-field i {
                position: absolute;
                left: 12px;
                color: var(--text-3);
                font-size: 0.8rem;
                pointer-events: none;
            }

        .search-input {
            background: var(--bg-input);
            border: 1px solid var(--border);
            color: var(--text-1);
            border-radius: var(--radius-pill);
            padding: 7px 14px 7px 32px;
            font-size: 0.8rem;
            font-family: 'Inter', sans-serif;
            width: 210px;
            outline: none;
            transition: border-color var(--transition), box-shadow var(--transition), width var(--transition);
        }

            .search-input::placeholder {
                color: var(--text-3);
            }

            .search-input:focus {
                border-color: var(--accent-border);
                box-shadow: 0 0 0 3px rgba(201,168,76,0.08);
                width: 260px;
            }

        /* ─── CONTENT ────────────────────────────────────── */
        .content {
            padding: 28px 28px 40px;
            flex: 1;
        }

        .page-intro {
            margin-bottom: 24px;
        }

            .page-intro h1 {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 1.8rem;
                font-weight: 800;
                letter-spacing: -0.7px;
                color: var(--text-1);
            }

            .page-intro p {
                color: var(--text-2);
                font-size: 0.85rem;
                margin-top: 6px;
            }

        /* ─── ARTIST GRID ────────────────────────────────── */
        .artist-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
            gap: 20px;
        }

        .artist-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-card);
            padding: 16px;
            transition: background var(--transition), border-color var(--transition), transform 0.2s;
            cursor: pointer;
        }

            .artist-card:hover {
                background: var(--bg-card-hover);
                border-color: var(--border-hover);
                transform: translateY(-2px);
            }

        .artist-photo {
            width: 100%;
            aspect-ratio: 1 / 1;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 14px;
            border: 1px solid var(--border);
        }

        .artist-photo-fallback {
            width: 100%;
            aspect-ratio: 1 / 1;
            border-radius: 50%;
            background: var(--bg-surface);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 14px;
        }

        .artist-card-name {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.92rem;
            font-weight: 700;
            color: var(--text-1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .artist-card-meta {
            font-size: 0.74rem;
            color: var(--text-2);
            margin-top: 3px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .artist-card-meta i {
                color: var(--accent);
                font-size: 0.7rem;
            }

        .unfollow-btn {
            margin-top: 12px;
            width: 100%;
            background: transparent;
            border: 1px solid var(--accent-border);
            color: var(--accent);
            border-radius: var(--radius-pill);
            padding: 7px 14px;
            font-size: 0.76rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all var(--transition);
        }

            .unfollow-btn:hover {
                background: rgba(224,88,79,0.12);
                border-color: rgba(224,88,79,0.32);
                color: #e0584f;
            }

        /* ─── EMPTY STATE ────────────────────────────────── */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 5rem 2rem;
            border: 1px dashed var(--border);
            border-radius: var(--radius-card);
            color: var(--text-3);
        }

            .empty-state i {
                font-size: 2.2rem;
                margin-bottom: 14px;
                display: block;
                color: var(--text-3);
            }

            .empty-state p {
                font-size: 0.88rem;
                color: var(--text-2);
                margin-bottom: 18px;
            }

            .empty-state a {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: var(--accent);
                color: #0c0c0e;
                border-radius: var(--radius-pill);
                padding: 10px 22px;
                font-size: 0.85rem;
                font-weight: 700;
                font-family: 'Plus Jakarta Sans', sans-serif;
                box-shadow: var(--accent-glow);
                transition: background var(--transition), transform 0.15s;
            }

                .empty-state a:hover {
                    background: #d4b360;
                    transform: scale(1.02);
                }

        /* ─── PLAYER (static) ───────────────────────────────── */
        .player {
            grid-area: player;
            background: #111113;
            border-top: 1px solid var(--border);
            display: grid;
            grid-template-columns: 280px 1fr 280px;
            align-items: center;
            padding: 0 20px;
            gap: 12px;
            z-index: 100;
        }

        .player-track {
            display: flex;
            align-items: center;
            gap: 11px;
            min-width: 0;
        }

        .player-cover {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-sm);
            background: var(--bg-surface);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
        }

        .player-info {
            min-width: 0;
            flex: 1;
        }

        .player-song {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-2);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .player-artist {
            font-size: 0.72rem;
            color: var(--text-3);
            margin-top: 1px;
        }

        .player-center {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 7px;
        }

        .ctrl-btn-play {
            width: 38px;
            height: 38px;
            background: var(--bg-surface);
            color: var(--text-3);
            font-size: 1rem;
            border: none;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .player-progress {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            max-width: 440px;
        }

        .time-lbl {
            font-size: 0.65rem;
            color: var(--text-3);
            min-width: 34px;
            text-align: center;
        }

        .progress-track {
            flex: 1;
            height: 3px;
            background: rgba(255,255,255,0.08);
            border-radius: 3px;
        }

        .progress-fill {
            height: 100%;
            border-radius: 3px;
            background: var(--text-3);
            width: 0%;
        }

        .player-right {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
        }

        /* ─── RESPONSIVE ─────────────────────────────────── */
        @@media (max-width: 900px) {
            body {
                grid-template-columns: 1fr;
                grid-template-rows: 52px 1fr var(--player-h);
                grid-template-areas: "sidebar" "main" "player";
                overflow: hidden;
            }

            .sidebar {
                flex-direction: row;
                border-right: none;
                border-bottom: 1px solid var(--border);
                overflow-x: auto;
                overflow-y: hidden;
            }

            .sidebar-logo {
                padding: 12px 16px;
                border-bottom: none;
                border-right: 1px solid var(--border);
            }

            .sidebar-section {
                display: flex;
                flex-direction: row;
                padding: 8px;
                gap: 2px;
                align-items: center;
            }

            .sidebar-label, .sidebar-divider, .sidebar-footer {
                display: none;
            }

            .nav-item.active::before {
                top: auto;
                left: 20%;
                right: 20%;
                bottom: 0;
                height: 2px;
                width: auto;
            }

            .player {
                grid-template-columns: 1fr auto;
            }

            .player-right {
                display: none;
            }
        }

        @@media (max-width: 600px) {
            .content {
                padding: 16px 14px 28px;
            }

            .topbar {
                padding: 10px 14px;
            }

            .search-input {
                width: 140px;
            }

                .search-input:focus {
                    width: 160px;
                }
        }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-mark"><i class="bi bi-soundwave"></i></div>
            <span class="logo-wordmark">Canlı Müzik</span>
        </div>
        <nav class="sidebar-section">
            <span class="sidebar-label">Keşfet</span>
            <a href="/Song/SongList" class="nav-item"><i class="bi bi-house"></i> Ana Sayfa</a>
            <a href="/Artist/ArtistList" class="nav-item"><i class="bi bi-people"></i> Sanatçılar</a>
            <a href="/Song/SongList" class="nav-item"><i class="bi bi-music-note-list"></i> Şarkılar</a>
            <a href="/Recommendation/Index" class="nav-item"><i class="bi bi-stars"></i> Önerilenler</a>
        </nav>
        <div class="sidebar-divider"></div>
        <nav class="sidebar-section">
            <span class="sidebar-label">Kitaplık</span>
            <a href="/LikedSongs/Index" class="nav-item"><i class="bi bi-heart"></i> Beğendiklerim</a>
            <a href="/FollowedArtists/Index" class="nav-item active"><i class="bi bi-person-check"></i> Takip Ettiklerim</a>
            <a href="/Playlist/Index" class="nav-item"><i class="bi bi-collection-play"></i> Çalma Listeleri</a>
            <a href="/History/Index" class="nav-item"><i class="bi bi-clock-history"></i> Dinleme Geçmişi</a>
        </nav>
        <div class="sidebar-divider"></div>
        <nav class="sidebar-section">
            <a href="/Settings/Index" class="nav-item"><i class="bi bi-gear"></i> Ayarlar</a>
            <a href="/Login/Logout" class="nav-item" onclick="return confirm('Çıkış yapmak istediğinize emin misiniz?');">
                <i class="bi bi-box-arrow-right"></i> Çıkış Yap
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="user-row">
                <div class="user-avatar">K</div>
                <div class="user-info">
                    <div class="user-name">Hesabım</div>
                    <div class="user-plan">Profilim</div>
                </div>
            </div>
        </div>
    </aside>

    <main class="main">

        <div class="topbar">
            <span class="topbar-breadcrumb">Takip Ettiklerim</span>
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input class="search-input" type="text" id="artistSearchInput" oninput="filterArtists()" placeholder="Sanatçılarda ara..." autocomplete="off">
            </div>
        </div>

        <div class="content">
            <div class="page-intro">
                <h1>Takip Ettiklerim</h1>
                <p>@(Model != null ? Model.Count : 0) sanatçıyı takip ediyorsun.</p>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="artist-grid" id="artistGrid">
                    @foreach (var artist in Model)
                    {
                        <div class="artist-card" data-name="@artist.Name.ToLower()" onclick="goToArtist(@artist.ArtistId)">
                            @if (!string.IsNullOrEmpty(artist.ImageUrl))
                            {
                                <img src="@artist.ImageUrl" alt="@artist.Name" class="artist-photo"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                <div class="artist-photo-fallback" style="display:none;">🎵</div>
                            }
                            else
                            {
                                <div class="artist-photo-fallback">🎵</div>
                            }

                            <div class="artist-card-name">@artist.Name</div>
                            <div class="artist-card-meta">
                                <i class="bi bi-person-fill"></i>
                                <span>@artist.MonthlyListeners.ToString("N0") aylık dinleyici</span>
                            </div>

                            <button class="unfollow-btn" onclick="event.stopPropagation(); unfollowArtist(@artist.ArtistId, this)">
                                <i class="bi bi-person-dash"></i> Takipten Çık
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-person-x"></i>
                    <p>Henüz hiçbir sanatçıyı takip etmiyorsun.</p>
                    <a href="/Artist/ArtistList"><i class="bi bi-people"></i> Sanatçılara Göz At</a>
                </div>
            }
        </div>
    </main>

    <!-- PLAYER (statik) -->
    <div class="player">
        <div class="player-track">
            <div class="player-cover">🎵</div>
            <div class="player-info">
                <div class="player-song">Oynatılmıyor</div>
                <div class="player-artist">—</div>
            </div>
        </div>
        <div class="player-center">
            <div class="ctrl-btn-play"><i class="bi bi-play-fill"></i></div>
            <div class="player-progress">
                <span class="time-lbl">00:00</span>
                <div class="progress-track"><div class="progress-fill"></div></div>
                <span class="time-lbl">00:00</span>
            </div>
        </div>
        <div class="player-right"></div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        const token = '@token';

        function goToArtist(artistId) {
            window.location.href = '/Artist/ArtistDetail/' + artistId;
        }

        function unfollowArtist(artistId, btn) {
            $.ajax({
                url: 'https://localhost:7185/api/Follows/toggle/' + artistId,
                type: 'POST',
                beforeSend: function (xhr) {
                    if (token) {
                        xhr.setRequestHeader('Authorization', 'Bearer ' + token);
                    }
                },
                success: function (response) {
                    if (!response.isFollowing) {
                        const card = btn.closest('.artist-card');
                        card.style.transition = 'opacity 0.25s, transform 0.25s';
                        card.style.opacity = '0';
                        card.style.transform = 'scale(0.92)';
                        setTimeout(() => {
                            card.remove();
                            const grid = document.getElementById('artistGrid');
                            if (grid && grid.children.length === 0) {
                                location.reload();
                            }
                        }, 250);
                    }
                },
                error: function () {
                    alert('Takipten çıkma işlemi sırasında bir hata oluştu.');
                }
            });
        }

        function filterArtists() {
            const q = document.getElementById('artistSearchInput').value.toLowerCase().trim();
            document.querySelectorAll('.artist-card').forEach(card => {
                const name = card.getAttribute('data-name') || '';
                card.style.display = name.includes(q) ? '' : 'none';
            });
        }
    </script>
</body>
</html>
