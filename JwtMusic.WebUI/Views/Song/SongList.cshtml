@model List<JwtMusic.WebUI.Dtos.SongDtos.ResultSongDto>
@{
    Layout = null;
    var token = ViewBag.Token as string ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Canlı Müzik — Şarkılar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bg-root: #0c0c0e;
            --bg-sidebar: #111113;
            --bg-main: #0c0c0e;
            --bg-card: #181819;
            --bg-card-hover: #202022;
            --bg-surface: #1c1c1f;
            --bg-input: #1a1a1c;
            --accent: #c9a84c;
            --accent-dim: rgba(201,168,76,0.12);
            --accent-border: rgba(201,168,76,0.28);
            --accent-glow: 0 0 24px rgba(201,168,76,0.18);
            --text-1: #e8e8ea;
            --text-2: #8a8a94;
            --text-3: #46464e;
            --border: rgba(255,255,255,0.055);
            --border-hover: rgba(255,255,255,0.11);
            --sidebar-w: 224px;
            --player-h: 76px;
            --radius-card: 14px;
            --radius-sm: 8px;
            --radius-pill: 100px;
            --transition: 0.22s cubic-bezier(0.4,0,0.2,1);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            height: 100%;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-root);
            color: var(--text-1);
            height: 100%;
            overflow: hidden;
            display: grid;
            grid-template-columns: var(--sidebar-w) 1fr;
            grid-template-rows: 1fr var(--player-h);
            grid-template-areas: "sidebar main" "player player";
        }

        img {
            display: block;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
            cursor: pointer;
        }

        /* SIDEBAR */
        .sidebar {
            grid-area: sidebar;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            user-select: none;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 22px 20px 20px;
            border-bottom: 1px solid var(--border);
        }

        .logo-mark {
            width: 30px;
            height: 30px;
            background: var(--accent);
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .logo-mark i {
                color: #0c0c0e;
                font-size: 0.95rem;
            }

        .logo-wordmark {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 0.95rem;
            letter-spacing: -0.3px;
            color: var(--text-1);
        }

        .sidebar-section {
            padding: 20px 12px 8px;
        }

        .sidebar-label {
            font-size: 0.65rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-3);
            padding: 0 8px;
            margin-bottom: 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 10px;
            border-radius: var(--radius-sm);
            color: var(--text-2);
            font-size: 0.855rem;
            font-weight: 500;
            cursor: pointer;
            transition: background var(--transition), color var(--transition);
            position: relative;
            text-decoration: none;
        }

            .nav-item i {
                font-size: 1rem;
                width: 18px;
                flex-shrink: 0;
                text-align: center;
            }

            .nav-item:hover {
                background: rgba(255,255,255,0.04);
                color: var(--text-1);
            }

            .nav-item.active {
                color: var(--text-1);
                background: rgba(255,255,255,0.05);
            }

                .nav-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 20%;
                    bottom: 20%;
                    width: 2.5px;
                    border-radius: 2px;
                    background: var(--accent);
                }

        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 8px 12px;
        }

        /* MAIN */
        .main {
            grid-area: main;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            background: var(--bg-main);
            scrollbar-width: thin;
            scrollbar-color: var(--bg-surface) transparent;
        }

            .main::-webkit-scrollbar {
                width: 5px;
            }

            .main::-webkit-scrollbar-track {
                background: transparent;
            }

            .main::-webkit-scrollbar-thumb {
                background: var(--bg-surface);
                border-radius: 4px;
            }

        /* TOPBAR */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 28px;
            background: rgba(12,12,14,0.88);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--border);
            gap: 16px;
        }

        .topbar-breadcrumb {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 700;
            font-size: 1rem;
            color: var(--text-1);
            letter-spacing: -0.3px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .search-field {
            position: relative;
            display: flex;
            align-items: center;
        }

            .search-field i {
                position: absolute;
                left: 12px;
                color: var(--text-3);
                font-size: 0.8rem;
                pointer-events: none;
            }

        .search-input {
            background: var(--bg-input);
            border: 1px solid var(--border);
            color: var(--text-1);
            border-radius: var(--radius-pill);
            padding: 7px 14px 7px 32px;
            font-size: 0.8rem;
            font-family: 'Inter', sans-serif;
            width: 210px;
            outline: none;
            transition: border-color var(--transition), box-shadow var(--transition), width var(--transition);
        }

            .search-input::placeholder {
                color: var(--text-3);
            }

            .search-input:focus {
                border-color: var(--accent-border);
                box-shadow: 0 0 0 3px rgba(201,168,76,0.08);
                width: 260px;
            }

        /* CONTENT */
        .content {
            padding: 28px 28px 40px;
            flex: 1;
        }

        .page-header {
            margin-bottom: 24px;
        }

            .page-header h1 {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 1.75rem;
                font-weight: 800;
                letter-spacing: -0.6px;
                color: var(--text-1);
                margin-bottom: 4px;
            }

            .page-header p {
                font-size: 0.83rem;
                color: var(--text-2);
            }

        /* FILTERS */
        .filters-row {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 24px;
        }

        .chip {
            padding: 6px 14px;
            border-radius: var(--radius-pill);
            font-size: 0.78rem;
            font-weight: 500;
            cursor: pointer;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text-2);
            transition: all var(--transition);
        }

            .chip:hover {
                border-color: var(--border-hover);
                color: var(--text-1);
                background: rgba(255,255,255,0.03);
            }

            .chip.active {
                background: var(--accent);
                border-color: var(--accent);
                color: #0c0c0e;
                font-weight: 600;
            }

        /* SONG GRID */
        .song-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 14px;
        }

        .song-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-card);
            overflow: hidden;
            cursor: pointer;
            transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
            position: relative;
        }

            .song-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 16px 40px rgba(0,0,0,0.55);
                border-color: rgba(201,168,76,0.22);
            }

            .song-card.hide {
                display: none !important;
            }

            .song-card::after {
                content: '';
                position: absolute;
                inset: 0;
                border-radius: var(--radius-card);
                border: 1.5px solid var(--accent);
                opacity: 0;
                transition: opacity var(--transition);
                pointer-events: none;
            }

            .song-card:hover::after {
                opacity: 1;
            }

        /* CARD IMAGE */
        .card-img-wrap {
            position: relative;
            width: 100%;
            aspect-ratio: 1;
            overflow: hidden;
            background: var(--bg-surface);
        }

        .card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.38s cubic-bezier(0.25,0.8,0.25,1);
            display: block;
        }

        .card-img-wrap .img-fallback {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            background: linear-gradient(145deg, #1e1e22, #2a2a30);
        }

        .song-card:hover .card-img {
            transform: scale(1.06);
        }

        /* Premium rozeti */
        .card-badge {
            position: absolute;
            top: 8px;
            left: 8px;
            padding: 3px 8px;
            border-radius: var(--radius-pill);
            font-size: 0.62rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            backdrop-filter: blur(6px);
            z-index: 2;
        }

            .card-badge.premium {
                background: rgba(201,168,76,0.85);
                color: #0c0c0e;
            }

            .card-badge.basic {
                background: rgba(255,255,255,0.12);
                color: var(--text-2);
            }

        .card-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, transparent 55%);
            opacity: 0;
            transition: opacity var(--transition);
            display: flex;
            align-items: flex-end;
            justify-content: flex-end;
            padding: 12px;
            gap: 8px;
        }

        .song-card:hover .card-overlay {
            opacity: 1;
        }

        .overlay-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.18);
            background: rgba(12,12,14,0.7);
            color: var(--text-1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            cursor: pointer;
            transition: background var(--transition), border-color var(--transition), transform 0.15s;
            backdrop-filter: blur(6px);
        }

            .overlay-btn:hover {
                background: var(--accent);
                border-color: var(--accent);
                color: #0c0c0e;
                transform: scale(1.08);
            }

        .overlay-btn-play {
            width: 40px;
            height: 40px;
            background: var(--accent);
            border-color: var(--accent);
            color: #0c0c0e;
            font-size: 0.95rem;
        }

            .overlay-btn-play:hover {
                background: #d4b360;
                transform: scale(1.1);
            }

        /* CARD BODY */
        .card-body {
            padding: 12px 13px 13px;
        }

        .card-name {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.9rem;
            font-weight: 700;
            letter-spacing: -0.2px;
            color: var(--text-1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 2px;
        }

        .card-artist {
            font-size: 0.72rem;
            color: var(--text-2);
            margin-bottom: 10px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .card-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
        }

        .card-duration {
            font-size: 0.7rem;
            color: var(--text-3);
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .card-duration i {
                color: var(--accent);
                font-size: 0.65rem;
            }

        .card-play-count {
            font-size: 0.7rem;
            color: var(--text-3);
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .card-play-count i {
                color: var(--accent);
                font-size: 0.65rem;
            }

        /* Paket yetersiz uyarı modalı */
        .pkg-modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 999;
            background: rgba(0,0,0,0.7);
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(4px);
        }

            .pkg-modal.show {
                display: flex;
            }

        .pkg-modal-box {
            background: var(--bg-card);
            border: 1px solid var(--accent-border);
            border-radius: var(--radius-card);
            padding: 32px 28px;
            max-width: 340px;
            width: 90%;
            text-align: center;
            box-shadow: var(--accent-glow);
        }

        .pkg-modal-icon {
            font-size: 2.5rem;
            color: var(--accent);
            margin-bottom: 14px;
            display: block;
        }

        .pkg-modal-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-1);
            margin-bottom: 8px;
        }

        .pkg-modal-text {
            font-size: 0.83rem;
            color: var(--text-2);
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .pkg-modal-btn {
            padding: 9px 22px;
            border-radius: var(--radius-pill);
            background: var(--accent);
            border: none;
            color: #0c0c0e;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: background var(--transition);
        }

            .pkg-modal-btn:hover {
                background: #d4b360;
            }

        /* EMPTY STATE */
        .no-results {
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 5rem 1rem;
            color: var(--text-3);
            grid-column: 1 / -1;
        }

            .no-results i {
                font-size: 2.5rem;
                margin-bottom: 12px;
                display: block;
            }

            .no-results p {
                font-size: 0.85rem;
                max-width: 260px;
                line-height: 1.6;
            }

            .no-results strong {
                display: block;
                font-size: 0.95rem;
                color: var(--text-2);
                margin-bottom: 4px;
                font-family: 'Plus Jakarta Sans', sans-serif;
            }

        /* PLAYER */
        .player {
            grid-area: player;
            background: #111113;
            border-top: 1px solid var(--border);
            display: grid;
            grid-template-columns: 280px 1fr 280px;
            align-items: center;
            padding: 0 20px;
            gap: 12px;
            z-index: 100;
        }

        .player-track {
            display: flex;
            align-items: center;
            gap: 11px;
            min-width: 0;
        }

        .player-cover {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-sm);
            background: var(--bg-surface);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
            overflow: hidden;
        }

            .player-cover img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .player-info {
            min-width: 0;
            flex: 1;
        }

        .player-song {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .player-artist {
            font-size: 0.72rem;
            color: var(--text-2);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 1px;
        }

        .player-like-btn {
            background: none;
            border: none;
            color: var(--text-3);
            font-size: 0.9rem;
            cursor: pointer;
            padding: 5px;
            transition: color var(--transition);
            flex-shrink: 0;
        }

            .player-like-btn:hover, .player-like-btn.liked {
                color: var(--accent);
            }

        .player-center {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 7px;
        }

        .player-controls {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .ctrl-btn {
            background: none;
            border: none;
            color: var(--text-2);
            font-size: 0.9rem;
            cursor: pointer;
            padding: 0;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color var(--transition), background var(--transition);
        }

            .ctrl-btn:hover {
                color: var(--text-1);
                background: rgba(255,255,255,0.05);
            }

        .ctrl-btn-play {
            width: 38px;
            height: 38px;
            background: var(--text-1);
            color: var(--bg-root);
            font-size: 1rem;
            border-radius: 50%;
            transition: transform 0.15s, background var(--transition);
        }

            .ctrl-btn-play:hover {
                background: #fff;
                transform: scale(1.05);
            }

        .player-progress {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            max-width: 440px;
        }

        .time-lbl {
            font-size: 0.65rem;
            color: var(--text-3);
            min-width: 30px;
            text-align: center;
            font-variant-numeric: tabular-nums;
        }

        .progress-track {
            flex: 1;
            height: 3px;
            background: rgba(255,255,255,0.08);
            border-radius: 3px;
            cursor: pointer;
            position: relative;
        }

            .progress-track:hover {
                height: 4px;
            }

        .progress-fill {
            height: 100%;
            border-radius: 3px;
            background: var(--text-1);
            width: 0%;
            position: relative;
            transition: width 0.1s linear;
        }

        .progress-track:hover .progress-fill {
            background: var(--accent);
        }

        .progress-fill::after {
            content: '';
            position: absolute;
            right: -4px;
            top: 50%;
            transform: translateY(-50%) scale(0);
            width: 9px;
            height: 9px;
            background: #fff;
            border-radius: 50%;
            transition: transform 0.15s;
        }

        .progress-track:hover .progress-fill::after {
            transform: translateY(-50%) scale(1);
        }

        .player-right {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
        }

            .player-right .ctrl-btn {
                font-size: 0.85rem;
            }

        .vol-wrap {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .vol-btn {
            background: none;
            border: none;
            color: var(--text-2);
            font-size: 0.9rem;
            cursor: pointer;
            padding: 4px;
            transition: color var(--transition);
        }

            .vol-btn:hover {
                color: var(--text-1);
            }

        .vol-track {
            width: 78px;
            height: 3px;
            background: rgba(255,255,255,0.08);
            border-radius: 3px;
            cursor: pointer;
        }

        .vol-fill {
            height: 100%;
            border-radius: 3px;
            background: rgba(255,255,255,0.3);
            width: 70%;
            transition: background var(--transition);
        }

        .vol-track:hover .vol-fill {
            background: var(--text-1);
        }

        /* Waveform */
        .waveform {
            display: flex;
            align-items: center;
            gap: 2px;
            height: 14px;
        }

            .waveform span {
                display: block;
                width: 2.5px;
                border-radius: 2px;
                background: var(--accent);
                animation: wv 1.1s ease-in-out infinite;
            }

                .waveform span:nth-child(1) {
                    height: 5px;
                    animation-delay: 0s;
                }

                .waveform span:nth-child(2) {
                    height: 12px;
                    animation-delay: 0.1s;
                }

                .waveform span:nth-child(3) {
                    height: 8px;
                    animation-delay: 0.2s;
                }

                .waveform span:nth-child(4) {
                    height: 14px;
                    animation-delay: 0.3s;
                }

                .waveform span:nth-child(5) {
                    height: 6px;
                    animation-delay: 0.4s;
                }

        @@keyframes wv {
            0%, 100%

        {
            transform: scaleY(1);
        }

        50% {
            transform: scaleY(0.3);
        }

        }

        .waveform.paused span {
            animation-play-state: paused;
        }

        @@media (max-width: 900px) {
            body

        {
            grid-template-columns: 1fr;
            grid-template-rows: 52px 1fr var(--player-h);
            grid-template-areas: "sidebar" "main" "player";
        }

        .sidebar {
            flex-direction: row;
            border-right: none;
            border-bottom: 1px solid var(--border);
            overflow-x: auto;
        }

        .sidebar-logo {
            padding: 12px 16px;
            border-bottom: none;
            border-right: 1px solid var(--border);
        }

        .sidebar-section {
            display: flex;
            flex-direction: row;
            padding: 8px;
            gap: 2px;
            align-items: center;
        }

        .sidebar-label, .sidebar-divider {
            display: none;
        }

        .nav-item.active::before {
            top: auto;
            left: 20%;
            right: 20%;
            bottom: 0;
            height: 2px;
            width: auto;
        }

        .player {
            grid-template-columns: 1fr auto;
        }

        .player-right {
            display: none;
        }

        }

        @@media (max-width: 600px) {
            .song-grid

        {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .content {
            padding: 16px 14px 28px;
        }

        .topbar {
            padding: 10px 14px;
        }

        .search-input {
            width: 140px;
        }

            .search-input:focus {
                width: 160px;
            }

        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-mark">
                <i class="bi bi-music-note-beamed"></i>
            </div>
            <span class="logo-wordmark">CANLI MÜZİK</span>
        </div>

        <div class="sidebar-section">
            <p class="sidebar-label">Menü</p>
            <a href="#" class="nav-item active">
                <i class="bi bi-music-note-list"></i>
                <span>Şarkılar</span>
            </a>
            <a href="#" class="nav-item">
                <i class="bi bi-mic"></i>
                <span>Sanatçılar</span>
            </a>
            <a href="#" class="nav-item">
                <i class="bi bi-disc"></i>
                <span>Albümler</span>
            </a>
        </div>
        <div class="sidebar-divider"></div>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-breadcrumb">Şarkılarım / Keşfet</div>
            <div class="topbar-right">
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input type="text" id="searchInput" class="search-input" placeholder="Şarkı adı ara...">
                </div>
            </div>
        </header>

        <div class="content">
            <div class="page-header">
                <h1>Müzik Kütüphanesi</h1>
                <p>Premium kalitede listelenen canlı ve stüdyo parçaları dinleyin.</p>
            </div>

            <div class="filters-row">
                <button class="chip active" data-filter="all">Tüm Şarkılar</button>
                <button class="chip" data-filter="premium">Premium</button>
                <button class="chip" data-filter="basic">Standart</button>
            </div>

            <div class="song-grid">
                @if (Model != null && Model.Any())
                {
                    foreach (var song in Model)
                    {
                        // Eğer şarkının özel bir rol gereksinimi varsa bunu data attribute veya fonksiyona geçebiliriz
                        var requiredRole = !string.IsNullOrEmpty(song.RequiredRoleName) ? song.RequiredRoleName : "Free";

                        // Tasarımda premium rozeti yerine dinamik olarak rol ismini (VIP, Premium vb.) yazdırabiliriz
                        var hasRoleBadge = !string.IsNullOrEmpty(song.RequiredRoleName);

                        <div class="song-card"
                             data-filter="@(hasRoleBadge ? "premium" : "basic")"
                             data-name="@song.Title.ToLower()"
                             onclick="playSong('@song.SongId', '@song.Title', '@song.ArtistName', '@song.CoverImageUrl', '@song.AudioUrl', '@requiredRole')">

                            <div class="card-img-wrap">
                                @if (hasRoleBadge)
                                {
                                    <span class="card-badge premium">@song.RequiredRoleName</span>
                                }
                                else
                                {
                                    <span class="card-badge basic">Herkes</span>
                                }

                                @if (!string.IsNullOrEmpty(song.CoverImageUrl))
                                {
                                    <img src="@song.CoverImageUrl" class="card-img" alt="@song.Title" loading="lazy">
                                }
                                else
                                {
                                    <div class="img-fallback">🎵</div>
                                }

                                <div class="card-overlay">
                                    <button type="button" class="overlay-btn overlay-btn-play" aria-label="Oynat">
                                        <i class="bi bi-play-fill"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="card-body">
                                <h3 class="card-name">@song.Title</h3>
                                <p class="card-artist">@song.ArtistName</p>
                                <div class="card-meta">
                                    <span class="card-duration">
                                        <i class="bi bi-clock"></i> 3:45
                                    </span>
                                    <span class="card-play-count">
                                        <i class="bi bi-headphones"></i> 1.2K
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                }
                <div id="noResults" class="no-results">
                    <i class="bi bi-music-note-slash"></i>
                    <strong>Aradığınız şarkı bulunamadı</strong>
                    <p>Farklı bir anahtar kelime yazmayı veya filtreyi değiştirmeyi deneyebilirsiniz.</p>
                </div>
            </div>
        </div>
    </main>

    <footer class="player">
        <div class="player-track">
            <div class="player-cover" id="playerCover">🎵</div>
            <div class="player-info">
                <div class="player-song" id="playerSong">Oynatılmıyor</div>
                <div class="player-artist" id="playerArtist">Lütfen bir şarkı seçin</div>
            </div>
            <button class="player-like-btn" onclick="toggleHeart(this)" title="Beğen">
                <i class="bi bi-heart"></i>
            </button>
        </div>

        <div class="player-center">
            <div class="player-controls">
                <button class="ctrl-btn" onclick="playPrev()" title="Önceki Şarkı">
                    <i class="bi bi-skip-start-fill"></i>
                </button>
                <button class="ctrl-btn ctrl-btn-play" onclick="togglePlay()" title="Oynat / Durdur">
                    <i id="playIcon" class="bi bi-play-fill"></i>
                </button>
                <button class="ctrl-btn" onclick="playNext()" title="Sonraki Şarkı">
                    <i class="bi bi-skip-end-fill"></i>
                </button>
            </div>
            <div class="player-progress">
                <span class="time-lbl" id="currentTime">0:00</span>
                <div class="progress-track" id="progressBar" onclick="seekTo(e)">
                    <div class="progress-fill" id="progressFill"></div>
                </div>
                <span class="time-lbl" id="totalTime">0:00</span>
            </div>
        </div>

        <div class="player-right">
            <div id="waveform" class="waveform paused" style="margin-right: 12px;">
                <span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="vol-wrap">
                <button class="vol-btn" onclick="toggleMute()" title="Sesi Kapat/Aç">
                    <i id="volIcon" class="bi bi-volume-up-fill"></i>
                </button>
                <div class="vol-track" id="volTrack" onclick="setVolume(event)">
                    <div class="vol-fill" id="volFill" style="width: 70%;"></div>
                </div>
            </div>
        </div>
    </footer>

    <div id="pkgModal" class="pkg-modal">
        <div class="pkg-modal-box">
            <i class="bi bi-shield-lock-fill pkg-modal-icon"></i>
            <h2 class="pkg-modal-title">Premium İçerik</h2>
            <p class="pkg-modal-text">Bu şarkıyı dinleyebilmek için mevcut paketinizin Premium olması gerekmektedir. Detaylar için abonelik alanını ziyaret edin.</p>
            <button class="pkg-modal-btn" onclick="document.getElementById('pkgModal').classList.remove('show')">Kapat</button>
        </div>
    </div>

    <div id="ytPlayer" style="position:absolute; width:0; height:0; pointer-events:none; opacity:0;"></div>

    <script>
        /* ── YouTube IFrame API ── */
        var tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        document.head.appendChild(tag);

        let ytPlayer, ytReady = false, pendingVideoId = null;
        let volumeVal = 70, isMuted = false, progressInterval;

        // Şarkı listesi
        const ALL_SONGS = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model ?? new List<JwtMusic.WebUI.Dtos.SongDtos.ResultSongDto>()));
        let currentIndex = -1;

        function onYouTubeIframeAPIReady() {
            ytPlayer = new YT.Player('ytPlayer', {
                height: '0', width: '0',
                playerVars: { controls: 0, disablekb: 1, rel: 0 },
                events: {
                    onReady: function() {
                        ytReady = true;
                        ytPlayer.setVolume(volumeVal);
                        document.getElementById('volFill').style.width = volumeVal + '%';
                        if (pendingVideoId) { ytPlayer.loadVideoById(pendingVideoId); pendingVideoId = null; }
                    },
                    onStateChange: function(e) {
                        if (e.data === YT.PlayerState.PLAYING) {
                            document.getElementById('playIcon').className = 'bi bi-pause-fill';
                            document.getElementById('waveform').classList.remove('paused');
                            startProgressLoop();
                        } else if (e.data === YT.PlayerState.PAUSED || e.data === YT.PlayerState.BUFFERING) {
                            document.getElementById('playIcon').className = 'bi bi-play-fill';
                            document.getElementById('waveform').classList.add('paused');
                        } else if (e.data === YT.PlayerState.ENDED) {
                            playNext();
                        }
                    },
                    onError: function(e) { console.error('YT hata:', e.data); }
                }
            });
        }

        function playSong(songId, title, artist, coverUrl, audioUrl, requiredRole) {

            // Kullanıcının mevcut rolü (Senin rolün Gold)
            const userRole = "Gold";

            // Küçük harfe çevirerek rollerin hiyerarşisini kontrol ediyoruz
            const reqRoleLower = requiredRole ? requiredRole.toLowerCase() : "free";

            // EĞER Şarkı senin rolünün ÜSTÜNDEYSE (Örn: şarkı Premium/VIP istiyor ama sen Gold isen) direkt önyüzde keselim
            // Not: Buradaki rollerin isimlerini kendi veritabanındaki hiyerarşiye göre (vip, premium vb.) çoğaltabilirsin.
            if (userRole.toLowerCase() === "gold" && (reqRoleLower === "vip" || reqRoleLower === "premium")) {
                document.querySelector('.pkg-modal-text').textContent =
                    `Bu şarkıyı dinleyebilmek için '${requiredRole}' üyelik paketine sahip olmanız gerekmektedir. Mevcut paketiniz: ${userRole}`;
                document.getElementById('pkgModal').classList.add('show');
                return; // Fonksiyondan çık, API'ye istek atıp sunucuyu yorma
            }

            // Eğer rolün yetiyorsa (Gold, Basic, Free vb.) API'ye güvenle istek atıyoruz
            fetch(`https://localhost:7185/api/Songs/${songId}`, {
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + '@token',
                    'Content-Type': 'application/json'
                }
            })
            .then(res => {
                // Backend'den de her ihtimale karşı 403 (Yetki yok) dönerse modalı göster
                if (res.status === 403) {
                    document.querySelector('.pkg-modal-text').textContent =
                        `Bu şarkı için yetkiniz yetersizdir. Gerekli Rol: ${requiredRole}`;
                    document.getElementById('pkgModal').classList.add('show');
                    return null;
                }
                return res.json();
            })
            .then(data => {
                if (!data) return;

                // Şarkıyı çalma listesinde bul ve index güncelle
                currentIndex = ALL_SONGS.findIndex(s => (s.SongId == songId || s.songId == songId));

                const videoId = getYoutubeId(audioUrl);
                if (!videoId) {
                    console.error('Geçersiz YouTube URL:', audioUrl);
                    return;
                }

                // Player alt barını güncelle
                document.getElementById('playerSong').textContent   = title;
                document.getElementById('playerArtist').textContent = artist;

                const cover = document.getElementById('playerCover');
                cover.innerHTML = coverUrl
                    ? `<img src="${coverUrl}" alt="${title}" onerror="this.parentElement.textContent='🎵'">`
                    : '🎵';

                // YouTube videosunu oynat
                if (ytReady && ytPlayer?.loadVideoById) {
                    ytPlayer.loadVideoById(videoId);
                } else {
                    pendingVideoId = videoId;
                }
            })
            .catch(err => console.error('Oynatma hatası:', err));
        }

        function playNext() {
            if (currentIndex > -1 && currentIndex < ALL_SONGS.length - 1) {
                const next = ALL_SONGS[currentIndex + 1];
                playSong(next.SongId || next.songId, next.Title || next.title, next.ArtistName || next.artistName, next.CoverImageUrl || next.coverImageUrl, next.AudioUrl || next.audioUrl, next.IsPremium || next.isPremium);
            }
        }

        function playPrev() {
            if (currentIndex > 0) {
                const prev = ALL_SONGS[currentIndex - 1];
                playSong(prev.SongId || prev.songId, prev.Title || prev.title, prev.ArtistName || prev.artistName, prev.CoverImageUrl || prev.coverImageUrl, prev.AudioUrl || prev.audioUrl, prev.IsPremium || prev.isPremium);
            } else if (ytPlayer?.seekTo) {
                ytPlayer.seekTo(0, true);
            }
        }

        function togglePlay() {
            if (!ytPlayer?.getPlayerState) return;
            const state = ytPlayer.getPlayerState();
            if (state === YT.PlayerState.PLAYING) ytPlayer.pauseVideo();
            else ytPlayer.playVideo();
        }

        function startProgressLoop() {
            clearInterval(progressInterval);
            progressInterval = setInterval(() => {
                if (!ytPlayer?.getCurrentTime) return;
                const cur = ytPlayer.getCurrentTime();
                const dur = ytPlayer.getDuration();
                if (dur > 0) {
                    document.getElementById('progressFill').style.width = (cur / dur * 100) + '%';
                    document.getElementById('currentTime').textContent = formatTime(cur);
                    document.getElementById('totalTime').textContent   = formatTime(dur);
                }
            }, 500);
        }

        function seekTo(e) {
            if (!ytPlayer?.getDuration) return;
            const bar  = document.getElementById('progressBar');
            const rect = bar.getBoundingClientRect();
            const ratio = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
            ytPlayer.seekTo(ratio * ytPlayer.getDuration(), true);
            document.getElementById('progressFill').style.width = (ratio * 100) + '%';
        }

        function setVolume(e) {
            if (!ytPlayer?.setVolume) return;
            const rect = document.getElementById('volTrack').getBoundingClientRect();
            volumeVal = Math.min(100, Math.max(0, ((e.clientX - rect.left) / rect.width) * 100));
            isMuted = false; ytPlayer.unMute(); ytPlayer.setVolume(volumeVal);
            document.getElementById('volFill').style.width = volumeVal + '%';
            updateVolIcon();
        }

        function toggleMute() {
            if (!ytPlayer) return;
            if (ytPlayer.isMuted()) {
                ytPlayer.unMute(); ytPlayer.setVolume(volumeVal);
                document.getElementById('volFill').style.width = volumeVal + '%';
                isMuted = false;
            } else {
                ytPlayer.mute();
                document.getElementById('volFill').style.width = '0%';
                isMuted = true;
            }
            updateVolIcon();
        }

        function updateVolIcon() {
            document.getElementById('volIcon').className =
                (isMuted || volumeVal === 0) ? 'bi bi-volume-mute-fill' : 'bi bi-volume-up-fill';
        }

        function toggleHeart(btn) {
            btn.classList.toggle('liked');
            btn.querySelector('i').className = btn.classList.contains('liked') ? 'bi bi-heart-fill' : 'bi bi-heart';
        }

        function formatTime(secs) {
            const m = Math.floor(secs / 60);
            const s = Math.floor(secs % 60);
            return m + ':' + String(s).padStart(2, '0');
        }

        function getYoutubeId(url) {
            if (!url) return null;
            if (url.length === 11 && !url.includes('/') && !url.includes('?')) return url;
            const m = url.match(/^.*(youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/);
            return (m && m[2].length === 11) ? m[2] : null;
        }

        /* ── Arama & Filtreleme Mantığı ── */
        document.addEventListener('DOMContentLoaded', function () {
            const chips       = document.querySelectorAll('.chip');
            const searchInput = document.getElementById('searchInput');
            const noResults   = document.getElementById('noResults');
            if (noResults) noResults.style.display = 'none';

            function applyFilters() {
                const activeChip = document.querySelector('.chip.active');
                const filter = activeChip ? activeChip.getAttribute('data-filter') : 'all';
                const query  = searchInput ? searchInput.value.trim().toLowerCase() : '';
                const cards  = document.querySelectorAll('.song-card');
                let visible  = 0;

                cards.forEach(card => {
                    const cardFilter = card.getAttribute('data-filter') || '';
                    const cardName   = card.getAttribute('data-name') || '';
                    const filterMatch = filter === 'all' || cardFilter === filter;
                    const nameMatch   = cardName.includes(query);

                    if (filterMatch && nameMatch) {
                        card.classList.remove('hide');
                        visible++;
                    } else {
                        card.classList.add('hide');
                    }
                });

                if (noResults) noResults.style.display = visible === 0 ? 'flex' : 'none';
            }

            chips.forEach(chip => {
                chip.addEventListener('click', function () {
                    chips.forEach(c => c.classList.remove('active'));
                    this.classList.add('active');
                    applyFilters();
                });
            });

            if (searchInput) searchInput.addEventListener('input', applyFilters);
        });
    </script>
</body>
</html>