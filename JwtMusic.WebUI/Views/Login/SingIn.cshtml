@model JwtMusic.WebUI.Dtos.LoginDto
@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap — Canlı Müzik";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bg-root: #0c0c0e;
            --bg-panel: #111113;
            --bg-surface: #1c1c1f;
            --bg-input: #1a1a1c;
            --accent: #c9a84c;
            --accent-dim: rgba(201,168,76,0.12);
            --accent-border: rgba(201,168,76,0.28);
            --accent-glow: 0 0 40px rgba(201,168,76,0.15);
            --text-1: #e8e8ea;
            --text-2: #8a8a94;
            --text-3: #46464e;
            --border: rgba(255,255,255,0.055);
            --border-hover: rgba(255,255,255,0.11);
            --radius-card: 20px;
            --radius-input: 10px;
            --radius-pill: 100px;
            --transition: 0.22s cubic-bezier(0.4,0,0.2,1);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
            font-family: 'Inter', sans-serif;
            background: var(--bg-root);
            color: var(--text-1);
            overflow: hidden;
        }

        /* ── LAYOUT ── */
        .page {
            height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* ── LEFT PANEL ── */
        .left-panel {
            position: relative;
            background: var(--bg-panel);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            padding: 40px 48px;
            overflow: hidden;
        }

            /* Subtle radial ambient */
            .left-panel::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 65% 55% at 20% 15%, rgba(201,168,76,0.1) 0%, transparent 60%), radial-gradient(ellipse 50% 60% at 80% 80%, rgba(201,168,76,0.06) 0%, transparent 55%);
                pointer-events: none;
            }

        /* Logo */
        .logo {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            margin-bottom: auto;
        }

        .logo-mark {
            width: 32px;
            height: 32px;
            background: var(--accent);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .logo-mark i {
                color: #0c0c0e;
                font-size: 1rem;
            }

        .logo-text {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 1rem;
            letter-spacing: -0.3px;
            color: var(--text-1);
        }

        /* Center content */
        .left-content {
            position: relative;
            z-index: 1;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 2rem 0;
        }

        /* Vinyl disc */
        .disc-wrap {
            width: 200px;
            height: 200px;
            margin: 0 auto 2.5rem;
            position: relative;
        }

        .disc-glow {
            position: absolute;
            inset: -20px;
            border-radius: 50%;
            background: conic-gradient( from 0deg, rgba(201,168,76,0.2), rgba(201,168,76,0.05), rgba(201,168,76,0.2), rgba(201,168,76,0.05) );
            animation: discSpin 10s linear infinite;
            filter: blur(14px);
        }

        .disc {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: repeating-radial-gradient( circle at center, #161618 0px, #161618 4px, #1e1e21 5px, #1e1e21 9px );
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 1;
            animation: discSpin 14s linear infinite;
            border: 1px solid rgba(255,255,255,0.06);
            box-shadow: 0 16px 50px rgba(0,0,0,0.6);
        }

        .disc-center {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            box-shadow: 0 0 20px rgba(201,168,76,0.5);
        }

        @@keyframes discSpin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .left-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: clamp(1.8rem, 2.5vw, 2.6rem);
            font-weight: 800;
            letter-spacing: -1.2px;
            line-height: 1.1;
            margin-bottom: 0.85rem;
            text-align: center;
        }

            .left-title .accent-word {
                color: var(--accent);
            }

        .left-desc {
            font-size: 0.85rem;
            color: var(--text-2);
            line-height: 1.7;
            text-align: center;
            max-width: 300px;
            margin: 0 auto;
        }

        /* Bottom now-playing card */
        .now-playing {
            position: relative;
            z-index: 1;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .np-cover {
            width: 42px;
            height: 42px;
            border-radius: 8px;
            background: var(--accent-dim);
            border: 1px solid var(--accent-border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .np-info {
            min-width: 0;
            flex: 1;
        }

        .np-song {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .np-artist {
            font-size: 0.7rem;
            color: var(--text-2);
            margin-top: 1px;
        }

        .np-bars {
            display: flex;
            align-items: center;
            gap: 2px;
        }

            .np-bars span {
                display: block;
                width: 2.5px;
                border-radius: 2px;
                background: var(--accent);
                animation: npBar 1.2s ease-in-out infinite;
            }

                .np-bars span:nth-child(1) {
                    height: 8px;
                    animation-delay: 0s;
                }

                .np-bars span:nth-child(2) {
                    height: 14px;
                    animation-delay: 0.1s;
                }

                .np-bars span:nth-child(3) {
                    height: 10px;
                    animation-delay: 0.2s;
                }

                .np-bars span:nth-child(4) {
                    height: 16px;
                    animation-delay: 0.3s;
                }

                .np-bars span:nth-child(5) {
                    height: 7px;
                    animation-delay: 0.4s;
                }

        @@keyframes npBar {
            0%, 100% {
                transform: scaleY(1);
            }

            50% {
                transform: scaleY(0.3);
            }
        }

        /* ── RIGHT PANEL ── */
        .right-panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 32px;
            background: var(--bg-root);
            overflow-y: auto;
        }

        .form-card {
            width: 100%;
            max-width: 400px;
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: var(--radius-card);
            padding: 36px 32px;
            position: relative;
            overflow: hidden;
            animation: cardIn 0.5s cubic-bezier(0.22,1,0.36,1) both;
        }

        @@keyframes cardIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Top amber line */
        .form-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 10%;
            right: 10%;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
        }

        .form-head {
            text-align: center;
            margin-bottom: 28px;
        }

        .form-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: var(--accent-dim);
            border: 1px solid var(--accent-border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin: 0 auto 14px;
        }

        .form-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: -0.6px;
            color: var(--text-1);
            margin-bottom: 5px;
        }

        .form-subtitle {
            font-size: 0.82rem;
            color: var(--text-2);
        }

        /* Validation summary */
        .validation-summary-errors {
            background: rgba(239,68,68,0.08);
            border: 1px solid rgba(239,68,68,0.25);
            border-radius: 10px;
            padding: 10px 14px;
            margin-bottom: 14px;
            font-size: 0.78rem;
            color: #f87171;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 16px;
            }

        .validation-summary-valid {
            display: none;
        }

        .field-validation-error {
            font-size: 0.72rem;
            color: #f87171;
        }

        /* Input group */
        .field {
            position: relative;
            margin-bottom: 12px;
        }

        .field-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-3);
            font-size: 0.85rem;
            pointer-events: none;
            z-index: 2;
            transition: color var(--transition);
        }

        .field:focus-within .field-icon {
            color: var(--accent);
        }

        .sw-input {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--border);
            color: var(--text-1);
            border-radius: var(--radius-input);
            padding: 11px 14px 11px 36px;
            font-size: 0.875rem;
            font-family: 'Inter', sans-serif;
            outline: none;
            transition: border-color var(--transition), box-shadow var(--transition);
        }

            .sw-input::placeholder {
                color: var(--text-3);
            }

            .sw-input:focus {
                border-color: var(--accent-border);
                box-shadow: 0 0 0 3px rgba(201,168,76,0.08);
            }

            .sw-input.has-toggle {
                padding-right: 40px;
            }

        .field.is-invalid .sw-input {
            border-color: rgba(239,68,68,0.5);
        }

        .field-error {
            font-size: 0.7rem;
            color: #f87171;
            padding-left: 2px;
            margin-top: 4px;
            display: none;
        }

        .field.is-invalid .field-error {
            display: block;
        }

        /* Eye toggle */
        .pw-eye {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-3);
            font-size: 0.9rem;
            cursor: pointer;
            padding: 4px;
            transition: color var(--transition);
            z-index: 2;
        }

            .pw-eye:hover {
                color: var(--text-2);
            }

        /* Extras row */
        .extras-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 8px;
        }

        .remember {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 0.78rem;
            color: var(--text-2);
            cursor: pointer;
        }

        .sw-check {
            width: 16px;
            height: 16px;
            border: 1.5px solid var(--border-hover);
            border-radius: 4px;
            background: var(--bg-input);
            appearance: none;
            -webkit-appearance: none;
            cursor: pointer;
            flex-shrink: 0;
            position: relative;
            transition: all var(--transition);
        }

            .sw-check:checked {
                background: var(--accent);
                border-color: var(--accent);
            }

                .sw-check:checked::after {
                    content: '';
                    position: absolute;
                    left: 3px;
                    top: 1px;
                    width: 6px;
                    height: 8px;
                    border: 2px solid #0c0c0e;
                    border-top: none;
                    border-left: none;
                    transform: rotate(40deg);
                }

        .forgot-link {
            font-size: 0.78rem;
            color: var(--accent);
            text-decoration: none;
            font-weight: 500;
            transition: opacity var(--transition);
        }

            .forgot-link:hover {
                opacity: 0.7;
            }

        /* Submit */
        .btn-submit {
            width: 100%;
            padding: 11px 20px;
            border: none;
            border-radius: var(--radius-pill);
            background: var(--accent);
            color: #0c0c0e;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: background var(--transition), transform 0.15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 20px;
            box-shadow: var(--accent-glow);
        }

            .btn-submit:hover {
                background: #d4b360;
                transform: translateY(-1px);
            }

            .btn-submit:active {
                transform: translateY(0);
            }

        .btn-arrow {
            transition: transform var(--transition);
        }

        .btn-submit:hover .btn-arrow {
            transform: translateX(3px);
        }

        /* Divider */
        .divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
            color: var(--text-3);
            font-size: 0.72rem;
        }

            .divider::before, .divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border);
            }

        /* Register link */
        .alt-link {
            text-align: center;
            font-size: 0.8rem;
            color: var(--text-2);
        }

            .alt-link a {
                color: var(--accent);
                text-decoration: none;
                font-weight: 600;
                transition: opacity var(--transition);
            }

                .alt-link a:hover {
                    opacity: 0.75;
                }

        /* Responsive */
        @@media (max-width: 800px) {
            .page {
                grid-template-columns: 1fr;
            }

            .left-panel {
                display: none;
            }

            .right-panel {
                min-height: 100vh;
            }
        }
    </style>
</head>
<body>
    <div class="page">

        <!-- ══ LEFT PANEL ══ -->
        <aside class="left-panel">
            <a href="#" class="logo">
                <div class="logo-mark"><i class="bi bi-soundwave"></i></div>
                <span class="logo-text">Canlı Müzik</span>
            </a>

            <div class="left-content">
                <div class="disc-wrap">
                    <div class="disc-glow"></div>
                    <div class="disc">
                        <div class="disc-center">🎵</div>
                    </div>
                </div>

                <h2 class="left-title">
                    Müziğin<br>
                    <span class="accent-word">Tam Ortasında</span><br>
                    Ol
                </h2>
                <p class="left-desc">
                    Giriş yap, kaldığın yerden devam et. Favori sanatçıların, şarkıların ve özel önerilerin seni bekliyor.
                </p>
            </div>

            <div class="now-playing">
                <div class="np-cover"><i class="bi bi-music-note-beamed" style="color:var(--accent)"></i></div>
                <div class="np-info">
                    <div class="np-song">Şu An Çalıyor</div>
                    <div class="np-artist">Canlı Müzik</div>
                </div>
                <div class="np-bars">
                    <span></span><span></span><span></span><span></span><span></span>
                </div>
            </div>
        </aside>

        <!-- ══ RIGHT PANEL ══ -->
        <section class="right-panel">
            <div class="form-card">

                <div class="form-head">
                    <div class="form-icon"><i class="bi bi-headphones" style="color:var(--accent)"></i></div>
                    <h1 class="form-title">Tekrar Hoşgeldiniz</h1>
                    <p class="form-subtitle">Dinlemeye devam etmek için giriş yapın.</p>
                </div>

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <form method="post" id="loginForm" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Kullanıcı adı -->
                    <div class="field" id="grp-username">
                        <i class="bi bi-at field-icon"></i>
                        <input asp-for="UserName"
                               class="sw-input"
                               type="text"
                               name="UserName"
                               id="UserName"
                               placeholder="Kullanıcı adı"
                               autocomplete="username">
                        <span asp-validation-for="UserName" class="field-validation-error field-error"></span>
                    </div>

                    <!-- Şifre -->
                    <div class="field" id="grp-password">
                        <i class="bi bi-lock field-icon"></i>
                        <input asp-for="Password"
                               class="sw-input has-toggle"
                               type="password"
                               name="Password"
                               id="Password"
                               placeholder="Şifre"
                               autocomplete="current-password">
                        <button type="button" class="pw-eye" onclick="togglePw()" title="Göster/Gizle">
                            <i class="bi bi-eye" id="pwIcon"></i>
                        </button>
                        <span asp-validation-for="Password" class="field-validation-error field-error"></span>
                    </div>

                    <!-- Beni hatırla + şifremi unuttum -->
                    <div class="extras-row">
                        <label class="remember">
                            <input type="checkbox" class="sw-check" name="RememberMe">
                            Beni Hatırla
                        </label>
                        <a href="#" class="forgot-link">Şifremi Unuttum</a>
                    </div>

                    <button type="submit" class="btn-submit">
                        <i class="bi bi-play-fill"></i>
                        Giriş Yap
                        <i class="bi bi-arrow-right btn-arrow"></i>
                    </button>

                    <div class="divider">veya</div>

                    <p class="alt-link">
                        Hesabınız yok mu?
                        <a asp-action="SignUp" asp-controller="Register">Ücretsiz kayıt ol</a>
                    </p>
                </form>
            </div>
        </section>

    </div>

    <script>
        function togglePw() {
            const pw   = document.getElementById('Password');
            const icon = document.getElementById('pwIcon');
            if (pw.type === 'password') { pw.type = 'text';     icon.className = 'bi bi-eye-slash'; }
            else                        { pw.type = 'password'; icon.className = 'bi bi-eye'; }
        }

        document.getElementById('loginForm').addEventListener('submit', function (e) {
            let valid = true;
            [{ id: 'UserName', grp: 'grp-username', msg: 'Kullanıcı adı gerekli.' },
             { id: 'Password', grp: 'grp-password', msg: 'Şifre gerekli.' }]
            .forEach(f => {
                const el  = document.getElementById(f.id);
                const grp = document.getElementById(f.grp);
                const err = grp.querySelector('.field-error, .field-validation-error');
                if (!el.value.trim()) {
                    grp.classList.add('is-invalid');
                    if (err && !err.textContent.trim()) err.textContent = f.msg;
                    if (err) err.style.display = 'block';
                    valid = false;
                } else {
                    grp.classList.remove('is-invalid');
                    if (err) err.style.display = 'none';
                }
            });
            if (!valid) e.preventDefault();
        });

        document.querySelectorAll('.sw-input').forEach(inp => {
            inp.addEventListener('input', () => {
                const grp = inp.closest('.field');
                if (!grp) return;
                grp.classList.remove('is-invalid');
                const err = grp.querySelector('.field-error, .field-validation-error');
                if (err) err.style.display = 'none';
            });
        });
    </script>
</body>
</html>
