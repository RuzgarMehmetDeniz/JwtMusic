@model List<dynamic>
@{
    Layout = null;
    var token = ViewBag.Token as string ?? "";
    var userRole = ViewBag.UserRole as string ?? "Basic";
    var error = ViewBag.Error as string ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Canlı Müzik — Önerilenler</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bg-root: #0c0c0e;
            --bg-sidebar: #111113;
            --bg-main: #0c0c0e;
            --bg-card: #181819;
            --bg-card-hover: #202022;
            --bg-surface: #1c1c1f;
            --bg-input: #1a1a1c;
            --accent: #c9a84c;
            --accent-dim: rgba(201,168,76,0.12);
            --accent-border: rgba(201,168,76,0.28);
            --accent-glow: 0 0 24px rgba(201,168,76,0.18);
            --text-1: #e8e8ea;
            --text-2: #8a8a94;
            --text-3: #46464e;
            --border: rgba(255,255,255,0.055);
            --border-hover: rgba(255,255,255,0.11);
            --sidebar-w: 224px;
            --player-h: 76px;
            --radius-card: 14px;
            --radius-sm: 8px;
            --radius-pill: 100px;
            --transition: 0.22s cubic-bezier(0.4,0,0.2,1);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        html {
            height: 100%
        }

        body {
            font-family: 'Inter',sans-serif;
            background: var(--bg-root);
            color: var(--text-1);
            height: 100%;
            overflow: hidden;
            display: grid;
            grid-template-columns: var(--sidebar-w) 1fr;
            grid-template-rows: 1fr var(--player-h);
            grid-template-areas: "sidebar main" "player player"
        }

        img {
            display: block
        }

        a {
            text-decoration: none;
            color: inherit
        }

        button {
            font-family: inherit;
            cursor: pointer
        }

        /* SIDEBAR */
        .sidebar {
            grid-area: sidebar;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            user-select: none
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 22px 20px 20px;
            border-bottom: 1px solid var(--border)
        }

        .logo-mark {
            width: 30px;
            height: 30px;
            background: var(--accent);
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0
        }

            .logo-mark i {
                color: #0c0c0e;
                font-size: .95rem
            }

        .logo-wordmark {
            font-family: 'Plus Jakarta Sans',sans-serif;
            font-weight: 800;
            font-size: .95rem;
            letter-spacing: -.3px;
            color: var(--text-1)
        }

        .sidebar-section {
            padding: 20px 12px 8px
        }

        .sidebar-label {
            font-size: .65rem;
            font-weight: 600;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--text-3);
            padding: 0 8px;
            margin-bottom: 6px
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 10px;
            border-radius: var(--radius-sm);
            color: var(--text-2);
            font-size: .855rem;
            font-weight: 500;
            cursor: pointer;
            transition: background var(--transition),color var(--transition);
            position: relative;
            text-decoration: none
        }

            .nav-item i {
                font-size: 1rem;
                width: 18px;
                flex-shrink: 0;
                text-align: center
            }

            .nav-item:hover {
                background: rgba(255,255,255,.04);
                color: var(--text-1)
            }

            .nav-item.active {
                color: var(--text-1);
                background: rgba(255,255,255,.05)
            }

                .nav-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 20%;
                    bottom: 20%;
                    width: 2.5px;
                    border-radius: 2px;
                    background: var(--accent)
                }

        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 8px 12px
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 16px 12px;
            border-top: 1px solid var(--border)
        }

        .user-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: var(--radius-sm)
        }

        .user-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--bg-surface);
            border: 1.5px solid var(--border-hover);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .75rem;
            font-weight: 700;
            color: var(--accent);
            flex-shrink: 0
        }

        .user-info {
            min-width: 0
        }

        .user-name {
            font-size: .8rem;
            font-weight: 600;
            color: var(--text-1)
        }

        .role-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: .62rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            padding: 2px 8px;
            border-radius: var(--radius-pill);
            margin-top: 2px
        }

            .role-pill.basic {
                background: rgba(255,255,255,.08);
                color: var(--text-2)
            }

            .role-pill.gold {
                background: rgba(201,168,76,.18);
                color: var(--accent)
            }

            .role-pill.premium {
                background: var(--accent);
                color: #0c0c0e
            }

            .role-pill.elit {
                background: linear-gradient(135deg,#a855f7,#7c3aed);
                color: #fff
            }

        /* MAIN */
        .main {
            grid-area: main;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            background: var(--bg-main);
            scrollbar-width: thin;
            scrollbar-color: var(--bg-surface) transparent
        }

            .main::-webkit-scrollbar {
                width: 5px
            }

            .main::-webkit-scrollbar-track {
                background: transparent
            }

            .main::-webkit-scrollbar-thumb {
                background: var(--bg-surface);
                border-radius: 4px
            }

        /* TOPBAR */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 28px;
            background: rgba(12,12,14,.88);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--border);
            gap: 16px
        }

        .topbar-breadcrumb {
            font-family: 'Plus Jakarta Sans',sans-serif;
            font-weight: 700;
            font-size: 1rem;
            color: var(--text-1);
            letter-spacing: -.3px
        }

        /* CONTENT */
        .content {
            padding: 28px 28px 40px;
            flex: 1
        }

        /* ML BANNER */
        .ml-banner {
            background: linear-gradient(135deg, rgba(201,168,76,0.08) 0%, rgba(201,168,76,0.03) 100%);
            border: 1px solid var(--accent-border);
            border-radius: var(--radius-card);
            padding: 20px 24px;
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .ml-banner-icon {
            width: 44px;
            height: 44px;
            background: var(--accent-dim);
            border: 1px solid var(--accent-border);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .ml-banner-text h3 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-1);
            margin-bottom: 3px;
        }

        .ml-banner-text p {
            font-size: 0.78rem;
            color: var(--text-2);
            line-height: 1.5;
        }

        .ml-badge {
            margin-left: auto;
            flex-shrink: 0;
            padding: 4px 12px;
            border-radius: var(--radius-pill);
            background: var(--accent-dim);
            border: 1px solid var(--accent-border);
            color: var(--accent);
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        /* PAGE HEADER */
        .page-header {
            margin-bottom: 24px
        }

            .page-header h1 {
                font-family: 'Plus Jakarta Sans',sans-serif;
                font-size: 1.75rem;
                font-weight: 800;
                letter-spacing: -.6px;
                color: var(--text-1);
                margin-bottom: 4px
            }

            .page-header p {
                font-size: .83rem;
                color: var(--text-2)
            }

        /* SONG GRID */
        .song-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(180px,1fr));
            gap: 14px
        }

        .song-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-card);
            overflow: hidden;
            cursor: pointer;
            transition: transform var(--transition),box-shadow var(--transition),border-color var(--transition);
            position: relative
        }

            .song-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 16px 40px rgba(0,0,0,.55);
                border-color: rgba(201,168,76,.22)
            }

            .song-card.locked {
                opacity: .6;
                cursor: not-allowed
            }

                .song-card.locked:hover {
                    transform: none;
                    box-shadow: none;
                    border-color: var(--border)
                }

                .song-card.locked::after {
                    display: none
                }

            .song-card:not(.locked)::after {
                content: '';
                position: absolute;
                inset: 0;
                border-radius: var(--radius-card);
                border: 1.5px solid var(--accent);
                opacity: 0;
                transition: opacity var(--transition);
                pointer-events: none
            }

            .song-card:not(.locked):hover::after {
                opacity: 1
            }

        /* Öneri sırası rozeti */
        .rank-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.65rem;
            font-weight: 800;
            color: var(--accent);
            z-index: 2;
            border: 1px solid var(--accent-border);
        }

        .card-img-wrap {
            position: relative;
            width: 100%;
            aspect-ratio: 1;
            overflow: hidden;
            background: var(--bg-surface)
        }

        .card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .38s cubic-bezier(.25,.8,.25,1);
            display: block
        }

        .song-card:not(.locked):hover .card-img {
            transform: scale(1.06)
        }

        .img-fallback {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            background: linear-gradient(145deg,#1e1e22,#2a2a30)
        }

        .card-badge {
            position: absolute;
            top: 8px;
            left: 8px;
            padding: 3px 8px;
            border-radius: var(--radius-pill);
            font-size: .62rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            backdrop-filter: blur(6px);
            z-index: 2
        }

            .card-badge.basic {
                background: rgba(255,255,255,.12);
                color: var(--text-2)
            }

            .card-badge.gold {
                background: rgba(201,168,76,.85);
                color: #0c0c0e
            }

            .card-badge.premium {
                background: rgba(160,80,240,.85);
                color: #fff
            }

            .card-badge.elit {
                background: linear-gradient(135deg,rgba(168,85,247,.9),rgba(124,58,237,.9));
                color: #fff
            }

        .card-lock {
            position: absolute;
            bottom: 8px;
            right: 8px;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: rgba(0,0,0,.6);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .7rem;
            color: var(--text-2);
            z-index: 2
        }

        .card-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top,rgba(0,0,0,.65) 0%,transparent 55%);
            opacity: 0;
            transition: opacity var(--transition);
            display: flex;
            align-items: flex-end;
            justify-content: flex-end;
            padding: 12px
        }

        .song-card:not(.locked):hover .card-overlay {
            opacity: 1
        }

        .overlay-btn-play {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--accent);
            border: none;
            color: #0c0c0e;
            font-size: .95rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background var(--transition),transform .15s
        }

            .overlay-btn-play:hover {
                background: #d4b360;
                transform: scale(1.1)
            }

        .card-body {
            padding: 12px 13px 13px
        }

        .card-name {
            font-family: 'Plus Jakarta Sans',sans-serif;
            font-size: .9rem;
            font-weight: 700;
            letter-spacing: -.2px;
            color: var(--text-1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 2px
        }

        .card-artist {
            font-size: .72rem;
            color: var(--text-2);
            margin-bottom: 10px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis
        }

        .card-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px
        }

        .card-duration {
            font-size: .7rem;
            color: var(--text-3);
            display: flex;
            align-items: center;
            gap: 4px
        }

            .card-duration i {
                color: var(--accent);
                font-size: .65rem
            }

        .card-locked-label {
            font-size: .7rem;
            color: var(--text-3);
            display: flex;
            align-items: center;
            gap: 4px
        }

        /* PKG MODAL */
        .pkg-modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 999;
            background: rgba(0,0,0,.72);
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(5px)
        }

            .pkg-modal.show {
                display: flex
            }

        .pkg-modal-box {
            background: var(--bg-card);
            border: 1px solid var(--accent-border);
            border-radius: var(--radius-card);
            padding: 36px 32px;
            max-width: 360px;
            width: 90%;
            text-align: center;
            box-shadow: var(--accent-glow),0 24px 60px rgba(0,0,0,.6)
        }

        .pkg-modal-icon {
            font-size: 2.2rem;
            color: var(--accent);
            margin-bottom: 14px;
            display: block
        }

        .pkg-modal-title {
            font-family: 'Plus Jakarta Sans',sans-serif;
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-1);
            margin-bottom: 8px
        }

        .pkg-modal-text {
            font-size: .83rem;
            color: var(--text-2);
            line-height: 1.65;
            margin-bottom: 8px
        }

        .pkg-modal-roles {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin: 14px 0 20px
        }

        .role-tag {
            padding: 4px 12px;
            border-radius: var(--radius-pill);
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .05em
        }

            .role-tag.current {
                background: rgba(255,255,255,.07);
                color: var(--text-2)
            }

            .role-tag.required {
                background: rgba(160,80,240,.2);
                color: #c084fc;
                border: 1px solid rgba(160,80,240,.35)
            }

                .role-tag.required.gold {
                    background: var(--accent-dim);
                    color: var(--accent);
                    border: 1px solid var(--accent-border)
                }

        .pkg-modal-arrow {
            color: var(--text-3);
            font-size: .8rem
        }

        .pkg-modal-actions {
            display: flex;
            gap: 8px;
            justify-content: center
        }

        .pkg-modal-btn {
            padding: 9px 22px;
            border-radius: var(--radius-pill);
            background: var(--accent);
            border: none;
            color: #0c0c0e;
            font-weight: 700;
            font-size: .85rem;
            cursor: pointer;
            transition: background var(--transition)
        }

            .pkg-modal-btn:hover {
                background: #d4b360
            }

        .pkg-modal-btn-ghost {
            padding: 9px 18px;
            border-radius: var(--radius-pill);
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-2);
            font-size: .85rem;
            cursor: pointer;
            transition: all var(--transition)
        }

            .pkg-modal-btn-ghost:hover {
                background: var(--bg-surface);
                color: var(--text-1)
            }

        /* EMPTY STATE */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 5rem 2rem;
            color: var(--text-3)
        }

            .empty-state i {
                font-size: 2.5rem;
                margin-bottom: 14px;
                display: block
            }

            .empty-state strong {
                font-size: 1rem;
                color: var(--text-2);
                font-family: 'Plus Jakarta Sans',sans-serif;
                margin-bottom: 6px;
                display: block
            }

            .empty-state p {
                font-size: .83rem;
                color: var(--text-3);
                max-width: 280px;
                line-height: 1.6
            }

            .empty-state a {
                margin-top: 16px;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 9px 20px;
                border-radius: var(--radius-pill);
                background: var(--accent);
                color: #0c0c0e;
                font-size: .82rem;
                font-weight: 700;
                transition: background var(--transition)
            }

                .empty-state a:hover {
                    background: #d4b360
                }

        /* PLAYER */
        .player {
            grid-area: player;
            background: #111113;
            border-top: 1px solid var(--border);
            display: grid;
            grid-template-columns: 280px 1fr 280px;
            align-items: center;
            padding: 0 20px;
            gap: 12px;
            z-index: 100
        }

        .player-track {
            display: flex;
            align-items: center;
            gap: 11px;
            min-width: 0
        }

        .player-cover {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-sm);
            background: var(--bg-surface);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
            overflow: hidden
        }

            .player-cover img {
                width: 100%;
                height: 100%;
                object-fit: cover
            }

        .player-info {
            min-width: 0;
            flex: 1
        }

        .player-song {
            font-size: .82rem;
            font-weight: 600;
            color: var(--text-1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-family: 'Plus Jakarta Sans',sans-serif
        }

        .player-artist {
            font-size: .72rem;
            color: var(--text-2);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 1px
        }

        .player-like-btn {
            background: none;
            border: none;
            color: var(--text-3);
            font-size: .9rem;
            cursor: pointer;
            padding: 5px;
            transition: color var(--transition);
            flex-shrink: 0
        }

            .player-like-btn:hover, .player-like-btn.liked {
                color: var(--accent)
            }

        .waveform {
            display: flex;
            align-items: center;
            gap: 2px;
            height: 14px
        }

            .waveform span {
                display: block;
                width: 2.5px;
                border-radius: 2px;
                background: var(--accent);
                animation: wv 1.1s ease-in-out infinite
            }

                .waveform span:nth-child(1) {
                    height: 5px;
                    animation-delay: 0s
                }

                .waveform span:nth-child(2) {
                    height: 12px;
                    animation-delay: .1s
                }

                .waveform span:nth-child(3) {
                    height: 8px;
                    animation-delay: .2s
                }

                .waveform span:nth-child(4) {
                    height: 14px;
                    animation-delay: .3s
                }

                .waveform span:nth-child(5) {
                    height: 6px;
                    animation-delay: .4s
                }

        @@keyframes wv {
            0%, 100% {
                transform: scaleY(1)
            }

            50% {
                transform: scaleY(.3)
            }
        }

        .waveform.paused span {
            animation-play-state: paused
        }

        .player-center {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 7px
        }

        .player-controls {
            display: flex;
            align-items: center;
            gap: 4px
        }

        .ctrl-btn {
            background: none;
            border: none;
            color: var(--text-2);
            font-size: .9rem;
            cursor: pointer;
            padding: 0;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color var(--transition),background var(--transition)
        }

            .ctrl-btn:hover {
                color: var(--text-1);
                background: rgba(255,255,255,.05)
            }

        .ctrl-btn-play {
            width: 38px;
            height: 38px;
            background: var(--text-1);
            color: var(--bg-root);
            font-size: 1rem;
            border-radius: 50%;
            transition: transform .15s,background var(--transition)
        }

            .ctrl-btn-play:hover {
                background: #fff;
                transform: scale(1.05)
            }

        .player-progress {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            max-width: 440px
        }

        .time-lbl {
            font-size: .65rem;
            color: var(--text-3);
            min-width: 30px;
            text-align: center;
            font-variant-numeric: tabular-nums
        }

        .progress-track {
            flex: 1;
            height: 3px;
            background: rgba(255,255,255,.08);
            border-radius: 3px;
            cursor: pointer
        }

            .progress-track:hover {
                height: 4px
            }

        .progress-fill {
            height: 100%;
            border-radius: 3px;
            background: var(--text-1);
            width: 0%;
            position: relative;
            transition: width .1s linear
        }

        .progress-track:hover .progress-fill {
            background: var(--accent)
        }

        .progress-fill::after {
            content: '';
            position: absolute;
            right: -4px;
            top: 50%;
            transform: translateY(-50%) scale(0);
            width: 9px;
            height: 9px;
            background: #fff;
            border-radius: 50%;
            transition: transform .15s
        }

        .progress-track:hover .progress-fill::after {
            transform: translateY(-50%) scale(1)
        }

        .player-right {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px
        }

            .player-right .ctrl-btn {
                font-size: .85rem
            }

        .vol-wrap {
            display: flex;
            align-items: center;
            gap: 6px
        }

        .vol-btn {
            background: none;
            border: none;
            color: var(--text-2);
            font-size: .9rem;
            cursor: pointer;
            padding: 4px;
            transition: color var(--transition)
        }

            .vol-btn:hover {
                color: var(--text-1)
            }

        .vol-track {
            width: 78px;
            height: 3px;
            background: rgba(255,255,255,.08);
            border-radius: 3px;
            cursor: pointer
        }

        .vol-fill {
            height: 100%;
            border-radius: 3px;
            background: rgba(255,255,255,.3);
            width: 70%;
            transition: background var(--transition)
        }

        .vol-track:hover .vol-fill {
            background: var(--text-1)
        }

        @@media(max-width:900px) {
            body {
                grid-template-columns: 1fr;
                grid-template-rows: 52px 1fr var(--player-h);
                grid-template-areas: "sidebar" "main" "player"
            }

            .sidebar {
                flex-direction: row;
                border-right: none;
                border-bottom: 1px solid var(--border);
                overflow-x: auto
            }

            .sidebar-logo {
                padding: 12px 16px;
                border-bottom: none;
                border-right: 1px solid var(--border)
            }

            .sidebar-section {
                display: flex;
                flex-direction: row;
                padding: 8px;
                gap: 2px;
                align-items: center
            }

            .sidebar-label, .sidebar-divider, .sidebar-footer {
                display: none
            }

            .nav-item.active::before {
                top: auto;
                left: 20%;
                right: 20%;
                bottom: 0;
                height: 2px;
                width: auto
            }

            .player {
                grid-template-columns: 1fr auto
            }

            .player-right {
                display: none
            }
        }

        @@media(max-width:600px) {
            .song-grid {
                grid-template-columns: repeat(2,1fr);
                gap: 10px
            }

            .content {
                padding: 16px 14px 28px
            }

            .topbar {
                padding: 10px 14px
            }
        }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-mark"><i class="bi bi-soundwave"></i></div>
            <span class="logo-wordmark">Canlı Müzik</span>
        </div>
        <nav class="sidebar-section">
            <span class="sidebar-label">Keşfet</span>
            <a href="/Artist/ArtistList" class="nav-item"><i class="bi bi-people"></i> Sanatçılar</a>
            <a href="/Song/SongList" class="nav-item"><i class="bi bi-music-note-list"></i> Şarkılar</a>
            <a href="/Recommendation/Index" class="nav-item active"><i class="bi bi-stars"></i> Önerilenler</a>
        </nav>
        <div class="sidebar-divider"></div>
        <nav class="sidebar-section">
            <span class="sidebar-label">Kitaplık</span>
            <a href="#" class="nav-item"><i class="bi bi-heart"></i> Beğendiklerim</a>
            <a href="#" class="nav-item"><i class="bi bi-collection-play"></i> Çalma Listeleri</a>
            <a href="/History/Index" class="nav-item"><i class="bi bi-clock-history"></i> Dinleme Geçmişi</a>
        </nav>
        <div class="sidebar-footer">
            <div class="user-row">
                <div class="user-avatar">@userRole.Substring(0, 1).ToUpper()</div>
                <div class="user-info">
                    <div class="user-name">Hesabım</div>
                    @{
                        var roleLower = userRole.ToLower();
                        var roleCss = roleLower == "elit" ? "elit" : roleLower == "premium" ? "premium" : roleLower == "gold" ? "gold" : "basic";
                        var roleIcon = roleLower == "elit" ? "bi-gem" : roleLower == "premium" ? "bi-star-fill" : roleLower == "gold" ? "bi-star-half" : "bi-person";
                    }
                    <div class="role-pill @roleCss"><i class="bi @roleIcon"></i> @userRole</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="main">
        <header class="topbar">
            <div class="topbar-breadcrumb">Önerilenler</div>
        </header>

        <div class="content">
            <div class="page-header">
                <h1>Bunları da Sevebilirsiniz</h1>
                <p>Dinleme geçmişiniz analiz edilerek sizin için seçildi.</p>
            </div>

            <!-- ML Banner -->
            <div class="ml-banner">
                <div class="ml-banner-icon"><i class="bi bi-cpu"></i></div>
                <div class="ml-banner-text">
                    <h3>ML.NET Yapay Zeka Analizi</h3>
                    <p>Dinleme alışkanlıklarınız Matrix Factorization algoritmasıyla analiz edildi. Aşağıdaki öneriler size özel hesaplandı.</p>
                </div>
                <span class="ml-badge">AI Powered</span>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="empty-state">
                    <i class="bi bi-exclamation-circle"></i>
                    <strong>Öneriler yüklenemedi</strong>
                    <p>@error</p>
                    <a href="/Song/SongList"><i class="bi bi-music-note-list"></i> Şarkılara Git</a>
                </div>
            }
            else if (Model == null || !Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-stars"></i>
                    <strong>Henüz öneri yok</strong>
                    <p>Daha fazla şarkı dinledikçe size özel öneriler burada görünecek.</p>
                    <a href="/Song/SongList"><i class="bi bi-music-note-list"></i> Şarkı Keşfet</a>
                </div>
            }
            else
            {
                <!-- Şarkı grid -->
                <div class="song-grid" id="songGrid">
                    @{
                        int rankCounter = 1;

                        int RoleLevel(string r) => r.ToLower() switch
                        {
                            "elit" => 4,
                            "premium" => 3,
                            "gold" => 2,
                            _ => 1
                        };
                    }

                    @foreach (var song in Model)
                    {
                        var reqRole = (string)(song.requiredRoleName ?? "Basic");
                        var canAccess = RoleLevel(userRole) >= RoleLevel(reqRole);
                        var badgeCss = RoleLevel(reqRole) == 4 ? "elit" : RoleLevel(reqRole) == 3 ? "premium" : RoleLevel(reqRole) == 2 ? "gold" : "basic";
                        var songId = (string)(song.songId?.ToString() ?? "0");
                        var title = (string)(song.title ?? "");
                        var artist = (string)(song.artistName ?? "");
                        var cover = (string)(song.coverImageUrl ?? "");
                        var audio = (string)(song.audioUrl ?? "");
                        var duration = (string)(song.duration ?? "");

                        <div class="song-card @(canAccess ? "" : "locked")"
                             data-can-access="@canAccess.ToString().ToLower()"
                             data-song-id="@songId"
                             data-title="@Html.Raw(title.Replace("\"", "&quot;"))"
                             data-artist="@Html.Raw(artist.Replace("\"", "&quot;"))"
                             data-cover="@cover"
                             data-audio="@audio"
                             data-required-role="@reqRole"
                             onclick="handleCardClick(this)">

                            <div class="card-img-wrap">
                                <div class="rank-badge">#@rankCounter</div>

                                @if (!string.IsNullOrEmpty(cover))
                                {
                                    <img src="@cover" class="card-img" alt="@title" loading="lazy"
                                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                                    <div class="img-fallback" style="display:none">🎵</div>
                                }
                                else
                                {
                                    <div class="img-fallback">🎵</div>
                                }

                                @if (canAccess)
                                {
                                    <div class="card-overlay">
                                        <button type="button" class="overlay-btn-play">
                                            <i class="bi bi-play-fill"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="card-lock"><i class="bi bi-lock-fill"></i></div>
                                }
                            </div>

                            <div class="card-body">
                                <h3 class="card-name">@title</h3>
                                <p class="card-artist">@artist</p>
                                <div class="card-meta">
                                    @if (canAccess)
                                    {
                                        <span class="card-duration">
                                            <i class="bi bi-clock"></i> @duration
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="card-locked-label">
                                            <i class="bi bi-lock" style="color:var(--text-3)"></i> @reqRole gerekli
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        rankCounter++;
                    }
                </div>
            }
        </div>
    </main>

    <!-- PLAYER -->
    <footer class="player">
        <div class="player-track">
            <div class="player-cover" id="playerCover">🎵</div>
            <div class="player-info">
                <div class="player-song" id="playerSong">Oynatılmıyor</div>
                <div class="player-artist" id="playerArtist">Bir şarkı seçin</div>
            </div>
            <button class="player-like-btn" onclick="toggleHeart(this)" title="Beğen">
                <i class="bi bi-heart"></i>
            </button>
            <div class="waveform paused" id="waveform">
                <span></span><span></span><span></span><span></span><span></span>
            </div>
        </div>
        <div class="player-center">
            <div class="player-controls">
                <button class="ctrl-btn" title="Karıştır"><i class="bi bi-shuffle"></i></button>
                <button class="ctrl-btn" onclick="playPrev()" title="Önceki"><i class="bi bi-skip-start-fill"></i></button>
                <button class="ctrl-btn ctrl-btn-play" onclick="togglePlay()" title="Oynat/Durdur">
                    <i id="playIcon" class="bi bi-play-fill"></i>
                </button>
                <button class="ctrl-btn" onclick="playNext()" title="Sonraki"><i class="bi bi-skip-end-fill"></i></button>
                <button class="ctrl-btn" title="Tekrarla"><i class="bi bi-repeat"></i></button>
            </div>
            <div class="player-progress">
                <span class="time-lbl" id="currentTime">0:00</span>
                <div class="progress-track" id="progressBar" onclick="seekTo(event)">
                    <div class="progress-fill" id="progressFill"></div>
                </div>
                <span class="time-lbl" id="totalTime">0:00</span>
            </div>
        </div>
        <div class="player-right">
            <div class="vol-wrap">
                <button class="vol-btn" onclick="toggleMute()" title="Ses">
                    <i id="volIcon" class="bi bi-volume-up-fill"></i>
                </button>
                <div class="vol-track" id="volTrack" onclick="setVolume(event)">
                    <div class="vol-fill" id="volFill" style="width:70%"></div>
                </div>
            </div>
        </div>
    </footer>

    <!-- PKG MODAL -->
    <div id="pkgModal" class="pkg-modal" onclick="closeModalOnBackdrop(event)">
        <div class="pkg-modal-box">
            <i class="bi bi-shield-lock-fill pkg-modal-icon"></i>
            <h2 class="pkg-modal-title">Bu İçerik Kilitli</h2>
            <p class="pkg-modal-text">Bu şarkıyı dinlemek için daha yüksek bir üyelik paketi gerekiyor.</p>
            <div class="pkg-modal-roles">
                <span class="role-tag current" id="modalCurrentRole">Basic</span>
                <span class="pkg-modal-arrow"><i class="bi bi-arrow-right"></i></span>
                <span class="role-tag required" id="modalRequiredRole">Premium</span>
            </div>
            <div class="pkg-modal-actions">
                <button class="pkg-modal-btn-ghost" onclick="closePkgModal()">Kapat</button>
                <button class="pkg-modal-btn">Paketi Yükselt</button>
            </div>
        </div>
    </div>

    <div id="ytPlayer" style="position:absolute;width:0;height:0;pointer-events:none;opacity:0"></div>

    <script>
        const USER_ROLE = "@userRole";
        const API_BASE  = "https://localhost:7185";
        const TOKEN     = "@token";

        const ROLE_LEVEL = { basic:1, gold:2, premium:3, elit:4 };
        function getRoleLevel(role) { return ROLE_LEVEL[(role||'').toLowerCase()] ?? 1; }
        function canUserAccess(r)   { return getRoleLevel(USER_ROLE) >= getRoleLevel(r); }

        /* ── Önerilen şarkı listesi (prev/next) ── */
        const REC_SONGS = [];
        @if (Model != null)
        {
                foreach (var song in Model)
                {
                        var reqRole = (string)(song.requiredRoleName ?? "Basic");
                        <text>
                        REC_SONGS.push({
                            songId:        '@(song.songId)',
                            title:         '@Html.Raw(((string)(song.title ?? "")).Replace("'", "\\'"))',
                            artistName:    '@Html.Raw(((string)(song.artistName ?? "")).Replace("'", "\\'"))',
                            coverImageUrl: '@(song.coverImageUrl ?? "")',
                            audioUrl:      '@(song.audioUrl ?? "")',
                            requiredRole:  '@reqRole'
                        });
                        </text>
                }
        }

        const PLAYABLE = REC_SONGS.filter(s => canUserAccess(s.requiredRole));
        let currentIdx = -1;

        /* ── Geçmişe kaydet ── */
        async function saveToHistory(songId) {
            try {
                await fetch(`${API_BASE}/api/ListeningHistory`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${TOKEN}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ songId: parseInt(songId) })
                });
            } catch(err) { console.error('saveToHistory:', err); }
        }

        /* ── Kart tıklama ── */
        function handleCardClick(card) {
            const canAccess    = card.getAttribute('data-can-access') === 'true';
            const requiredRole = card.getAttribute('data-required-role');
            if (!canAccess) { showPkgModal(requiredRole); return; }
            playSong(
                card.getAttribute('data-song-id'),
                card.getAttribute('data-title'),
                card.getAttribute('data-artist'),
                card.getAttribute('data-cover'),
                card.getAttribute('data-audio'),
                requiredRole
            );
        }

        /* ── Oynatma ── */
        function playSong(songId, title, artist, coverUrl, audioUrl, requiredRole) {
            if (!canUserAccess(requiredRole)) { showPkgModal(requiredRole); return; }

            const idx = PLAYABLE.findIndex(s => String(s.songId) === String(songId));
            if (idx !== -1) currentIdx = idx;

            document.getElementById('playerSong').textContent   = title;
            document.getElementById('playerArtist').textContent = artist;
            const coverEl = document.getElementById('playerCover');
            coverEl.innerHTML = coverUrl
                ? `<img src="${coverUrl}" alt="${title}" onerror="this.parentElement.textContent='🎵'">`
                : '🎵';

            const videoId = getYoutubeId(audioUrl);
            if (!videoId) { console.error('Geçersiz URL:', audioUrl); return; }

            if (ytReady && ytPlayer?.loadVideoById) {
                ytPlayer.loadVideoById(videoId);
            } else {
                pendingVideoId = videoId;
            }

            saveToHistory(songId);
        }

        function playNext() {
            if (!PLAYABLE.length) return;
            currentIdx = (currentIdx + 1) % PLAYABLE.length;
            const s = PLAYABLE[currentIdx];
            playSong(s.songId, s.title, s.artistName, s.coverImageUrl, s.audioUrl, s.requiredRole);
        }

        function playPrev() {
            if (!PLAYABLE.length) return;
            currentIdx = (currentIdx - 1 + PLAYABLE.length) % PLAYABLE.length;
            const s = PLAYABLE[currentIdx];
            playSong(s.songId, s.title, s.artistName, s.coverImageUrl, s.audioUrl, s.requiredRole);
        }

        /* ── Modal ── */
        function showPkgModal(requiredRole) {
            document.getElementById('modalCurrentRole').textContent  = USER_ROLE;
            document.getElementById('modalRequiredRole').textContent = requiredRole;
            const reqTag = document.getElementById('modalRequiredRole');
            reqTag.className = 'role-tag required' + (requiredRole.toLowerCase() === 'gold' ? ' gold' : '');
            document.getElementById('pkgModal').classList.add('show');
        }
        function closePkgModal() { document.getElementById('pkgModal').classList.remove('show'); }
        function closeModalOnBackdrop(e) { if (e.target === document.getElementById('pkgModal')) closePkgModal(); }

        /* ── YouTube API ── */
        var tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        document.head.appendChild(tag);

        let ytPlayer, ytReady = false, pendingVideoId = null;
        let volumeVal = 70, isMuted = false, progressInterval;

        function onYouTubeIframeAPIReady() {
            ytPlayer = new YT.Player('ytPlayer', {
                height: '0', width: '0',
                playerVars: { controls: 0, disablekb: 1, rel: 0 },
                events: {
                    onReady: function () {
                        ytReady = true; ytPlayer.setVolume(volumeVal);
                        document.getElementById('volFill').style.width = volumeVal + '%';
                        if (pendingVideoId) { ytPlayer.loadVideoById(pendingVideoId); pendingVideoId = null; }
                    },
                    onStateChange: function (e) {
                        if (e.data === YT.PlayerState.PLAYING) {
                            document.getElementById('playIcon').className = 'bi bi-pause-fill';
                            document.getElementById('waveform').classList.remove('paused');
                            startProgressLoop();
                        } else if (e.data === YT.PlayerState.PAUSED || e.data === YT.PlayerState.BUFFERING) {
                            document.getElementById('playIcon').className = 'bi bi-play-fill';
                            document.getElementById('waveform').classList.add('paused');
                            clearInterval(progressInterval);
                        } else if (e.data === YT.PlayerState.ENDED) { playNext(); }
                    },
                    onError: function (e) { console.error('YT hata:', e.data); }
                }
            });
        }

        function togglePlay() {
            if (!ytPlayer?.getPlayerState) return;
            const s = ytPlayer.getPlayerState();
            if (s === YT.PlayerState.PLAYING) ytPlayer.pauseVideo();
            else ytPlayer.playVideo();
        }

        function startProgressLoop() {
            clearInterval(progressInterval);
            progressInterval = setInterval(() => {
                if (!ytPlayer?.getCurrentTime) return;
                const cur = ytPlayer.getCurrentTime(), dur = ytPlayer.getDuration();
                if (dur > 0) {
                    document.getElementById('progressFill').style.width = (cur/dur*100) + '%';
                    document.getElementById('currentTime').textContent  = formatTime(cur);
                    document.getElementById('totalTime').textContent    = formatTime(dur);
                }
            }, 500);
        }

        function seekTo(e) {
            if (!ytPlayer?.getDuration) return;
            const rect  = document.getElementById('progressBar').getBoundingClientRect();
            const ratio = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
            ytPlayer.seekTo(ratio * ytPlayer.getDuration(), true);
            document.getElementById('progressFill').style.width = (ratio * 100) + '%';
        }

        function setVolume(e) {
            if (!ytPlayer?.setVolume) return;
            const rect = document.getElementById('volTrack').getBoundingClientRect();
            volumeVal  = Math.min(100, Math.max(0, ((e.clientX - rect.left) / rect.width) * 100));
            isMuted = false; ytPlayer.unMute(); ytPlayer.setVolume(volumeVal);
            document.getElementById('volFill').style.width = volumeVal + '%';
            updateVolIcon();
        }

        function toggleMute() {
            if (!ytPlayer) return;
            if (ytPlayer.isMuted()) {
                ytPlayer.unMute(); ytPlayer.setVolume(volumeVal);
                document.getElementById('volFill').style.width = volumeVal + '%'; isMuted = false;
            } else {
                ytPlayer.mute(); document.getElementById('volFill').style.width = '0%'; isMuted = true;
            }
            updateVolIcon();
        }

        function updateVolIcon() {
            document.getElementById('volIcon').className =
                isMuted || volumeVal === 0 ? 'bi bi-volume-mute-fill' : 'bi bi-volume-up-fill';
        }

        function toggleHeart(btn) {
            btn.classList.toggle('liked');
            btn.querySelector('i').className = btn.classList.contains('liked') ? 'bi bi-heart-fill' : 'bi bi-heart';
        }

        function formatTime(secs) {
            const m = Math.floor(secs/60), s = Math.floor(secs%60);
            return m + ':' + String(s).padStart(2,'0');
        }

        function getYoutubeId(url) {
            if (!url) return null;
            if (url.length === 11 && !url.includes('/') && !url.includes('?')) return url;
            const m = url.match(/^.*(youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/);
            return (m && m[2].length === 11) ? m[2] : null;
        }
    </script>
</body>
</html>
