@model List<JwtMusic.WebUI.Dtos.ListeningHistoryDtos.ResultListeningHistoryDto>
@{
    Layout = null;
    var token    = ViewBag.Token    as string ?? "";
    var userRole = ViewBag.UserRole as string ?? "Basic";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Canlı Müzik — Dinleme Geçmişi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bg-root:        #0c0c0e;
            --bg-sidebar:     #111113;
            --bg-main:        #0c0c0e;
            --bg-card:        #181819;
            --bg-card-hover:  #202022;
            --bg-surface:     #1c1c1f;
            --bg-input:       #1a1a1c;
            --accent:         #c9a84c;
            --accent-dim:     rgba(201,168,76,0.12);
            --accent-border:  rgba(201,168,76,0.28);
            --accent-glow:    0 0 24px rgba(201,168,76,0.18);
            --text-1:         #e8e8ea;
            --text-2:         #8a8a94;
            --text-3:         #46464e;
            --border:         rgba(255,255,255,0.055);
            --border-hover:   rgba(255,255,255,0.11);
            --sidebar-w:      224px;
            --player-h:       76px;
            --radius-card:    14px;
            --radius-sm:      8px;
            --radius-pill:    100px;
            --transition:     0.22s cubic-bezier(0.4,0,0.2,1);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { height: 100%; }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-root);
            color: var(--text-1);
            height: 100%;
            overflow: hidden;
            display: grid;
            grid-template-columns: var(--sidebar-w) 1fr;
            grid-template-rows: 1fr var(--player-h);
            grid-template-areas: "sidebar main" "player player";
        }

        img { display: block; }
        a   { text-decoration: none; color: inherit; }
        button { font-family: inherit; cursor: pointer; }

        /* ─── SIDEBAR ─────────────────────────────────── */
        .sidebar {
            grid-area: sidebar;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            user-select: none;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 22px 20px 20px;
            border-bottom: 1px solid var(--border);
        }

        .logo-mark {
            width: 30px; height: 30px;
            background: var(--accent);
            border-radius: 7px;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .logo-mark i { color: #0c0c0e; font-size: 0.95rem; }

        .logo-wordmark {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800; font-size: 0.95rem;
            letter-spacing: -0.3px; color: var(--text-1);
        }

        .sidebar-section { padding: 20px 12px 8px; }

        .sidebar-label {
            font-size: 0.65rem; font-weight: 600;
            letter-spacing: 0.1em; text-transform: uppercase;
            color: var(--text-3); padding: 0 8px; margin-bottom: 6px;
        }

        .nav-item {
            display: flex; align-items: center; gap: 10px;
            padding: 9px 10px; border-radius: var(--radius-sm);
            color: var(--text-2); font-size: 0.855rem; font-weight: 500;
            cursor: pointer; transition: background var(--transition), color var(--transition);
            position: relative; text-decoration: none;
        }
        .nav-item i { font-size: 1rem; width: 18px; flex-shrink: 0; text-align: center; }
        .nav-item:hover { background: rgba(255,255,255,0.04); color: var(--text-1); }
        .nav-item.active { color: var(--text-1); background: rgba(255,255,255,0.05); }
        .nav-item.active::before {
            content: ''; position: absolute;
            left: 0; top: 20%; bottom: 20%;
            width: 2.5px; border-radius: 2px; background: var(--accent);
        }

        .sidebar-divider { height: 1px; background: var(--border); margin: 8px 12px; }

        .sidebar-footer { margin-top: auto; padding: 16px 12px; border-top: 1px solid var(--border); }

        .user-row {
            display: flex; align-items: center; gap: 10px;
            padding: 8px 10px; border-radius: var(--radius-sm);
        }

        .user-avatar {
            width: 30px; height: 30px; border-radius: 50%;
            background: var(--bg-surface); border: 1.5px solid var(--border-hover);
            display: flex; align-items: center; justify-content: center;
            font-size: 0.75rem; font-weight: 700; color: var(--accent); flex-shrink: 0;
        }

        .user-info { min-width: 0; }
        .user-name { font-size: 0.8rem; font-weight: 600; color: var(--text-1); }

        .role-pill {
            display: inline-flex; align-items: center; gap: 4px;
            font-size: 0.62rem; font-weight: 700; letter-spacing: 0.06em;
            text-transform: uppercase; padding: 2px 8px;
            border-radius: var(--radius-pill); margin-top: 2px;
        }
        .role-pill.basic   { background: rgba(255,255,255,0.08); color: var(--text-2); }
        .role-pill.gold    { background: rgba(201,168,76,0.18);  color: var(--accent); }
        .role-pill.premium { background: var(--accent);          color: #0c0c0e; }
        .role-pill.elit    { background: linear-gradient(135deg,#a855f7,#7c3aed); color: #fff; }

        /* ─── MAIN ────────────────────────────────────── */
        .main {
            grid-area: main;
            overflow-y: auto;
            display: flex; flex-direction: column;
            background: var(--bg-main);
            scrollbar-width: thin;
            scrollbar-color: var(--bg-surface) transparent;
        }
        .main::-webkit-scrollbar { width: 5px; }
        .main::-webkit-scrollbar-track { background: transparent; }
        .main::-webkit-scrollbar-thumb { background: var(--bg-surface); border-radius: 4px; }

        /* ─── TOPBAR ──────────────────────────────────── */
        .topbar {
            position: sticky; top: 0; z-index: 50;
            display: flex; align-items: center; justify-content: space-between;
            padding: 14px 28px;
            background: rgba(12,12,14,0.88);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--border);
            gap: 16px;
        }

        .topbar-breadcrumb {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 700; font-size: 1rem;
            color: var(--text-1); letter-spacing: -0.3px;
        }

        .topbar-right { display: flex; align-items: center; gap: 10px; }

        .search-field { position: relative; display: flex; align-items: center; }
        .search-field i { position: absolute; left: 12px; color: var(--text-3); font-size: 0.8rem; pointer-events: none; }

        .search-input {
            background: var(--bg-input); border: 1px solid var(--border);
            color: var(--text-1); border-radius: var(--radius-pill);
            padding: 7px 14px 7px 32px; font-size: 0.8rem;
            font-family: 'Inter', sans-serif; width: 210px; outline: none;
            transition: border-color var(--transition), box-shadow var(--transition), width var(--transition);
        }
        .search-input::placeholder { color: var(--text-3); }
        .search-input:focus {
            border-color: var(--accent-border);
            box-shadow: 0 0 0 3px rgba(201,168,76,0.08);
            width: 260px;
        }

        .clear-btn {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 7px 14px; border-radius: var(--radius-pill);
            background: transparent; border: 1px solid rgba(255,80,80,0.3);
            color: #f87171; font-size: 0.78rem; font-weight: 600;
            cursor: pointer; transition: all var(--transition);
        }
        .clear-btn:hover { background: rgba(255,80,80,0.08); border-color: #f87171; }

        /* ─── CONTENT ─────────────────────────────────── */
        .content { padding: 28px 28px 40px; flex: 1; }

        .page-header { margin-bottom: 28px; }
        .page-header h1 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.75rem; font-weight: 800;
            letter-spacing: -0.6px; color: var(--text-1); margin-bottom: 4px;
        }
        .page-header p { font-size: 0.83rem; color: var(--text-2); }

        /* Özet istatistikler */
        .stats-row {
            display: flex; gap: 12px; margin-bottom: 28px; flex-wrap: wrap;
        }

        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-card);
            padding: 16px 20px;
            display: flex; align-items: center; gap: 12px;
            flex: 1; min-width: 140px;
        }

        .stat-icon {
            width: 36px; height: 36px; border-radius: var(--radius-sm);
            background: var(--accent-dim); border: 1px solid var(--accent-border);
            display: flex; align-items: center; justify-content: center;
            color: var(--accent); font-size: 0.95rem; flex-shrink: 0;
        }

        .stat-info { min-width: 0; }
        .stat-value {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.25rem; font-weight: 800;
            color: var(--text-1); letter-spacing: -0.5px;
        }
        .stat-label { font-size: 0.7rem; color: var(--text-3); margin-top: 1px; }

        /* ─── GEÇMİŞ LİSTESİ ─────────────────────────── */
        .history-list { display: flex; flex-direction: column; gap: 3px; }

        .history-row {
            display: grid;
            grid-template-columns: 48px 1fr auto auto;
            align-items: center;
            gap: 14px;
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: background var(--transition);
            position: relative;
        }

        .history-row:hover { background: var(--bg-surface); }
        .history-row.playing { background: var(--accent-dim); }
        .history-row.hide    { display: none !important; }

        /* Kapak fotoğrafı */
        .row-cover {
            width: 48px; height: 48px;
            border-radius: var(--radius-sm);
            object-fit: cover; flex-shrink: 0;
            background: var(--bg-surface);
            border: 1px solid var(--border);
        }

        .row-cover-fallback {
            width: 48px; height: 48px;
            border-radius: var(--radius-sm);
            background: var(--bg-surface);
            border: 1px solid var(--border);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem; flex-shrink: 0;
        }

        /* Şarkı bilgisi */
        .row-info { min-width: 0; }

        .row-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.875rem; font-weight: 600;
            color: var(--text-1);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        .history-row.playing .row-title { color: var(--accent); }

        .row-artist {
            font-size: 0.72rem; color: var(--text-2); margin-top: 2px;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        /* Zaman */
        .row-time {
            font-size: 0.72rem; color: var(--text-3);
            white-space: nowrap; text-align: right;
            font-variant-numeric: tabular-nums;
        }

        /* Sil butonu */
        .row-delete-btn {
            background: none; border: none;
            color: var(--text-3); font-size: 0.85rem;
            cursor: pointer; padding: 5px;
            opacity: 0; transition: opacity var(--transition), color var(--transition);
            border-radius: 4px;
        }

        .history-row:hover .row-delete-btn { opacity: 1; }
        .history-row:hover .row-delete-btn:hover { color: #f87171; }

        /* Rol rozeti — küçük */
        .row-role-badge {
            padding: 2px 7px; border-radius: var(--radius-pill);
            font-size: 0.6rem; font-weight: 700;
            letter-spacing: 0.05em; text-transform: uppercase;
        }
        .row-role-badge.basic   { background: rgba(255,255,255,0.07); color: var(--text-3); }
        .row-role-badge.gold    { background: var(--accent-dim); color: var(--accent); }
        .row-role-badge.premium { background: rgba(168,85,247,0.15); color: #c084fc; }
        .row-role-badge.elit    { background: linear-gradient(135deg,rgba(168,85,247,0.3),rgba(124,58,237,0.3)); color: #d8b4fe; }

        /* Boş state */
        .empty-state {
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            text-align: center; padding: 5rem 2rem;
            color: var(--text-3);
        }
        .empty-state i { font-size: 2.5rem; margin-bottom: 14px; display: block; }
        .empty-state strong { font-size: 1rem; color: var(--text-2); font-family: 'Plus Jakarta Sans', sans-serif; margin-bottom: 6px; display: block; }
        .empty-state p { font-size: 0.83rem; color: var(--text-3); max-width: 260px; line-height: 1.6; }
        .empty-state a {
            margin-top: 16px; display: inline-flex; align-items: center; gap: 6px;
            padding: 9px 20px; border-radius: var(--radius-pill);
            background: var(--accent); color: #0c0c0e;
            font-size: 0.82rem; font-weight: 700;
            transition: background var(--transition);
        }
        .empty-state a:hover { background: #d4b360; }

        /* Sonuç yok */
        .no-results {
            display: none; flex-direction: column;
            align-items: center; justify-content: center;
            text-align: center; padding: 3rem 1rem;
            color: var(--text-3);
        }
        .no-results i { font-size: 2rem; margin-bottom: 10px; display: block; }
        .no-results p { font-size: 0.83rem; color: var(--text-2); }

        /* ─── PLAYER ──────────────────────────────────── */
        .player {
            grid-area: player; background: #111113;
            border-top: 1px solid var(--border);
            display: grid; grid-template-columns: 280px 1fr 280px;
            align-items: center; padding: 0 20px; gap: 12px; z-index: 100;
        }

        .player-track { display: flex; align-items: center; gap: 11px; min-width: 0; }

        .player-cover {
            width: 44px; height: 44px; border-radius: var(--radius-sm);
            background: var(--bg-surface); border: 1px solid var(--border);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem; flex-shrink: 0; overflow: hidden;
        }
        .player-cover img { width: 100%; height: 100%; object-fit: cover; }

        .player-info { min-width: 0; flex: 1; }
        .player-song {
            font-size: 0.82rem; font-weight: 600; color: var(--text-1);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .player-artist {
            font-size: 0.72rem; color: var(--text-2);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 1px;
        }

        .player-like-btn {
            background: none; border: none; color: var(--text-3);
            font-size: 0.9rem; cursor: pointer; padding: 5px;
            transition: color var(--transition); flex-shrink: 0;
        }
        .player-like-btn:hover, .player-like-btn.liked { color: var(--accent); }

        .waveform { display: flex; align-items: center; gap: 2px; height: 14px; }
        .waveform span {
            display: block; width: 2.5px; border-radius: 2px;
            background: var(--accent); animation: wv 1.1s ease-in-out infinite;
        }
        .waveform span:nth-child(1) { height: 5px;  animation-delay: 0s; }
        .waveform span:nth-child(2) { height: 12px; animation-delay: 0.1s; }
        .waveform span:nth-child(3) { height: 8px;  animation-delay: 0.2s; }
        .waveform span:nth-child(4) { height: 14px; animation-delay: 0.3s; }
        .waveform span:nth-child(5) { height: 6px;  animation-delay: 0.4s; }

        @@keyframes wv {
            0%, 100% { transform: scaleY(1); }
            50%       { transform: scaleY(0.3); }
        }
        .waveform.paused span { animation-play-state: paused; }

        .player-center { display: flex; flex-direction: column; align-items: center; gap: 7px; }
        .player-controls { display: flex; align-items: center; gap: 4px; }

        .ctrl-btn {
            background: none; border: none; color: var(--text-2);
            font-size: 0.9rem; cursor: pointer; padding: 0;
            width: 32px; height: 32px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            transition: color var(--transition), background var(--transition);
        }
        .ctrl-btn:hover { color: var(--text-1); background: rgba(255,255,255,0.05); }

        .ctrl-btn-play {
            width: 38px; height: 38px; background: var(--text-1);
            color: var(--bg-root); font-size: 1rem; border-radius: 50%;
            transition: transform 0.15s, background var(--transition);
        }
        .ctrl-btn-play:hover { background: #fff; transform: scale(1.05); }

        .player-progress {
            display: flex; align-items: center; gap: 10px;
            width: 100%; max-width: 440px;
        }

        .time-lbl {
            font-size: 0.65rem; color: var(--text-3);
            min-width: 30px; text-align: center; font-variant-numeric: tabular-nums;
        }

        .progress-track {
            flex: 1; height: 3px; background: rgba(255,255,255,0.08);
            border-radius: 3px; cursor: pointer;
        }
        .progress-track:hover { height: 4px; }

        .progress-fill {
            height: 100%; border-radius: 3px; background: var(--text-1);
            width: 0%; position: relative; transition: width 0.1s linear;
        }
        .progress-track:hover .progress-fill { background: var(--accent); }
        .progress-fill::after {
            content: ''; position: absolute; right: -4px; top: 50%;
            transform: translateY(-50%) scale(0);
            width: 9px; height: 9px; background: #fff; border-radius: 50%;
            transition: transform 0.15s;
        }
        .progress-track:hover .progress-fill::after { transform: translateY(-50%) scale(1); }

        .player-right { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
        .vol-wrap { display: flex; align-items: center; gap: 6px; }
        .vol-btn {
            background: none; border: none; color: var(--text-2);
            font-size: 0.9rem; cursor: pointer; padding: 4px; transition: color var(--transition);
        }
        .vol-btn:hover { color: var(--text-1); }
        .vol-track {
            width: 78px; height: 3px; background: rgba(255,255,255,0.08);
            border-radius: 3px; cursor: pointer;
        }
        .vol-fill {
            height: 100%; border-radius: 3px; background: rgba(255,255,255,0.3);
            width: 70%; transition: background var(--transition);
        }
        .vol-track:hover .vol-fill { background: var(--text-1); }

        /* ─── RESPONSIVE ──────────────────────────────── */
        @@media (max-width: 900px) {
            body {
                grid-template-columns: 1fr;
                grid-template-rows: 52px 1fr var(--player-h);
                grid-template-areas: "sidebar" "main" "player";
            }
            .sidebar { flex-direction: row; border-right: none; border-bottom: 1px solid var(--border); overflow-x: auto; }
            .sidebar-logo { padding: 12px 16px; border-bottom: none; border-right: 1px solid var(--border); }
            .sidebar-section { display: flex; flex-direction: row; padding: 8px; gap: 2px; align-items: center; }
            .sidebar-label, .sidebar-divider, .sidebar-footer { display: none; }
            .nav-item.active::before { top: auto; left: 20%; right: 20%; bottom: 0; height: 2px; width: auto; }
            .player { grid-template-columns: 1fr auto; }
            .player-right { display: none; }
            .history-row { grid-template-columns: 44px 1fr auto; }
            .row-time { display: none; }
        }

        @@media (max-width: 600px) {
            .content { padding: 16px 14px 28px; }
            .topbar { padding: 10px 14px; }
            .stats-row { gap: 8px; }
            .stat-card { padding: 12px 14px; }
        }
    </style>
</head>
<body>

    <!-- ═══════════════ SIDEBAR ═══════════════ -->
   <aside class="sidebar">
    <div class="sidebar-logo">
        <div class="logo-mark"><i class="bi bi-soundwave"></i></div>
        <span class="logo-wordmark">Canlı Müzik</span>
    </div>
    <nav class="sidebar-section">
        <span class="sidebar-label">Keşfet</span>
        <a href="/Song/SongList" class="nav-item"><i class="bi bi-house"></i> Ana Sayfa</a>
        <a href="/Artist/ArtistList" class="nav-item"><i class="bi bi-people"></i> Sanatçılar</a>
        <a href="/Song/SongList" class="nav-item"><i class="bi bi-music-note-list"></i> Şarkılar</a>
        <a href="/Recommendation/Index" class="nav-item"><i class="bi bi-stars"></i> Önerilenler</a>
    </nav>
    <div class="sidebar-divider"></div>
    <nav class="sidebar-section">
        <span class="sidebar-label">Kitaplık</span>
        <a href="/LikedSongs/Index" class="nav-item"><i class="bi bi-heart"></i> Beğendiklerim</a>
        <a href="/Playlist/Index" class="nav-item"><i class="bi bi-collection-play"></i> Çalma Listeleri</a>
        <a href="/History/Index" class="nav-item"><i class="bi bi-clock-history"></i> Dinleme Geçmişi</a>
    </nav>
    <div class="sidebar-divider"></div>
    <nav class="sidebar-section">
        <a href="/Settings/Index" class="nav-item"><i class="bi bi-gear"></i> Ayarlar</a>
        <a href="/Login/Logout" class="nav-item" onclick="return confirm('Çıkış yapmak istediğinize emin misiniz?');">
            <i class="bi bi-box-arrow-right"></i> Çıkış Yap
        </a>
    </nav>
        <div class="sidebar-footer">
            <div class="user-row">
                <div class="user-avatar">@userRole.Substring(0, 1).ToUpper()</div>
                <div class="user-info">
                    <div class="user-name">Hesabım</div>
                    @{
                        var rl = userRole.ToLower();
                        var rc = rl == "elit" ? "elit" : rl == "premium" ? "premium" : rl == "gold" ? "gold" : "basic";
                        var ri = rl == "elit" ? "bi-gem" : rl == "premium" ? "bi-star-fill" : rl == "gold" ? "bi-star-half" : "bi-person";
                    }
                    <div class="role-pill @rc"><i class="bi @ri"></i> @userRole</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- ═══════════════ MAIN ═══════════════ -->
    <main class="main">

        <header class="topbar">
            <div class="topbar-breadcrumb">Dinleme Geçmişi</div>
            <div class="topbar-right">
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input type="text" id="searchInput" class="search-input"
                           placeholder="Geçmişte ara..." autocomplete="off">
                </div>
                @if (Model != null && Model.Any())
                {
                    <button class="clear-btn" onclick="confirmClear()">
                        <i class="bi bi-trash"></i> Geçmişi Temizle
                    </button>
                }
            </div>
        </header>

        <div class="content">

            <div class="page-header">
                <h1>Dinleme Geçmişi</h1>
                <p>Son dinlediğiniz şarkılar — en yeniden en eskiye sıralı.</p>
            </div>

            @if (Model != null && Model.Any())
            {
                
                    var uniqueSongs   = Model.Select(m => m.SongId).Distinct().Count();
                    var uniqueArtists = Model.Select(m => m.ArtistName).Distinct().Count();
                    var lastDate      = Model.First().ListenedAt;
                

                <div class="stats-row">
                    <div class="stat-card">
                        <div class="stat-icon"><i class="bi bi-play-circle"></i></div>
                        <div class="stat-info">
                            <div class="stat-value">@Model.Count</div>
                            <div class="stat-label">Toplam Dinleme</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon"><i class="bi bi-music-note-list"></i></div>
                        <div class="stat-info">
                            <div class="stat-value">@uniqueSongs</div>
                            <div class="stat-label">Farklı Şarkı</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon"><i class="bi bi-people"></i></div>
                        <div class="stat-info">
                            <div class="stat-value">@uniqueArtists</div>
                            <div class="stat-label">Farklı Sanatçı</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon"><i class="bi bi-clock"></i></div>
                        <div class="stat-info">
                            <div class="stat-value">@lastDate.ToString("HH:mm")</div>
                            <div class="stat-label">Son Dinleme (@lastDate.ToString("dd MMM"))</div>
                        </div>
                    </div>
                </div>

                <!-- Geçmiş listesi -->
                <div class="history-list" id="historyList">
                    @foreach (var item in Model)
                    {
                        var reqRole   = item.RequiredRoleName ?? "Basic";
                        var badgeCss  = reqRole.ToLower() switch {
                            "elit"    => "elit",
                            "premium" => "premium",
                            "gold"    => "gold",
                            _         => "basic"
                        };

                        <div class="history-row"
                             id="hrow-@item.Id"
                             data-history-id="@item.Id"
                             data-name="@item.SongTitle.ToLower() @item.ArtistName.ToLower()"
                             onclick="playFromHistory('@item.SongId', '@Html.Raw(item.SongTitle.Replace("'","\\'"))', '@Html.Raw(item.ArtistName.Replace("'","\\'"))', '@item.CoverImageUrl', '@item.AudioUrl')">

                            <!-- Kapak -->
                            @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                            {
                                <img src="@item.CoverImageUrl" alt="@item.SongTitle"
                                     class="row-cover"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                <div class="row-cover-fallback" style="display:none;">🎵</div>
                            }
                            else
                            {
                                <div class="row-cover-fallback">🎵</div>
                            }

                            <!-- Bilgi -->
                            <div class="row-info">
                                <div class="row-title">@item.SongTitle</div>
                                <div class="row-artist">
                                    @item.ArtistName
                                </div>
                            </div>

                            <!-- Zaman -->
                            <div class="row-time">@item.ListenedAt.ToString("dd MMM, HH:mm")</div>

                            <!-- Sil -->
                            <button class="row-delete-btn"
                                    onclick="deleteRecord(event, @item.Id)"
                                    title="Geçmişten kaldır">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    }

                    <div id="noResults" class="no-results">
                        <i class="bi bi-search"></i>
                        <p>Arama kriterinize uyan şarkı bulunamadı.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-clock-history"></i>
                    <strong>Henüz dinleme geçmişi yok</strong>
                    <p>Bir şarkı çaldığınızda burada görünecek.</p>
                    <a href="/Song/SongList"><i class="bi bi-music-note-list"></i> Şarkılara Git</a>
                </div>
            }
        </div>
    </main>

    <!-- ═══════════════ PLAYER ═══════════════ -->
    <footer class="player">
        <div class="player-track">
            <div class="player-cover" id="playerCover">🎵</div>
            <div class="player-info">
                <div class="player-song"   id="playerSong">Oynatılmıyor</div>
                <div class="player-artist" id="playerArtist">Bir şarkı seçin</div>
            </div>
            <button class="player-like-btn" onclick="toggleHeart(this)" title="Beğen">
                <i class="bi bi-heart"></i>
            </button>
            <div class="waveform paused" id="waveform">
                <span></span><span></span><span></span><span></span><span></span>
            </div>
        </div>

        <div class="player-center">
            <div class="player-controls">
                <button class="ctrl-btn" title="Karıştır"><i class="bi bi-shuffle"></i></button>
                <button class="ctrl-btn" onclick="playPrev()" title="Önceki"><i class="bi bi-skip-start-fill"></i></button>
                <button class="ctrl-btn ctrl-btn-play" onclick="togglePlay()" title="Oynat/Durdur">
                    <i id="playIcon" class="bi bi-play-fill"></i>
                </button>
                <button class="ctrl-btn" onclick="playNext()" title="Sonraki"><i class="bi bi-skip-end-fill"></i></button>
                <button class="ctrl-btn" title="Tekrarla"><i class="bi bi-repeat"></i></button>
            </div>
            <div class="player-progress">
                <span class="time-lbl" id="currentTime">0:00</span>
                <div class="progress-track" id="progressBar" onclick="seekTo(event)">
                    <div class="progress-fill" id="progressFill"></div>
                </div>
                <span class="time-lbl" id="totalTime">0:00</span>
            </div>
        </div>

        <div class="player-right">
            <div class="vol-wrap">
                <button class="vol-btn" onclick="toggleMute()" title="Ses">
                    <i id="volIcon" class="bi bi-volume-up-fill"></i>
                </button>
                <div class="vol-track" id="volTrack" onclick="setVolume(event)">
                    <div class="vol-fill" id="volFill" style="width:70%;"></div>
                </div>
            </div>
        </div>
    </footer>

    <div id="ytPlayer" style="position:absolute;width:0;height:0;pointer-events:none;opacity:0;"></div>

    <script>
        const TOKEN    = "@token";
        const API_BASE = "https://localhost:7185";

        /* ── Tüm geçmiş şarkıları (prev/next için) ── */
        const HISTORY_SONGS = @Html.Raw(
            Newtonsoft.Json.JsonConvert.SerializeObject(
                (Model ?? new List<JwtMusic.WebUI.Dtos.ListeningHistoryDtos.ResultListeningHistoryDto>())
                .Select(m => new {
                    songId       = m.SongId,
                    title        = m.SongTitle,
                    artistName   = m.ArtistName,
                    coverImageUrl= m.CoverImageUrl,
                    audioUrl     = m.AudioUrl
                })
            )
        );

        let currentHistoryIndex = -1;

        /* ── Geçmişten şarkı oynat ── */
        function playFromHistory(songId, title, artist, coverUrl, audioUrl) {
            // Aktif satırı vurgula
            document.querySelectorAll('.history-row').forEach(r => r.classList.remove('playing'));
            const row = document.querySelector(`[data-history-id]`);
            // İndex bul
            currentHistoryIndex = HISTORY_SONGS.findIndex(s => String(s.songId) === String(songId));

            // Player güncelle
            document.getElementById('playerSong').textContent   = title;
            document.getElementById('playerArtist').textContent = artist;
            const cover = document.getElementById('playerCover');
            cover.innerHTML = coverUrl
                ? `<img src="${coverUrl}" alt="${title}" onerror="this.parentElement.textContent='🎵'">`
                : '🎵';

            const videoId = getYoutubeId(audioUrl);
            if (!videoId) { console.error('Geçersiz URL:', audioUrl); return; }

            if (ytReady && ytPlayer?.loadVideoById) {
                ytPlayer.loadVideoById(videoId);
            } else {
                pendingVideoId = videoId;
            }
        }

        function playNext() {
            if (HISTORY_SONGS.length === 0) return;
            currentHistoryIndex = (currentHistoryIndex + 1) % HISTORY_SONGS.length;
            const s = HISTORY_SONGS[currentHistoryIndex];
            playFromHistory(s.songId, s.title, s.artistName, s.coverImageUrl, s.audioUrl);
        }

        function playPrev() {
            if (HISTORY_SONGS.length === 0) return;
            currentHistoryIndex = (currentHistoryIndex - 1 + HISTORY_SONGS.length) % HISTORY_SONGS.length;
            const s = HISTORY_SONGS[currentHistoryIndex];
            playFromHistory(s.songId, s.title, s.artistName, s.coverImageUrl, s.audioUrl);
        }

        /* ── Tek kayıt sil ── */
        async function deleteRecord(e, historyId) {
            e.stopPropagation();
            try {
                const res = await fetch(`${API_BASE}/api/ListeningHistory/${historyId}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${TOKEN}` }
                });
                if (res.ok) {
                    const row = document.getElementById(`hrow-${historyId}`);
                    if (row) {
                        row.style.opacity = '0';
                        row.style.transition = 'opacity 0.25s';
                        setTimeout(() => row.remove(), 250);
                    }
                }
            } catch(err) { console.error('Silme hatası:', err); }
        }

        /* ── Tüm geçmişi temizle ── */
        async function confirmClear() {
            if (!confirm('Tüm dinleme geçmişiniz silinecek. Emin misiniz?')) return;
            try {
                const res = await fetch(`${API_BASE}/api/ListeningHistory/clear`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${TOKEN}` }
                });
                if (res.ok) window.location.reload();
            } catch(err) { console.error('Temizleme hatası:', err); }
        }

        /* ── YouTube API ── */
        var tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        document.head.appendChild(tag);

        let ytPlayer, ytReady = false, pendingVideoId = null;
        let volumeVal = 70, isMuted = false, progressInterval;

        function onYouTubeIframeAPIReady() {
            ytPlayer = new YT.Player('ytPlayer', {
                height: '0', width: '0',
                playerVars: { controls: 0, disablekb: 1, rel: 0 },
                events: {
                    onReady: function () {
                        ytReady = true;
                        ytPlayer.setVolume(volumeVal);
                        document.getElementById('volFill').style.width = volumeVal + '%';
                        if (pendingVideoId) { ytPlayer.loadVideoById(pendingVideoId); pendingVideoId = null; }
                    },
                    onStateChange: function (e) {
                        if (e.data === YT.PlayerState.PLAYING) {
                            document.getElementById('playIcon').className = 'bi bi-pause-fill';
                            document.getElementById('waveform').classList.remove('paused');
                            startProgressLoop();
                        } else if (e.data === YT.PlayerState.PAUSED || e.data === YT.PlayerState.BUFFERING) {
                            document.getElementById('playIcon').className = 'bi bi-play-fill';
                            document.getElementById('waveform').classList.add('paused');
                            clearInterval(progressInterval);
                        } else if (e.data === YT.PlayerState.ENDED) {
                            playNext();
                        }
                    },
                    onError: function (e) { console.error('YT hata:', e.data); }
                }
            });
        }

        function togglePlay() {
            if (!ytPlayer?.getPlayerState) return;
            const s = ytPlayer.getPlayerState();
            if (s === YT.PlayerState.PLAYING) ytPlayer.pauseVideo();
            else ytPlayer.playVideo();
        }

        function startProgressLoop() {
            clearInterval(progressInterval);
            progressInterval = setInterval(() => {
                if (!ytPlayer?.getCurrentTime) return;
                const cur = ytPlayer.getCurrentTime();
                const dur = ytPlayer.getDuration();
                if (dur > 0) {
                    document.getElementById('progressFill').style.width = (cur / dur * 100) + '%';
                    document.getElementById('currentTime').textContent  = formatTime(cur);
                    document.getElementById('totalTime').textContent    = formatTime(dur);
                }
            }, 500);
        }

        function seekTo(e) {
            if (!ytPlayer?.getDuration) return;
            const rect  = document.getElementById('progressBar').getBoundingClientRect();
            const ratio = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
            ytPlayer.seekTo(ratio * ytPlayer.getDuration(), true);
            document.getElementById('progressFill').style.width = (ratio * 100) + '%';
        }

        function setVolume(e) {
            if (!ytPlayer?.setVolume) return;
            const rect = document.getElementById('volTrack').getBoundingClientRect();
            volumeVal  = Math.min(100, Math.max(0, ((e.clientX - rect.left) / rect.width) * 100));
            isMuted = false; ytPlayer.unMute(); ytPlayer.setVolume(volumeVal);
            document.getElementById('volFill').style.width = volumeVal + '%';
            updateVolIcon();
        }

        function toggleMute() {
            if (!ytPlayer) return;
            if (ytPlayer.isMuted()) {
                ytPlayer.unMute(); ytPlayer.setVolume(volumeVal);
                document.getElementById('volFill').style.width = volumeVal + '%';
                isMuted = false;
            } else {
                ytPlayer.mute();
                document.getElementById('volFill').style.width = '0%';
                isMuted = true;
            }
            updateVolIcon();
        }

        function updateVolIcon() {
            document.getElementById('volIcon').className =
                isMuted || volumeVal === 0 ? 'bi bi-volume-mute-fill' : 'bi bi-volume-up-fill';
        }

        function toggleHeart(btn) {
            btn.classList.toggle('liked');
            btn.querySelector('i').className = btn.classList.contains('liked') ? 'bi bi-heart-fill' : 'bi bi-heart';
        }

        function formatTime(secs) {
            const m = Math.floor(secs / 60);
            const s = Math.floor(secs % 60);
            return m + ':' + String(s).padStart(2, '0');
        }

        function getYoutubeId(url) {
            if (!url) return null;
            if (url.length === 11 && !url.includes('/') && !url.includes('?')) return url;
            const m = url.match(/^.*(youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/);
            return (m && m[2].length === 11) ? m[2] : null;
        }

        /* ── Arama filtresi ── */
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const noResults   = document.getElementById('noResults');
            if (noResults) noResults.style.display = 'none';

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const q     = this.value.trim().toLowerCase();
                    const rows  = document.querySelectorAll('.history-row');
                    let visible = 0;

                    rows.forEach(row => {
                        const name = row.getAttribute('data-name') || '';
                        if (name.includes(q)) { row.classList.remove('hide'); visible++; }
                        else                  { row.classList.add('hide'); }
                    });

                    if (noResults) noResults.style.display = visible === 0 ? 'flex' : 'none';
                });
            }
        });
    </script>
</body>
</html>
