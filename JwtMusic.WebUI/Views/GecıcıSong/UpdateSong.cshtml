@model JwtMusic.WebApi.Entities.Song

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Canlı Veri Merkezi | Parçayı Düzenle</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: #0b071a;
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
    </style>
</head>
<body class="bg-[#0b071a] text-gray-200 min-h-screen flex items-center justify-center p-4">

    <div class="w-full max-w-lg bg-white/5 border border-white/10 glass-panel rounded-3xl p-8 shadow-2xl">
        <div class="mb-6">
            <h2 class="text-xl font-bold text-white tracking-tight">Parça Bilgilerini Güncelle</h2>
            <p class="text-xs text-gray-400 mt-1">Veritabanındaki tüm kayıtlı meta verileri düzenleyin.</p>
        </div>

        <form asp-action="UpdateSong" method="post" class="space-y-4">
            <input type="hidden" asp-for="SongId" />

            <div>
                <label asp-for="Title" class="block text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-1">Şarkı Başlığı</label>
                <input type="text" asp-for="Title" class="w-full bg-white/5 border border-white/10 rounded-xl py-2.5 px-4 text-xs text-white focus:outline-none focus:border-purple-500" required />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="ArtistId" class="block text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-1">Sanatçı ID</label>
                    <input type="number" asp-for="ArtistId" class="w-full bg-white/5 border border-white/10 rounded-xl py-2.5 px-4 text-xs text-white focus:outline-none focus:border-purple-500" required />
                </div>

                <div>
                    <label asp-for="Duration" class="block text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-1">Süre (Dakika)</label>
                    <input type="text" asp-for="Duration" class="w-full bg-white/5 border border-white/10 rounded-xl py-2.5 px-4 text-xs text-white focus:outline-none focus:border-purple-500" required />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="PlayCount" class="block text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-1">Dinlenme Sayısı</label>
                    <input type="number" asp-for="PlayCount" class="w-full bg-white/5 border border-white/10 rounded-xl py-2.5 px-4 text-xs text-white focus:outline-none focus:border-purple-500" />
                </div>

                <div>
                    <label asp-for="ReleaseDate" class="block text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-1">Yayın Tarihi</label>
                    <input type="date" asp-for="ReleaseDate" asp-format="{0:yyyy-MM-dd}" class="w-full bg-white/5 border border-white/10 rounded-xl py-2.5 px-4 text-xs text-white focus:outline-none focus:border-purple-500" />
                </div>
            </div>

            <div>
                <label asp-for="AudioUrl" class="block text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-1">Ses Dosyası URL (AudioUrl)</label>
                <input type="text" asp-for="AudioUrl" class="w-full bg-white/5 border border-white/10 rounded-xl py-2.5 px-4 text-xs text-white focus:outline-none focus:border-purple-500" placeholder="https://..." />
            </div>

            <div>
                <label asp-for="CoverImageUrl" class="block text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-1">Kapak Görseli URL (CoverImageUrl)</label>
                <input type="text" asp-for="CoverImageUrl" class="w-full bg-white/5 border border-white/10 rounded-xl py-2.5 px-4 text-xs text-white focus:outline-none focus:border-purple-500" placeholder="https://..." />
            </div>

            <div class="pt-1">
                <label class="inline-flex items-center gap-2 text-xs font-semibold text-gray-400 cursor-pointer select-none">
                    <input type="checkbox" asp-for="RequiredRole" class="w-4 h-4 rounded border-white/10 bg-white/5 accent-purple-600 text-purple-600 focus:ring-0 focus:ring-offset-0" />
                    <span>Bu parça <span class="text-amber-400 font-bold"><i class="fa-solid fa-crown text-[10px]"></i> Premium</span> olarak işaretlensin</span>
                </label>
            </div>

            <div class="flex gap-3 pt-4">
                <a href="/GecıcıSong/Index" class="w-1/2 bg-white/5 hover:bg-white/10 text-center py-3 rounded-xl text-xs font-bold transition-all">İptal</a>
                <button type="submit" class="w-1/2 bg-purple-600 hover:bg-purple-500 text-white py-3 rounded-xl text-xs font-bold transition-all">
                    <i class="fa-solid fa-floppy-disk mr-1"></i> Değişiklikleri Kaydet
                </button>
            </div>
        </form>
    </div>

</body>
</html>