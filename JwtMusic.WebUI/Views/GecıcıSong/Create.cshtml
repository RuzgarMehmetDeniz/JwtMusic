@model JwtMusic.WebApi.Entities.Song

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Audio Hub | Yeni Parça Ekle</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: #0b071a;
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
    </style>
</head>
<body class="bg-[#0b071a] text-gray-200 min-h-screen flex items-center justify-center p-4">

    <div class="w-full max-w-lg">

        <a href="/GecıcıSong/Index" class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-gray-400 hover:text-white mb-5 transition-colors group">
            <i class="fa-solid fa-arrow-left transition-transform group-hover:-translate-x-1"></i>
            Kütüphaneye Dön
        </a>

        <div class="glass-panel rounded-3xl p-8 shadow-2xl relative">
            <div class="mb-6">
                <h2 class="text-xl font-bold text-white tracking-tight">Yeni Şarkı Kaydı</h2>
                <p class="text-xs text-gray-400 mt-1">Veritabanına eklenecek müzik detaylarını giriniz.</p>
            </div>

            <form asp-action="Create" method="post" class="space-y-4">

                <div>
                    <label asp-for="Title" class="block text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-1.5">Şarkı Başlığı</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-500">
                            <i class="fa-solid fa-music text-xs"></i>
                        </span>
                        <input type="text" asp-for="Title" placeholder="Örn: Blinding Lights" autocomplete="off"
                               class="w-full bg-white/[0.03] border border-white/10 rounded-xl py-2.5 pl-10 pr-4 text-xs text-white placeholder-gray-600 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500/50 transition-all" required />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="ArtistId" class="block text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-1.5">Sanatçı ID</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-500">
                                <i class="fa-solid fa-user text-xs"></i>
                            </span>
                            <input type="number" asp-for="ArtistId" placeholder="Örn: 1"
                                   class="w-full bg-white/[0.03] border border-white/10 rounded-xl py-2.5 pl-10 pr-4 text-xs text-white placeholder-gray-600 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500/50 transition-all" required />
                        </div>
                    </div>

                    <div>
                        <label asp-for="Duration" class="block text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-1.5">Süre (Dakika)</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-500">
                                <i class="fa-solid fa-clock text-xs"></i>
                            </span>
                            <input type="text" asp-for="Duration" placeholder="Örn: 3.45"
                                   class="w-full bg-white/[0.03] border border-white/10 rounded-xl py-2.5 pl-10 pr-4 text-xs text-white placeholder-gray-600 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500/50 transition-all" required />
                        </div>
                    </div>
                </div>

                <div>
                    <label asp-for="AudioUrl" class="block text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-1.5">Ses Dosyası URL (AudioUrl)</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-500">
                            <i class="fa-solid fa-link text-xs"></i>
                        </span>
                        <input type="url" asp-for="AudioUrl" placeholder="https://example.com/song.mp3" autocomplete="off"
                               class="w-full bg-white/[0.03] border border-white/10 rounded-xl py-2.5 pl-10 pr-4 text-xs text-white placeholder-gray-600 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500/50 transition-all" />
                    </div>
                </div>

                <div>
                    <label asp-for="CoverImageUrl" class="block text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-1.5">Kapak Görseli URL (CoverImageUrl)</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-500">
                            <i class="fa-solid fa-image text-xs"></i>
                        </span>
                        <input type="url" asp-for="CoverImageUrl" placeholder="https://example.com/cover.jpg" autocomplete="off"
                               class="w-full bg-white/[0.03] border border-white/10 rounded-xl py-2.5 pl-10 pr-4 text-xs text-white placeholder-gray-600 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500/50 transition-all" />
                    </div>
                </div>

                <div class="pt-2">
                    <label class="inline-flex items-center gap-2 text-xs font-semibold text-gray-400 cursor-pointer select-none">
                        <input type="checkbox" asp-for="IsPremium" class="w-4 h-4 rounded border-white/10 bg-white/5 accent-purple-600 text-purple-600 focus:ring-0 focus:ring-offset-0" />
                        <span>Bu şarkı <span class="text-amber-400 font-bold"><i class="fa-solid fa-crown text-[10px]"></i> Premium</span> kullanıcılara özel olsun</span>
                    </label>
                </div>

                <button type="submit"
                        class="w-full mt-4 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-bold uppercase tracking-wider py-3.5 rounded-xl shadow-lg shadow-purple-950/50 transition-all duration-300 hover:scale-[1.01]">
                    Şarkıyı Sisteme Kaydet
                </button>
            </form>
        </div>
    </div>

</body>
</html>