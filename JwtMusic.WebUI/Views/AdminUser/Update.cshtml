@using JwtMusic.WebUI.Dtos.AccountDtos
@model UpdateAccountDto
@{
    Layout = null;
    var allRoles = ViewBag.AllRoles as List<string> ?? new List<string>();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kullanıcı Güncelle — Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --bg-root: #0c0c0e;
            --bg-sidebar: #111113;
            --bg-card: #16161a;
            --bg-input: #1a1a1c;
            --accent: #c9a84c;
            --accent-dim: rgba(201,168,76,.12);
            --accent-border: rgba(201,168,76,.28);
            --text-1: #e8e8ea;
            --text-2: #8a8a94;
            --text-3: #46464e;
            --border: rgba(255,255,255,.07);
            --danger: #e0584f;
            --success: #3fb27f;
            --radius: 10px;
            --sidebar-w: 220px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter',sans-serif;
            background: var(--bg-root);
            color: var(--text-1);
            display: grid;
            grid-template-columns: var(--sidebar-w) 1fr;
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
            cursor: pointer;
        }

        .sidebar {
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            padding: 20px 12px;
            display: flex;
            flex-direction: column;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 6px 8px 22px;
        }

        .logo-mark {
            width: 26px;
            height: 26px;
            background: var(--accent);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .logo-mark i {
                color: #0c0c0e;
                font-size: .8rem;
            }

        .logo-wordmark {
            font-family: 'Plus Jakarta Sans',sans-serif;
            font-weight: 800;
            font-size: .85rem;
        }

        .sidebar-tag {
            font-size: .6rem;
            font-weight: 700;
            letter-spacing: .08em;
            color: var(--accent);
            text-transform: uppercase;
            margin: 0 8px 14px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 10px;
            border-radius: 7px;
            color: var(--text-2);
            font-size: .82rem;
            font-weight: 500;
            margin-bottom: 2px;
        }

            .nav-item i {
                width: 16px;
                font-size: .92rem;
                text-align: center;
            }

            .nav-item:hover {
                background: rgba(255,255,255,.04);
                color: var(--text-1);
            }

            .nav-item.active {
                background: var(--accent-dim);
                color: var(--accent);
            }

        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 10px 8px;
        }

        .sidebar-back {
            margin-top: auto;
            padding-top: 12px;
            border-top: 1px solid var(--border);
        }

        main {
            padding: 28px 32px 60px;
        }

        .alert {
            padding: 10px 14px;
            border-radius: 8px;
            font-size: .82rem;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .alert-error {
            background: rgba(224,88,79,.1);
            border: 1px solid rgba(224,88,79,.3);
            color: var(--danger);
        }

        .page-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 22px;
            flex-wrap: wrap;
            gap: 12px;
        }

            .page-head h1 {
                font-family: 'Plus Jakarta Sans',sans-serif;
                font-size: 1.4rem;
                font-weight: 800;
            }

            .page-head p {
                color: var(--text-2);
                font-size: .82rem;
                margin-top: 4px;
            }

        .id-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: .7rem;
            color: var(--text-3);
            background: var(--bg-input);
            border: 1px solid var(--border);
            padding: 4px 10px;
            border-radius: 20px;
            max-width: 260px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border: none;
            border-radius: 8px;
            padding: 9px 16px;
            font-size: .82rem;
            font-weight: 600;
            font-family: 'Inter',sans-serif;
        }

        .btn-accent {
            background: var(--accent);
            color: #0c0c0e;
        }

            .btn-accent:hover {
                background: #d4b360;
            }

        .btn-cancel {
            background: var(--bg-input);
            border: 1px solid var(--border);
            color: var(--text-2);
        }

            .btn-cancel:hover {
                color: var(--text-1);
            }

        .form-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 26px;
            max-width: 560px;
        }

        .form-row {
            margin-bottom: 18px;
        }

        .form-row-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .form-row label {
            display: block;
            font-size: .78rem;
            font-weight: 600;
            color: var(--text-2);
            margin-bottom: 7px;
        }

        .form-control {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 12px;
            font-size: .85rem;
            color: var(--text-1);
            font-family: 'Inter',sans-serif;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--accent-border);
                background: #1d1d20;
            }

        .form-actions {
            display: flex;
            gap: 10px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
        }

        .hint {
            font-size: .72rem;
            color: var(--text-3);
            margin-top: 5px;
        }

        .role-checks {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .role-check-item {
            display: flex;
            align-items: center;
            gap: 6px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 6px 12px 6px 10px;
        }

            .role-check-item input[type="checkbox"] {
                width: 15px;
                height: 15px;
                accent-color: var(--accent);
            }

            .role-check-item label {
                margin-bottom: 0;
                font-size: .8rem;
                color: var(--text-1);
                font-weight: 500;
            }

        .no-roles-hint {
            font-size: .78rem;
            color: var(--text-3);
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-mark"><i class="bi bi-soundwave"></i></div>
            <span class="logo-wordmark">Canlı Müzik</span>
        </div>
        <div class="sidebar-tag">Admin Panel</div>

        <a href="/AdminDashboard/Index" class="nav-item "><i class="bi bi-grid-1x2"></i> Dashboard</a>
        <a href="/AdminArtist/Index" class="nav-item"><i class="bi bi-people"></i> Sanatçılar</a>
        <a href="/AdminSong/Index" class="nav-item "><i class="bi bi-music-note-list"></i> Şarkılar</a>
        <a href="/AdminRole/Index" class="nav-item "><i class="bi bi-shield-lock"></i> Roller</a>
        <a href="/AdminUser/Index" class="nav-item active"><i class="bi bi-person-gear"></i> Kullanıcılar</a>

        <div class="sidebar-divider"></div>

        <div class="sidebar-back">
            <a href="/Song/SongList" class="nav-item"><i class="bi bi-box-arrow-left"></i> Siteye Dön</a>
            <a href="/Login/Logout" class="nav-item nav-item-danger" onclick="return confirm('Çıkış yapmak istediğinize emin misiniz?');">
                <i class="bi bi-box-arrow-right"></i> Çıkış Yap
            </a>
        </div>
    </aside>

    <main>
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error"><i class="bi bi-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
        }

        <div class="page-head">
            <div>
                <h1>Kullanıcı Güncelle</h1>
                <p>@Model.Name @Model.Surname bilgilerini düzenle</p>
            </div>
            <span class="id-badge"><i class="bi bi-hash"></i> @Model.Id</span>
        </div>

        <form class="form-card" method="post" action="/AdminUser/Update/@Model.Id">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="form-row-2col">
                <div class="form-row">
                    <label for="Name">Ad</label>
                    <input class="form-control" id="Name" name="Name" value="@Model.Name" />
                </div>
                <div class="form-row">
                    <label for="Surname">Soyad</label>
                    <input class="form-control" id="Surname" name="Surname" value="@Model.Surname" />
                </div>
            </div>

            <div class="form-row">
                <label for="UserName">Kullanıcı Adı</label>
                <input class="form-control" id="UserName" name="UserName" value="@Model.UserName" />
            </div>

            <div class="form-row">
                <label for="Email">Email</label>
                <input class="form-control" type="email" id="Email" name="Email" value="@Model.Email" />
            </div>

            <div class="form-row">
                <label for="ImageUrl">Profil Görseli URL</label>
                <input class="form-control" id="ImageUrl" name="ImageUrl" value="@Model.ImageUrl" placeholder="https://..." />
            </div>

            <div class="form-row">
                <label>Roller</label>
                @if (allRoles.Any())
                {
                    <div class="role-checks">
                        @foreach (var roleName in allRoles)
                        {
                            bool isChecked = Model.Roles != null && Model.Roles.Contains(roleName);
                            <div class="role-check-item">
                                <input type="checkbox" id="role_@roleName" name="Roles" value="@roleName" checked="@isChecked" />
                                <label for="role_@roleName">@roleName</label>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-roles-hint">Sistemde tanımlı rol bulunamadı.</div>
                }
                <div class="hint">İşaretli roller kullanıcıya atanır, işaretsiz bırakılanlar kaldırılır</div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-accent"><i class="bi bi-check-lg"></i> Güncelle</button>
                <a href="/AdminUser/Index" class="btn btn-cancel">Vazgeç</a>
            </div>
        </form>
    </main>
</body>
</html>
