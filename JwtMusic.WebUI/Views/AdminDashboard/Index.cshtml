@{
	Layout = null;
	int artistCount = ViewBag.ArtistCount;
	int songCount = ViewBag.SongCount;
	int roleCount = ViewBag.RoleCount;
	int userCount = ViewBag.UserCount;
	var roleDistribution = ViewBag.RoleDistribution as Dictionary<string, int> ?? new Dictionary<string, int>();
	int maxRoleCount = roleDistribution.Any() ? roleDistribution.Values.Max() : 1;
	if (maxRoleCount == 0) maxRoleCount = 1;

	var recentArtists = ViewBag.RecentArtists as List<JwtMusic.WebUI.Controllers.RecentItemViewModel> ?? new List<JwtMusic.WebUI.Controllers.RecentItemViewModel>();
	var recentSongs = ViewBag.RecentSongs as List<JwtMusic.WebUI.Controllers.RecentItemViewModel> ?? new List<JwtMusic.WebUI.Controllers.RecentItemViewModel>();
	var recentUsers = ViewBag.RecentUsers as List<JwtMusic.WebUI.Controllers.RecentItemViewModel> ?? new List<JwtMusic.WebUI.Controllers.RecentItemViewModel>();
	var topArtists = ViewBag.TopArtists as List<JwtMusic.WebUI.Controllers.TopArtistViewModel> ?? new List<JwtMusic.WebUI.Controllers.TopArtistViewModel>();
	int maxTopArtistCount = ViewBag.MaxTopArtistCount ?? 1;
	if (maxTopArtistCount == 0) maxTopArtistCount = 1;
}
<!DOCTYPE html>
<html lang="tr">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Dashboard — Admin</title>
	<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<style>
		:root {
			--bg-root: #0c0c0e;
			--bg-sidebar: #111113;
			--bg-card: #16161a;
			--bg-input: #1a1a1c;
			--accent: #c9a84c;
			--accent-dim: rgba(201,168,76,.12);
			--accent-border: rgba(201,168,76,.28);
			--text-1: #e8e8ea;
			--text-2: #8a8a94;
			--text-3: #46464e;
			--border: rgba(255,255,255,.07);
			--danger: #e0584f;
			--success: #3fb27f;
			--info: #5b9fd4;
			--purple: #a48ce0;
			--radius: 10px;
			--sidebar-w: 220px;
		}

		* {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
		}

		body {
			font-family: 'Inter',sans-serif;
			background: var(--bg-root);
			color: var(--text-1);
			display: grid;
			grid-template-columns: var(--sidebar-w) 1fr;
			min-height: 100vh;
		}

		a {
			text-decoration: none;
			color: inherit;
		}

		button {
			font-family: inherit;
			cursor: pointer;
		}

		.sidebar {
			background: var(--bg-sidebar);
			border-right: 1px solid var(--border);
			padding: 20px 12px;
			display: flex;
			flex-direction: column;
		}

		.sidebar-logo {
			display: flex;
			align-items: center;
			gap: 9px;
			padding: 6px 8px 22px;
		}

		.logo-mark {
			width: 26px;
			height: 26px;
			background: var(--accent);
			border-radius: 6px;
			display: flex;
			align-items: center;
			justify-content: center;
		}

			.logo-mark i {
				color: #0c0c0e;
				font-size: .8rem;
			}

		.logo-wordmark {
			font-family: 'Plus Jakarta Sans',sans-serif;
			font-weight: 800;
			font-size: .85rem;
		}

		.sidebar-tag {
			font-size: .6rem;
			font-weight: 700;
			letter-spacing: .08em;
			color: var(--accent);
			text-transform: uppercase;
			margin: 0 8px 14px;
		}

		.nav-item {
			display: flex;
			align-items: center;
			gap: 9px;
			padding: 8px 10px;
			border-radius: 7px;
			color: var(--text-2);
			font-size: .82rem;
			font-weight: 500;
			margin-bottom: 2px;
		}

			.nav-item i {
				width: 16px;
				font-size: .92rem;
				text-align: center;
			}

			.nav-item:hover {
				background: rgba(255,255,255,.04);
				color: var(--text-1);
			}

			.nav-item.active {
				background: var(--accent-dim);
				color: var(--accent);
			}

		.sidebar-divider {
			height: 1px;
			background: var(--border);
			margin: 10px 8px;
		}

		.sidebar-back {
			margin-top: auto;
			padding-top: 12px;
			border-top: 1px solid var(--border);
		}

		main {
			padding: 28px 32px 60px;
		}

		.page-head {
			margin-bottom: 26px;
		}

			.page-head h1 {
				font-family: 'Plus Jakarta Sans',sans-serif;
				font-size: 1.4rem;
				font-weight: 800;
			}

			.page-head p {
				color: var(--text-2);
				font-size: .82rem;
				margin-top: 4px;
			}

		.stats-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 14px;
			margin-bottom: 24px;
		}

		.stat-card {
			background: var(--bg-card);
			border: 1px solid var(--border);
			border-radius: var(--radius);
			padding: 20px;
			display: flex;
			flex-direction: column;
			gap: 10px;
		}

		.stat-icon {
			width: 38px;
			height: 38px;
			border-radius: 9px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1rem;
		}

			.stat-icon.artist {
				background: rgba(201,168,76,.12);
				color: var(--accent);
			}

			.stat-icon.song {
				background: rgba(91,159,212,.12);
				color: var(--info);
			}

			.stat-icon.role {
				background: rgba(164,140,224,.12);
				color: var(--purple);
			}

			.stat-icon.user {
				background: rgba(63,178,127,.12);
				color: var(--success);
			}

		.stat-value {
			font-family: 'Plus Jakarta Sans',sans-serif;
			font-size: 1.7rem;
			font-weight: 800;
		}

			.stat-value.error {
				color: var(--danger);
				font-size: .95rem;
				font-weight: 600;
			}

		.stat-label {
			font-size: .78rem;
			color: var(--text-2);
			font-weight: 500;
		}

		.content-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: 18px;
			margin-bottom: 18px;
		}

			.content-grid.two-col {
				grid-template-columns: 1fr 1fr;
			}

		.card {
			background: var(--bg-card);
			border: 1px solid var(--border);
			border-radius: var(--radius);
			padding: 22px;
		}

			.card h2 {
				font-family: 'Plus Jakarta Sans',sans-serif;
				font-size: 1rem;
				font-weight: 700;
				margin-bottom: 4px;
			}

			.card .card-sub {
				font-size: .78rem;
				color: var(--text-2);
				margin-bottom: 18px;
			}

		.role-bar-row {
			display: flex;
			align-items: center;
			gap: 12px;
			margin-bottom: 14px;
		}

			.role-bar-row:last-child {
				margin-bottom: 0;
			}

		.role-bar-label {
			width: 110px;
			font-size: .8rem;
			font-weight: 600;
			color: var(--text-1);
			flex-shrink: 0;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.role-bar-track {
			flex: 1;
			height: 10px;
			background: var(--bg-input);
			border-radius: 20px;
			overflow: hidden;
		}

		.role-bar-fill {
			height: 100%;
			background: linear-gradient(90deg, var(--accent), #d4b360);
			border-radius: 20px;
		}

		.role-bar-count {
			width: 32px;
			text-align: right;
			font-size: .8rem;
			color: var(--text-2);
			font-weight: 600;
			flex-shrink: 0;
		}

		.empty-hint {
			font-size: .82rem;
			color: var(--text-3);
		}

		.recent-list {
			list-style: none;
			display: flex;
			flex-direction: column;
			gap: 10px;
		}

			.recent-list li {
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: .84rem;
				color: var(--text-1);
				padding-bottom: 10px;
				border-bottom: 1px solid var(--border);
			}

				.recent-list li:last-child {
					border-bottom: none;
					padding-bottom: 0;
				}

				.recent-list li i {
					color: var(--accent);
					font-size: .9rem;
					flex-shrink: 0;
				}

		.recent-sub {
			color: var(--text-2);
			font-size: .78rem;
		}

		.quick-links {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 12px;
		}

		.quick-link {
			display: flex;
			align-items: center;
			gap: 10px;
			background: var(--bg-input);
			border: 1px solid var(--border);
			border-radius: 9px;
			padding: 14px;
			font-size: .82rem;
			font-weight: 600;
			color: var(--text-1);
		}

			.quick-link:hover {
				border-color: var(--accent-border);
				background: var(--accent-dim);
				color: var(--accent);
			}

			.quick-link i {
				font-size: 1rem;
			}

		@@media (max-width: 900px) {
			.stats-grid {
				grid-template-columns: repeat(2, 1fr);
			}

			.content-grid.two-col {
				grid-template-columns: 1fr;
			}

			.quick-links {
				grid-template-columns: repeat(2, 1fr);
			}
		}
	</style>
</head>
<body>
	<aside class="sidebar">
		<div class="sidebar-logo">
			<div class="logo-mark"><i class="bi bi-soundwave"></i></div>
			<span class="logo-wordmark">Canlı Müzik</span>
		</div>
		<div class="sidebar-tag">Admin Panel</div>

		<a href="/AdminDashboard/Index" class="nav-item active"><i class="bi bi-grid-1x2"></i> Dashboard</a>
		<a href="/AdminArtist/Index" class="nav-item"><i class="bi bi-people"></i> Sanatçılar</a>
		<a href="/AdminSong/Index" class="nav-item"><i class="bi bi-music-note-list"></i> Şarkılar</a>
		<a href="/AdminRole/Index" class="nav-item"><i class="bi bi-shield-lock"></i> Roller</a>
		<a href="/AdminUser/Index" class="nav-item"><i class="bi bi-person-gear"></i> Kullanıcılar</a>

		<div class="sidebar-divider"></div>

		<div class="sidebar-back">
			<a href="/Song/SongList" class="nav-item"><i class="bi bi-box-arrow-left"></i> Siteye Dön</a>
			<a href="/Login/Logout" class="nav-item nav-item-danger" onclick="return confirm('Çıkış yapmak istediğinize emin misiniz?');">
				<i class="bi bi-box-arrow-right"></i> Çıkış Yap
			</a>
		</div>
	</aside>

	<main>
		<div class="page-head">
			<h1>Dashboard</h1>
			<p>Canlı Müzik yönetim paneline hoş geldiniz</p>
		</div>

		<div class="stats-grid">
			<div class="stat-card">
				<div class="stat-icon artist"><i class="bi bi-people-fill"></i></div>
				@if (artistCount >= 0)
				{
					<div class="stat-value">@artistCount</div>
				}
				else
				{
					<div class="stat-value error"><i class="bi bi-exclamation-triangle"></i> Veri alınamadı</div>
				}
				<div class="stat-label">Toplam Sanatçı</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon song"><i class="bi bi-music-note-beamed"></i></div>
				@if (songCount >= 0)
				{
					<div class="stat-value">@songCount</div>
				}
				else
				{
					<div class="stat-value error"><i class="bi bi-exclamation-triangle"></i> Veri alınamadı</div>
				}
				<div class="stat-label">Toplam Şarkı</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon role"><i class="bi bi-shield-check"></i></div>
				@if (roleCount >= 0)
				{
					<div class="stat-value">@roleCount</div>
				}
				else
				{
					<div class="stat-value error"><i class="bi bi-exclamation-triangle"></i> Veri alınamadı</div>
				}
				<div class="stat-label">Toplam Rol</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon user"><i class="bi bi-person-fill"></i></div>
				<div class="stat-value">@userCount</div>
				<div class="stat-label">Toplam Kullanıcı</div>
			</div>
		</div>

		<div class="content-grid">
			<div class="card">
				<h2>Rol Dağılımı</h2>
				<div class="card-sub">Kullanıcıların üyelik rollerine göre dağılımı</div>

				@if (roleDistribution.Any())
				{
					foreach (var kvp in roleDistribution.OrderByDescending(r => r.Value))
					{
						double percent = (double)kvp.Value / maxRoleCount * 100;
						<div class="role-bar-row">
							<div class="role-bar-label">@kvp.Key</div>
							<div class="role-bar-track">
								<div class="role-bar-fill" style="width:@(percent.ToString(System.Globalization.CultureInfo.InvariantCulture))%;"></div>
							</div>
							<div class="role-bar-count">@kvp.Value</div>
						</div>
					}
				}
				else
				{
					<div class="empty-hint">Henüz kullanıcı verisi bulunmuyor.</div>
				}
			</div>


		</div>

		<div class="content-grid two-col">
			<div class="card">
				<h2>Son Eklenen Sanatçılar</h2>
				<div class="card-sub">En son eklenen 5 sanatçı</div>
				@if (recentArtists.Any())
				{
					<ul class="recent-list">
						@foreach (var item in recentArtists)
						{
							<li>
								<i class="bi bi-person-circle"></i>
								<span>@item.Title</span>
							</li>
						}
					</ul>
				}
				else
				{
					<div class="empty-hint">Henüz sanatçı verisi bulunmuyor.</div>
				}
			</div>

			<div class="card">
				<h2>Son Eklenen Şarkılar</h2>
				<div class="card-sub">En son eklenen 5 şarkı</div>
				@if (recentSongs.Any())
				{
					<ul class="recent-list">
						@foreach (var item in recentSongs)
						{
							<li>
								<i class="bi bi-music-note"></i>
								<span>@item.Title</span>
								@if (!string.IsNullOrEmpty(item.SubTitle))
								{
									<span class="recent-sub">— @item.SubTitle</span>
								}
							</li>
						}
					</ul>
				}
				else
				{
					<div class="empty-hint">Henüz şarkı verisi bulunmuyor.</div>
				}
			</div>

			<div class="card">
				<h2>Son Kayıt Olan Kullanıcılar</h2>
				<div class="card-sub">En son kayıt olan 5 kullanıcı</div>
				@if (recentUsers.Any())
				{
					<ul class="recent-list">
						@foreach (var item in recentUsers)
						{
							<li>
								<i class="bi bi-person"></i>
								<span>@item.Title</span>
								@if (!string.IsNullOrEmpty(item.SubTitle))
								{
									<span class="recent-sub">— @item.SubTitle</span>
								}
							</li>
						}
					</ul>
				}
				else
				{
					<div class="empty-hint">Henüz kullanıcı verisi bulunmuyor.</div>
				}
			</div>

			<div class="card">
				<h2>En Çok Şarkısı Olan Sanatçılar</h2>
				<div class="card-sub">Şarkı sayısına göre ilk 5 sanatçı</div>
				@if (topArtists.Any())
				{
					foreach (var artist in topArtists)
					{
						double percent = (double)artist.SongCount / maxTopArtistCount * 100;
						<div class="role-bar-row">
							<div class="role-bar-label">@artist.ArtistName</div>
							<div class="role-bar-track">
								<div class="role-bar-fill" style="width:@(percent.ToString(System.Globalization.CultureInfo.InvariantCulture))%;"></div>
							</div>
							<div class="role-bar-count">@artist.SongCount</div>
						</div>
					}
				}
				else
				{
					<div class="empty-hint">Henüz şarkı verisi bulunmuyor.</div>
				}
			</div>
		</div>
		<div class="content-grid">
			<div class="card">
				<h2>Hızlı Erişim</h2>
				<div class="card-sub">Sık kullanılan işlemler</div>

				<div class="quick-links">
					<a href="/AdminArtist/Create" class="quick-link"><i class="bi bi-plus-circle"></i> Yeni Sanatçı</a>
					<a href="/AdminSong/Create" class="quick-link"><i class="bi bi-plus-circle"></i> Yeni Şarkı</a>
					<a href="/AdminRole/Create" class="quick-link"><i class="bi bi-plus-circle"></i> Yeni Rol</a>
					<a href="/AdminUser/Create" class="quick-link"><i class="bi bi-plus-circle"></i> Yeni Kullanıcı</a>
				</div>
			</div>
		</div>
	</main>
</body>
</html>
