@using JwtMusic.WebUI.Dtos
@model ResultArtistDto
@{
    Layout = null;
    var token = ViewBag.Token as string ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sanatçı Güncelle — Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --bg-root: #0c0c0e;
            --bg-sidebar: #111113;
            --bg-card: #16161a;
            --bg-input: #1a1a1c;
            --accent: #c9a84c;
            --accent-dim: rgba(201,168,76,0.12);
            --accent-border: rgba(201,168,76,0.28);
            --text-1: #e8e8ea;
            --text-2: #8a8a94;
            --text-3: #46464e;
            --border: rgba(255,255,255,0.07);
            --danger: #e0584f;
            --radius: 10px;
            --sidebar-w: 220px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-root);
            color: var(--text-1);
            display: grid;
            grid-template-columns: var(--sidebar-w) 1fr;
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
            cursor: pointer;
        }

        /* SIDEBAR */
        .sidebar {
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            padding: 20px 12px;
            display: flex;
            flex-direction: column;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 6px 8px 22px;
        }

        .logo-mark {
            width: 26px;
            height: 26px;
            background: var(--accent);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .logo-mark i {
                color: #0c0c0e;
                font-size: 0.8rem;
            }

        .logo-wordmark {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 0.85rem;
        }

        .sidebar-tag {
            font-size: 0.6rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: var(--accent);
            text-transform: uppercase;
            margin: 0 8px 14px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 10px;
            border-radius: 7px;
            color: var(--text-2);
            font-size: 0.82rem;
            font-weight: 500;
            margin-bottom: 2px;
        }

            .nav-item i {
                width: 16px;
                font-size: 0.92rem;
                text-align: center;
            }

            .nav-item:hover {
                background: rgba(255,255,255,0.04);
                color: var(--text-1);
            }

            .nav-item.active {
                background: var(--accent-dim);
                color: var(--accent);
            }

        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 10px 8px;
        }

        .sidebar-back {
            margin-top: auto;
            padding-top: 12px;
            border-top: 1px solid var(--border);
        }

        /* MAIN */
        main {
            padding: 28px 32px 60px;
            display: flex;
            justify-content: center;
        }

        .form-wrap {
            width: 100%;
            max-width: 520px;
        }

        .page-head {
            margin-bottom: 22px;
        }

        .breadcrumb {
            font-size: 0.78rem;
            color: var(--text-3);
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .breadcrumb a {
                color: var(--text-2);
            }

                .breadcrumb a:hover {
                    color: var(--accent);
                }

        .page-head h1 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.4rem;
            font-weight: 800;
        }

        .page-head p {
            color: var(--text-2);
            font-size: 0.82rem;
            margin-top: 4px;
        }

        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px;
        }

        .field {
            margin-bottom: 18px;
        }

            .field label {
                display: block;
                font-size: 0.78rem;
                font-weight: 600;
                color: var(--text-2);
                margin-bottom: 7px;
            }

            .field input, .field textarea {
                width: 100%;
                background: var(--bg-input);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 10px 13px;
                color: var(--text-1);
                font-size: 0.86rem;
                font-family: 'Inter', sans-serif;
                outline: none;
                transition: border-color 0.2s;
            }

                .field input:focus, .field textarea:focus {
                    border-color: var(--accent-border);
                }

            .field textarea {
                resize: vertical;
                min-height: 90px;
            }

        .field-hint {
            font-size: 0.72rem;
            color: var(--text-3);
            margin-top: 5px;
        }

        .preview-wrap {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 18px;
            padding: 14px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 8px;
        }

        .preview-img {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            object-fit: cover;
            background: var(--bg-root);
            border: 1px solid var(--border);
        }

        .preview-label {
            font-size: 0.76rem;
            color: var(--text-3);
        }

        .preview-id {
            font-size: 0.72rem;
            color: var(--text-3);
            margin-left: auto;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 22px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            font-size: 0.84rem;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
        }

        .btn-accent {
            background: var(--accent);
            color: #0c0c0e;
        }

            .btn-accent:hover {
                background: #d4b360;
            }

        .btn-outline {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-2);
        }

            .btn-outline:hover {
                color: var(--text-1);
                border-color: var(--text-3);
            }

        .alert-error {
            background: rgba(224,88,79,0.1);
            border: 1px solid rgba(224,88,79,0.3);
            color: var(--danger);
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 0.82rem;
            margin-bottom: 18px;
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-mark"><i class="bi bi-soundwave"></i></div>
            <span class="logo-wordmark">Canlı Müzik</span>
        </div>
        <div class="sidebar-tag">Admin Panel</div>

        <a href="/AdminArtist/Index" class="nav-item active"><i class="bi bi-people"></i> Sanatçılar</a>
        <a href="/AdminSong/Index" class="nav-item"><i class="bi bi-music-note-list"></i> Şarkılar</a>
        <a href="/AdminUser/Index" class="nav-item"><i class="bi bi-person-gear"></i> Kullanıcılar</a>

        <div class="sidebar-divider"></div>

        <div class="sidebar-back">
            <a href="/Song/SongList" class="nav-item"><i class="bi bi-box-arrow-left"></i> Siteye Dön</a>
        </div>
    </aside>

    <main>
        <div class="form-wrap">
            <div class="page-head">
                <div class="breadcrumb">
                    <a href="/AdminArtist/Index">Sanatçılar</a>
                    <i class="bi bi-chevron-right" style="font-size:0.65rem;"></i>
                    <span>Güncelle</span>
                </div>
                <h1>Sanatçıyı Güncelle</h1>
                <p>@Model.Name adlı sanatçının bilgilerini düzenle.</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert-error">@TempData["ErrorMessage"]</div>
            }

            <div class="card">
                <div class="preview-wrap">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img id="previewImg" class="preview-img" src="@Model.ImageUrl" alt="@Model.Name"
                             onerror="this.style.display='none'; document.getElementById('previewFallback').style.display='flex';" />
                        <div id="previewFallback" class="preview-img" style="display:none; align-items:center; justify-content:center;">
                            <i class="bi bi-image" style="color: var(--text-3);"></i>
                        </div>
                    }
                    else
                    {
                        <img id="previewImg" class="preview-img" src="" alt="" style="display:none;" />
                        <div id="previewFallback" class="preview-img" style="display:flex; align-items:center; justify-content:center;">
                            <i class="bi bi-image" style="color: var(--text-3);"></i>
                        </div>
                    }
                    <span class="preview-label">Mevcut görsel</span>
                    <span class="preview-id">#@Model.ArtistId</span>
                </div>

                <form method="post" action="/AdminArtist/Update/@Model.ArtistId">
                    <div class="field">
                        <label>Sanatçı Adı</label>
                        <input type="text" name="name" value="@Model.Name" required />
                    </div>
                    <div class="field">
                        <label>Bio</label>
                        <textarea name="bio">@Model.Bio</textarea>
                    </div>
                    <div class="field">
                        <label>Resim URL</label>
                        <input type="text" name="imageUrl" id="imageUrlInput" value="@Model.ImageUrl" oninput="updatePreview(this.value)" />
                        <div class="field-hint">Sanatçı kartlarında ve detay sayfasında bu görsel kullanılacak.</div>
                    </div>

                    <div class="form-actions">
                        <a href="/AdminArtist/Index" class="btn btn-outline">Vazgeç</a>
                        <button type="submit" class="btn btn-accent"><i class="bi bi-check-lg"></i> Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script>
        function updatePreview(url) {
            const img = document.getElementById('previewImg');
            const fallback = document.getElementById('previewFallback');

            if (!url) {
                img.style.display = 'none';
                fallback.style.display = 'flex';
                return;
            }

            img.onload = function () {
                img.style.display = 'block';
                fallback.style.display = 'none';
            };
            img.onerror = function () {
                img.style.display = 'none';
                fallback.style.display = 'flex';
            };
            img.src = url;
        }
    </script>
</body>
</html>
