@using JwtMusic.WebUI.Dtos.ArtistDtos
@model CreateArtistDto
@{
    Layout = null;
    var roles = ViewBag.Roles as List<Dictionary<string, string>> ?? new List<Dictionary<string, string>>();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yeni Sanatçı — Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --bg-root: #0c0c0e;
            --bg-sidebar: #111113;
            --bg-card: #16161a;
            --bg-input: #1a1a1c;
            --bg-row-hover: #18181c;
            --accent: #c9a84c;
            --accent-dim: rgba(201,168,76,.12);
            --accent-border: rgba(201,168,76,.28);
            --text-1: #e8e8ea;
            --text-2: #8a8a94;
            --text-3: #46464e;
            --border: rgba(255,255,255,.07);
            --danger: #e0584f;
            --success: #3fb27f;
            --radius: 10px;
            --sidebar-w: 220px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter',sans-serif;
            background: var(--bg-root);
            color: var(--text-1);
            display: grid;
            grid-template-columns: var(--sidebar-w) 1fr;
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
            cursor: pointer;
        }

        .sidebar {
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            padding: 20px 12px;
            display: flex;
            flex-direction: column;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 6px 8px 22px;
        }

        .logo-mark {
            width: 26px;
            height: 26px;
            background: var(--accent);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .logo-mark i {
                color: #0c0c0e;
                font-size: .8rem;
            }

        .logo-wordmark {
            font-family: 'Plus Jakarta Sans',sans-serif;
            font-weight: 800;
            font-size: .85rem;
        }

        .sidebar-tag {
            font-size: .6rem;
            font-weight: 700;
            letter-spacing: .08em;
            color: var(--accent);
            text-transform: uppercase;
            margin: 0 8px 14px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 10px;
            border-radius: 7px;
            color: var(--text-2);
            font-size: .82rem;
            font-weight: 500;
            margin-bottom: 2px;
        }

            .nav-item i {
                width: 16px;
                font-size: .92rem;
                text-align: center;
            }

            .nav-item:hover {
                background: rgba(255,255,255,.04);
                color: var(--text-1);
            }

            .nav-item.active {
                background: var(--accent-dim);
                color: var(--accent);
            }

        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 10px 8px;
        }

        .sidebar-back {
            margin-top: auto;
            padding-top: 12px;
            border-top: 1px solid var(--border);
        }

        main {
            padding: 28px 32px 60px;
        }

        .alert {
            padding: 10px 14px;
            border-radius: 8px;
            font-size: .82rem;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .alert-success {
            background: rgba(63,178,127,.1);
            border: 1px solid rgba(63,178,127,.3);
            color: var(--success);
        }

        .alert-error {
            background: rgba(224,88,79,.1);
            border: 1px solid rgba(224,88,79,.3);
            color: var(--danger);
        }

        .page-head {
            margin-bottom: 22px;
        }

            .page-head h1 {
                font-family: 'Plus Jakarta Sans',sans-serif;
                font-size: 1.4rem;
                font-weight: 800;
            }

            .page-head p {
                color: var(--text-2);
                font-size: .82rem;
                margin-top: 4px;
            }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border: none;
            border-radius: 8px;
            padding: 9px 16px;
            font-size: .82rem;
            font-weight: 600;
            font-family: 'Inter',sans-serif;
        }

        .btn-accent {
            background: var(--accent);
            color: #0c0c0e;
        }

            .btn-accent:hover {
                background: #d4b360;
            }

        .btn-cancel {
            background: var(--bg-input);
            border: 1px solid var(--border);
            color: var(--text-2);
        }

            .btn-cancel:hover {
                color: var(--text-1);
            }

        .form-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 26px;
            max-width: 640px;
        }

        .form-row {
            margin-bottom: 18px;
        }

            .form-row label {
                display: block;
                font-size: .78rem;
                font-weight: 600;
                color: var(--text-2);
                margin-bottom: 7px;
            }

        .form-control {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 12px;
            font-size: .85rem;
            color: var(--text-1);
            font-family: 'Inter',sans-serif;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--accent-border);
                background: #1d1d20;
            }

        textarea.form-control {
            resize: vertical;
            min-height: 90px;
        }

        select.form-control {
            appearance: none;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8'><path d='M1 1l5 5 5-5' stroke='%238a8a94' stroke-width='1.5' fill='none' fill-rule='evenodd'/></svg>");
            background-repeat: no-repeat;
            background-position: right 12px center;
            padding-right: 32px;
        }

        .check-row {
            display: flex;
            align-items: center;
            gap: 9px;
        }

            .check-row input[type="checkbox"] {
                width: 17px;
                height: 17px;
                accent-color: var(--accent);
            }

            .check-row label {
                margin-bottom: 0;
                color: var(--text-1);
                font-weight: 500;
                font-size: .84rem;
            }

        .form-actions {
            display: flex;
            gap: 10px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
        }

        .hint {
            font-size: .72rem;
            color: var(--text-3);
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-mark"><i class="bi bi-soundwave"></i></div>
            <span class="logo-wordmark">Canlı Müzik</span>
        </div>
        <div class="sidebar-tag">Admin Panel</div>
        <a href="/AdminArtist/Index" class="nav-item active"><i class="bi bi-people"></i> Sanatçılar</a>
        <a href="/AdminSong/Index" class="nav-item"><i class="bi bi-music-note-list"></i> Şarkılar</a>
        <a href="/AdminUser/Index" class="nav-item"><i class="bi bi-person-gear"></i> Kullanıcılar</a>
        <div class="sidebar-divider"></div>
        <div class="sidebar-back">
            <a href="/Song/SongList" class="nav-item"><i class="bi bi-box-arrow-left"></i> Siteye Dön</a>
        </div>
    </aside>

    <main>
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error"><i class="bi bi-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
        }

        <div class="page-head">
            <h1>Yeni Sanatçı Ekle</h1>
            <p>Yeni bir sanatçı kaydı oluştur</p>
        </div>


        <form class="form-card" method="post" action="/AdminArtist/Create">
            <div class="form-row">
                <label for="Name">Sanatçı Adı</label>
                <input class="form-control" id="Name" name="Name" value="@Model.Name" placeholder="Örn. Sezen Aksu" />
            </div>

            <div class="form-row">
                <label for="ImageUrl">Görsel URL</label>
                <input class="form-control" id="ImageUrl" name="ImageUrl" value="@Model.ImageUrl" placeholder="https://..." />
                <div class="hint">Sanatçı fotoğrafının bağlantısı</div>
            </div>

            <div class="form-row">
                <label for="Bio">Biyografi</label>
                <textarea class="form-control" id="Bio" name="Bio" placeholder="Sanatçı hakkında kısa bilgi...">@Model.Bio</textarea>
            </div>

            <div class="form-row">
                <label for="MonthlyListeners">Aylık Dinleyici Sayısı</label>
                <input class="form-control" type="number" id="MonthlyListeners" name="MonthlyListeners" value="@Model.MonthlyListeners" min="0" />
            </div>

            <div class="form-row">
                <label for="RequiredRole">Gerekli Rol</label>
                <select class="form-control" id="RequiredRole" name="RequiredRole" required>
                    <option value="">Rol Seçiniz</option>
                    @foreach (var role in roles)
                    {
                        <option value="@role["Id"]" selected="@(Model.RequiredRole == role["Id"])">@role["Name"]</option>
                    }
                </select>
                <div class="hint">Bu sanatçıya erişim için gereken minimum üyelik</div>
            </div>

            <div class="form-row check-row">
                <input type="checkbox" id="IsVerified" name="IsVerified" value="true" checked="@Model.IsVerified" />
                <input type="hidden" name="IsVerified" value="false" />
                <label for="IsVerified">Doğrulanmış sanatçı</label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-accent"><i class="bi bi-check-lg"></i> Kaydet</button>
                <a href="/AdminArtist/Index" class="btn btn-cancel">Vazgeç</a>
            </div>
        </form>
    </main>
</body>
</html>
