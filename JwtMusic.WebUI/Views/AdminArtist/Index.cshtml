@model List<JwtMusic.WebUI.Dtos.ArtistDtos.ResultArtistDto>
@{
    Layout = null;
    var token = ViewBag.Token as string ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sanatçı Yönetimi — Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --bg-root: #0c0c0e;
            --bg-sidebar: #111113;
            --bg-card: #16161a;
            --bg-input: #1a1a1c;
            --bg-row-hover: #18181c;
            --accent: #c9a84c;
            --accent-dim: rgba(201,168,76,0.12);
            --accent-border: rgba(201,168,76,0.28);
            --text-1: #e8e8ea;
            --text-2: #8a8a94;
            --text-3: #46464e;
            --border: rgba(255,255,255,0.07);
            --danger: #e0584f;
            --radius: 10px;
            --sidebar-w: 220px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-root);
            color: var(--text-1);
            display: grid;
            grid-template-columns: var(--sidebar-w) 1fr;
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
            cursor: pointer;
        }

        /* SIDEBAR */
        .sidebar {
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            padding: 20px 12px;
            display: flex;
            flex-direction: column;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 6px 8px 22px;
        }

        .logo-mark {
            width: 26px;
            height: 26px;
            background: var(--accent);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .logo-mark i {
                color: #0c0c0e;
                font-size: 0.8rem;
            }

        .logo-wordmark {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 0.85rem;
        }

        .sidebar-tag {
            font-size: 0.6rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: var(--accent);
            text-transform: uppercase;
            margin: 0 8px 14px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 10px;
            border-radius: 7px;
            color: var(--text-2);
            font-size: 0.82rem;
            font-weight: 500;
            margin-bottom: 2px;
        }

            .nav-item i {
                width: 16px;
                font-size: 0.92rem;
                text-align: center;
            }

            .nav-item:hover {
                background: rgba(255,255,255,0.04);
                color: var(--text-1);
            }

            .nav-item.active {
                background: var(--accent-dim);
                color: var(--accent);
            }

        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 10px 8px;
        }

        .sidebar-back {
            margin-top: auto;
            padding-top: 12px;
            border-top: 1px solid var(--border);
        }

        /* MAIN */
        main {
            padding: 28px 32px 60px;
        }

        .page-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 22px;
            flex-wrap: wrap;
            gap: 12px;
        }

            .page-head h1 {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 1.4rem;
                font-weight: 800;
            }

            .page-head p {
                color: var(--text-2);
                font-size: 0.82rem;
                margin-top: 4px;
            }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border: none;
            border-radius: 8px;
            padding: 9px 16px;
            font-size: 0.82rem;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
        }

        .btn-accent {
            background: var(--accent);
            color: #0c0c0e;
        }

            .btn-accent:hover {
                background: #d4b360;
            }

        .btn-outline {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-2);
        }

            .btn-outline:hover {
                color: var(--text-1);
                border-color: var(--text-3);
            }

        .btn-danger-sm {
            background: rgba(224,88,79,0.1);
            border: 1px solid rgba(224,88,79,0.3);
            color: var(--danger);
            padding: 6px 10px;
            font-size: 0.78rem;
            border-radius: 7px;
        }

            .btn-danger-sm:hover {
                background: rgba(224,88,79,0.18);
            }

        .btn-edit-sm {
            background: var(--bg-input);
            border: 1px solid var(--border);
            color: var(--text-2);
            padding: 6px 10px;
            font-size: 0.78rem;
            border-radius: 7px;
        }

            .btn-edit-sm:hover {
                color: var(--text-1);
                border-color: var(--text-3);
            }

        /* TABLE */
        .table-wrap {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            text-align: left;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--text-3);
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
        }

        tbody td {
            padding: 11px 16px;
            font-size: 0.85rem;
            border-bottom: 1px solid var(--border);
            color: var(--text-1);
            vertical-align: middle;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover {
            background: var(--bg-row-hover);
        }

        .artist-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .artist-thumb {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            object-fit: cover;
            background: var(--bg-input);
            flex-shrink: 0;
        }

        .id-col {
            color: var(--text-3);
            font-size: 0.78rem;
            width: 56px;
        }

        .bio-col {
            color: var(--text-2);
            max-width: 260px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .actions-col {
            display: flex;
            gap: 6px;
            justify-content: flex-end;
        }

        .empty-row td {
            text-align: center;
            padding: 40px;
            color: var(--text-3);
        }

        /* PAGINATION */
        .pagination-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 16px;
            border-top: 1px solid var(--border);
            flex-wrap: wrap;
            gap: 10px;
        }

        .pagination-info {
            font-size: 0.78rem;
            color: var(--text-3);
        }

        .pagination-pages {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .page-link {
            min-width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 7px;
            font-size: 0.8rem;
            color: var(--text-2);
            border: 1px solid transparent;
            padding: 0 8px;
        }

            .page-link:hover {
                background: var(--bg-input);
                color: var(--text-1);
            }

            .page-link.active {
                background: var(--accent-dim);
                border-color: var(--accent-border);
                color: var(--accent);
                font-weight: 700;
            }

            .page-link.disabled {
                opacity: 0.35;
                pointer-events: none;
            }

        .page-dots {
            color: var(--text-3);
            font-size: 0.8rem;
            padding: 0 4px;
        }

        /* MODAL */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.6);
            align-items: center;
            justify-content: center;
            z-index: 200;
        }

            .modal-overlay.open {
                display: flex;
            }

        .modal-box {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            width: 420px;
            max-width: 92vw;
            padding: 22px;
        }

            .modal-box h2 {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 1.05rem;
                font-weight: 700;
                margin-bottom: 16px;
            }

        .field {
            margin-bottom: 13px;
        }

            .field label {
                display: block;
                font-size: 0.74rem;
                color: var(--text-2);
                margin-bottom: 5px;
            }

            .field input, .field textarea {
                width: 100%;
                background: var(--bg-input);
                border: 1px solid var(--border);
                border-radius: 7px;
                padding: 9px 12px;
                color: var(--text-1);
                font-size: 0.84rem;
                font-family: 'Inter', sans-serif;
                outline: none;
            }

                .field input:focus, .field textarea:focus {
                    border-color: var(--accent-border);
                }

            .field textarea {
                resize: vertical;
                min-height: 64px;
            }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-top: 18px;
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-mark"><i class="bi bi-soundwave"></i></div>
            <span class="logo-wordmark">Canlı Müzik</span>
        </div>
        <div class="sidebar-tag">Admin Panel</div>

        <a href="/AdminArtist/Index" class="nav-item active"><i class="bi bi-people"></i> Sanatçılar</a>
        <a href="/AdminSong/Index" class="nav-item"><i class="bi bi-music-note-list"></i> Şarkılar</a>
        <a href="/AdminUser/Index" class="nav-item"><i class="bi bi-person-gear"></i> Kullanıcılar</a>

        <div class="sidebar-divider"></div>

        <div class="sidebar-back">
            <a href="/Song/SongList" class="nav-item"><i class="bi bi-box-arrow-left"></i> Siteye Dön</a>
        </div>
    </aside>

    <main>
        <div class="page-head">
            <div>
                <h1>Sanatçı Yönetimi</h1>
                <p>@ViewBag.TotalCount sanatçı kayıtlı — sayfa @ViewBag.CurrentPage / @(ViewBag.TotalPages > 0 ? ViewBag.TotalPages : 1)</p>
            </div>
            <button class="btn btn-accent" onclick="openCreateModal()">
                <i class="bi bi-plus-lg"></i> Yeni Sanatçı
            </button>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div style="background: rgba(224,88,79,0.1); border: 1px solid rgba(224,88,79,0.3); color: #e0584f; padding: 10px 14px; border-radius: 8px; font-size: 0.82rem; margin-bottom: 16px;">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th class="id-col">ID</th>
                        <th>Sanatçı</th>
                        <th>Bio</th>
                        <th>Aylık Dinleyici</th>
                        <th style="text-align:right;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var artist in Model)
                        {
                            <tr>
                                <td class="id-col">#@artist.ArtistId</td>
                                <td>
                                    <div class="artist-cell">
                                        @if (!string.IsNullOrEmpty(artist.ImageUrl))
                                        {
                                            <img src="@artist.ImageUrl" class="artist-thumb" alt="@artist.Name" />
                                        }
                                        else
                                        {
                                            <div class="artist-thumb"></div>
                                        }
                                        <span>@artist.Name</span>
                                    </div>
                                </td>
                                <td class="bio-col">@(string.IsNullOrEmpty(artist.Bio) ? "—" : artist.Bio)</td>
                                <td>@artist.MonthlyListeners.ToString("N0")</td>
                                <td>
                                    <div class="actions-col">
                                        <button class="btn-edit-sm"
                                                onclick="openUpdateModal(@artist.ArtistId, '@Html.Raw(artist.Name.Replace("'", "\\'"))', '@Html.Raw((artist.Bio ?? "").Replace("'", "\\'"))', '@Html.Raw((artist.ImageUrl ?? "").Replace("'", "\\'"))')">
                                            <i class="bi bi-pencil"></i> Düzenle
                                        </button>
                                        <form method="post" action="/AdminArtist/Delete/@artist.ArtistId" onsubmit="return confirm('Bu sanatçıyı silmek istediğine emin misin?');">
                                            <button type="submit" class="btn-danger-sm"><i class="bi bi-trash"></i> Sil</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="empty-row">
                            <td colspan="5">Henüz sanatçı eklenmemiş.</td>
                        </tr>
                    }
                </tbody>
            </table>

            @{
                int currentPage = ViewBag.CurrentPage;
                int totalPages = ViewBag.TotalPages;
                int pageSize = ViewBag.PageSize;
                int totalCount = ViewBag.TotalCount;
                int rangeStart = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
                int rangeEnd = Math.Min(currentPage * pageSize, totalCount);
            }

            @if (totalPages > 1)
            {
                <div class="pagination-bar">
                    <span class="pagination-info">@rangeStart–@rangeEnd / @totalCount kayıt gösteriliyor</span>
                    <div class="pagination-pages">
                        <a class="page-link @(currentPage <= 1 ? "disabled" : "")" href="/AdminArtist/Index?page=@(currentPage - 1)&pageSize=@pageSize">
                            <i class="bi bi-chevron-left"></i>
                        </a>

                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, currentPage + 2);
                        }

                        @if (startPage > 1)
                        {
                            <a class="page-link" href="/AdminArtist/Index?page=1&pageSize=@pageSize">1</a>
                            if (startPage > 2)
                            {
                                <span class="page-dots">…</span>
                            }
                        }

                        @for (int p = startPage; p <= endPage; p++)
                        {
                            <a class="page-link @(p == currentPage ? "active" : "")" href="/AdminArtist/Index?page=@p&pageSize=@pageSize">@p</a>
                        }

                        @if (endPage < totalPages)
                        {
                            if (endPage < totalPages - 1)
                            {
                                <span class="page-dots">…</span>
                            }
                            <a class="page-link" href="/AdminArtist/Index?page=@totalPages&pageSize=@pageSize">@totalPages</a>
                        }

                        <a class="page-link @(currentPage >= totalPages ? "disabled" : "")" href="/AdminArtist/Index?page=@(currentPage + 1)&pageSize=@pageSize">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </main>

    <!-- Yeni Sanatçı Modal -->
    <div class="modal-overlay" id="createModal">
        <div class="modal-box">
            <h2>Yeni Sanatçı Ekle</h2>
            <form method="post" action="/AdminArtist/Create">
                <div class="field">
                    <label>Sanatçı Adı</label>
                    <input type="text" name="name" required />
                </div>
                <div class="field">
                    <label>Bio</label>
                    <textarea name="bio"></textarea>
                </div>
                <div class="field">
                    <label>Resim URL</label>
                    <input type="text" name="imageUrl" />
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline" onclick="closeModal('createModal')">Vazgeç</button>
                    <button type="submit" class="btn btn-accent">Kaydet</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Güncelle Modal -->
    <div class="modal-overlay" id="updateModal">
        <div class="modal-box">
            <h2>Sanatçıyı Güncelle</h2>
            <form method="post" id="updateForm">
                <div class="field">
                    <label>Sanatçı Adı</label>
                    <input type="text" name="name" id="updateName" required />
                </div>
                <div class="field">
                    <label>Bio</label>
                    <textarea name="bio" id="updateBio"></textarea>
                </div>
                <div class="field">
                    <label>Resim URL</label>
                    <input type="text" name="imageUrl" id="updateImageUrl" />
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline" onclick="closeModal('updateModal')">Vazgeç</button>
                    <button type="submit" class="btn btn-accent">Güncelle</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openCreateModal() {
            document.getElementById('createModal').classList.add('open');
        }

        function openUpdateModal(id, name, bio, imageUrl) {
            document.getElementById('updateForm').action = '/AdminArtist/Update/' + id;
            document.getElementById('updateName').value = name;
            document.getElementById('updateBio').value = bio;
            document.getElementById('updateImageUrl').value = imageUrl;
            document.getElementById('updateModal').classList.add('open');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('open');
        }

        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', e => {
                if (e.target === overlay) overlay.classList.remove('open');
            });
        });
    </script>
</body>
</html>
